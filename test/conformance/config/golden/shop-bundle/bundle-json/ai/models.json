{
  "apiVersion": "ruralz/v1alpha1",
  "kind": "AIModel",
  "metadata": {
    "name": "support-chat"
  },
  "spec": {
    "strategy": "fallback",
    "candidates": [
      {
        "name": "primary",
        "provider": "anthropic-prod",
        "model": "claude-sonnet-4-5"
      },
      {
        "name": "secondary",
        "provider": "openai-prod",
        "model": "gpt-4.1-mini",
        "when": "ai.estimatedInputTokens < 100000"
      }
    ],
    "limits": {
      "maxInputTokens": 32000,
      "maxOutputTokens": 2048
    },
    "cache": {
      "prompt": {
        "mode": "passthrough"
      },
      "semantic": {
        "similarityThreshold": 0.92,
        "ttl": "1h"
      }
    }
  }
}
