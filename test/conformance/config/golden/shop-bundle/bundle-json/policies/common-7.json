{
  "apiVersion": "ruralz/v1alpha1",
  "kind": "Policy",
  "metadata": {
    "name": "ratelimit-orders"
  },
  "spec": {
    "type": "ratelimit",
    "config": {
      "key": "consumer == null ? source.ip : consumer.name",
      "limits": [
        {
          "requests": 50,
          "window": "1s"
        }
      ]
    }
  }
}
