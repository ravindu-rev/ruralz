[
  {
    "apiVersion": "ruralz/v1alpha1",
    "kind": "Gateway",
    "metadata": {
      "name": "edge"
    },
    "spec": {
      "listeners": [
        {
          "name": "http",
          "protocol": "http",
          "port": 8080
        }
      ],
      "policies": [
        {
          "name": "headers-security"
        }
      ]
    }
  },
  {
    "apiVersion": "ruralz/v1alpha1",
    "kind": "Upstream",
    "metadata": {
      "name": "orders"
    },
    "spec": {
      "protocol": "http",
      "endpoints": [
        {
          "address": "orders-a.shop.svc:8080"
        }
      ]
    }
  },
  {
    "apiVersion": "ruralz/v1alpha1",
    "kind": "Policy",
    "metadata": {
      "name": "cors-default"
    },
    "spec": {
      "type": "cors",
      "config": {
        "allowOrigins": [
          "https://shop.example"
        ],
        "allowMethods": [
          "GET"
        ]
      }
    }
  },
  {
    "apiVersion": "ruralz/v1alpha1",
    "kind": "Policy",
    "metadata": {
      "name": "headers-security"
    },
    "spec": {
      "type": "headers",
      "config": {
        "response": {
          "set": [
            {
              "name": "strict-transport-security",
              "value": "max-age=31536000"
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "ruralz/v1alpha1",
    "kind": "Route",
    "metadata": {
      "name": "orders"
    },
    "spec": {
      "match": {
        "path": {
          "prefix": "/orders"
        }
      },
      "upstreams": [
        {
          "name": "orders"
        }
      ]
    }
  }
]
