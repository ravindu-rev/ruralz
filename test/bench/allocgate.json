{
  "runs": 10,
  "threshold": 0.03,
  "gomaxprocs": 4,
  "benchmarks": [
    {"package": "./internal/gateway/handler", "pattern": "^BenchmarkS1Request$", "maxAllocs": 30, "budget": "PB-8", "owner": "data-plane", "note": "one whole S1 request on a canned transport and a discard ResponseWriter, net/http excluded; covers onResponse and the response write"},
    {"package": "./internal/gateway/upstream", "pattern": "^BenchmarkLegCanned$", "maxAllocs": 6, "budget": "Upstream layer", "owner": "data-plane", "note": "pass-through leg on a canned transport: pooled attempt context, copy-free forwarding writer"},
    {"package": "./internal/gateway/router", "pattern": "^BenchmarkMatch$", "maxAllocs": 0, "budget": "Snapshot pin and Route match", "owner": "data-plane"},
    {"package": "./internal/gateway/retire", "pattern": "^BenchmarkPinUnpin$", "maxAllocs": 0, "budget": "Snapshot pin and Route match", "owner": "data-plane"},
    {"package": "./internal/routematch", "pattern": "^Benchmark(TrieLookup|HostTableLookup|TemplateMatch|PrefixMatch|NormalizeHost|NormalizePath)$", "owner": "data-plane"},
    {"package": "./internal/gateway/executor", "pattern": "^Benchmark(EmptyChain|ThreePolicyChain)$", "maxAllocs": 0, "budget": "onRequestHeaders, onRoute and onUpstreamRequest without attached work", "owner": "data-plane"},
    {"package": "./internal/gateway/exchange", "pattern": "^Benchmark(Request|RequestNoLegState)$", "maxAllocs": 0, "budget": "exchange share of PB-8", "owner": "data-plane"},
    {"package": "./internal/gateway/body", "pattern": "^Benchmark(ReadGate1KiB|RequestGated1KiB|RequestGatedOpen|RequestStream|Limited|BudgetAccount|Tee64KiB)$", "owner": "data-plane"},
    {"package": "./internal/gateway/admission", "pattern": "^Benchmark(UnitsAcquireRelease|UnitsReject|PreRoutingDo)$", "owner": "data-plane"},
    {"package": "./internal/gateway/upstream/balance", "pattern": "^BenchmarkPick(RoundRobin|Random|LeastRequest|RingHash)$", "owner": "traffic-management-and-resilience"},
    {"package": "./internal/gateway/upstream/resilience", "pattern": "^Benchmark(Bulkhead|BreakerAccounting|RetryBudget|LegDecide)$", "owner": "traffic-management-and-resilience"},
    {"package": "./internal/gateway/upstream/health", "pattern": "^Benchmark(AttemptAccounting|ViewGrades)$", "owner": "traffic-management-and-resilience"},
    {"package": "./internal/gateway/upstream/forward", "pattern": "^BenchmarkForward(OneEntry|Split)$", "owner": "data-plane"},
    {"package": "./internal/clientaddr", "pattern": "^Benchmark(ClientAddr|Rewrite|Contains)$", "owner": "security-and-identity"},
    {"package": "./internal/httpfield", "pattern": "^Benchmark(StripHopByHop|NormalizeValue|Protect|QuerySet)$", "owner": "multi-protocol"},
    {"package": "./internal/problem", "pattern": "^BenchmarkWrite$", "owner": "data-plane"},
    {"package": "./internal/sfv", "pattern": "^BenchmarkAppendRateLimitFields$", "owner": "traffic-management-and-resilience"},
    {"package": "./internal/jsonval", "pattern": "^Benchmark(Decode1KiB|Scan1KiB|Append1KiB|Validate1KiB)$", "owner": "data-plane", "note": "body layer JSON"},
    {"package": "./internal/cel", "pattern": "^Benchmark(MatchWhen|RateLimitKey|AuthzMethod|AuthzGold|AuthzOrders|AuthzOrdersDeadline|AuthzOrdersJWTClaims|AuthzQuota|AuthzRouteLabel|AccessLogWhen|DefaultRetryOn|DecodeJSON1KiB)$", "owner": "configuration-model"},
    {"package": "./internal/cel", "pattern": "^BenchmarkWorstCase(Nested|Untracked|Split)$", "benchtime": "20x", "owner": "configuration-model", "note": "worst-case expressions at the cost limit; a rule that tracks split keeps only the 3% rule; 20 iterations because one op allocates up to 4.5 MB and the gate runs with GOGC=off"},
    {"package": "./internal/cel/celtypes", "pattern": "^Benchmark(EvalMethod|EvalGold|EvalQuery|EvalRateLimitKey|EvalHeaderLookup|EvalHeaderPresence|EvalBodySelect|EvalDefaultRetryOn|JoinedHeader|ResolveRequest)$", "owner": "configuration-model"},
    {"package": "./internal/config/canonical", "pattern": "^Benchmark(Encode|Sum|Verify|AppendDump|ReadDump)$", "benchtime": "50x", "owner": "configuration-model", "note": "canonicalization; 50 iterations because the 10,000-Route rung allocates 44 MB per op and the gate runs with GOGC=off"},
    {"package": "./internal/config/validate", "pattern": "^BenchmarkRun$", "benchtime": "50x", "owner": "configuration-model", "note": "validation; 50 iterations because the 1,000-finding case allocates 11 MB per op and the gate runs with GOGC=off"},
    {"package": "./internal/config/schemaview", "pattern": "^BenchmarkValidate$", "owner": "configuration-model", "note": "validation"},
    {"package": "./internal/filter/validation/jsonschema", "pattern": "^Benchmark(Validate1KiB|ValidateNested)$", "owner": "data-plane", "note": "validation.json-schema in onRequestBody"},
    {"package": "./internal/filter/validation/jsonschema", "pattern": "^BenchmarkValidateDense$", "benchtime": "20x", "owner": "data-plane", "note": "validation.json-schema on a dense document; 20 iterations because one op allocates up to 32 MB and the gate runs with GOGC=off"},
    {"package": "./internal/filter/ratelimit", "pattern": "^BenchmarkAdmitKeyless$", "maxAllocs": 0, "budget": "onRequestHeaders: ratelimit", "owner": "traffic-management-and-resilience", "note": "local token bucket shard, then GCRA on the memory driver"},
    {"package": "./internal/filter/ratelimit", "pattern": "^Benchmark(Admit|LocalOnly)$", "owner": "traffic-management-and-resilience", "note": "keyed limits: the key's CEL evaluation boxes the header value it reads (cel-go), so they keep the 3% rule"},
    {"package": "./internal/statestore/memory", "pattern": "^Benchmark(MemoryGCRA|MemoryLookup|MemoryQuota)$", "owner": "scalability-and-distributed-state"},
    {"package": "./internal/statestore/keys", "pattern": "^BenchmarkAppend(RateLimit|Quota)$", "owner": "scalability-and-distributed-state"},
    {"package": "./internal/filter/quota", "pattern": "^BenchmarkAdmit$", "owner": "traffic-management-and-resilience"},
    {"package": "./internal/filter/cors", "pattern": "^BenchmarkActualRequest$", "maxAllocs": 0, "budget": "onRequestHeaders: other Filters", "owner": "security-and-identity"},
    {"package": "./internal/filter/authz/ip", "pattern": "^BenchmarkAdmit$", "maxAllocs": 0, "budget": "onRequestHeaders: other Filters", "owner": "security-and-identity"},
    {"package": "./internal/filter/authz/cel", "pattern": "^Benchmark(GoldTier|Quota)$", "maxAllocs": 0, "budget": "onRequestHeaders: other Filters", "owner": "security-and-identity"},
    {"package": "./internal/filter/authz/cel", "pattern": "^BenchmarkOrdersScope$", "owner": "security-and-identity", "note": "the rule tracks split, so it keeps only the 3% rule"},
    {"package": "./internal/filter/auth/apikey", "pattern": "^BenchmarkHandle$", "owner": "security-and-identity"},
    {"package": "./internal/filter/auth/basic", "pattern": "^BenchmarkCacheHit$", "owner": "security-and-identity"},
    {"package": "./internal/filter/header", "pattern": "^BenchmarkSetTwoLiterals$", "maxAllocs": 2, "budget": "onUpstreamRequest: headers setting two values", "owner": "data-plane"},
    {"package": "./internal/filter/header", "pattern": "^BenchmarkSetTwoComputed$", "owner": "data-plane"},
    {"package": "./internal/filter/transform", "pattern": "^BenchmarkLiteralOperations$", "maxAllocs": 1, "budget": "Transform Policy: literal operations", "owner": "data-plane"},
    {"package": "./internal/filter/transform", "pattern": "^BenchmarkOrdersShape$", "owner": "data-plane", "note": "CEL entries reported, not capped"},
    {"package": "./internal/telemetry/aggregate", "pattern": "^Benchmark(MetricsPerRequest|MetricsPerRequest10Filters)$", "maxAllocs": 0, "budget": "Metrics per request", "owner": "observability"},
    {"package": "./internal/telemetry/aggregate", "pattern": "^BenchmarkHotRouteContention$", "owner": "observability"},
    {"package": "./internal/telemetry/tracing", "pattern": "^BenchmarkUnsampledTrace$", "maxAllocs": 2, "budget": "Tracing, unsampled", "owner": "observability"},
    {"package": "./internal/telemetry/tracing", "pattern": "^BenchmarkSampledTrace15Spans$", "maxAllocs": 90, "budget": "Tracing, sampled trace of 15 spans", "owner": "observability"},
    {"package": "./internal/telemetry/tracing", "pattern": "^Benchmark(Decide|ParseTraceparent)$", "owner": "observability"},
    {"package": "./internal/telemetry/accesslog", "pattern": "^BenchmarkAccessLogSubmit$", "maxAllocs": 8, "budget": "Access log, logged request", "owner": "observability"},
    {"package": "./internal/telemetry/accesslog", "pattern": "^Benchmark(AccessLogEncode|AccessLogDrop)$", "owner": "observability"},
    {"package": "./internal/telemetry/logsink", "pattern": "^BenchmarkProcessLogDisabled$", "maxAllocs": 0, "budget": "Process logs at info", "owner": "observability"},
    {"package": "./internal/telemetry/emit", "pattern": "^BenchmarkGatewayTimer$", "owner": "observability"},
    {"package": "./internal/gateway/tap", "pattern": "^BenchmarkActiveNoSubscriber$", "maxAllocs": 0, "budget": "/tap, no subscriber", "owner": "observability"},
    {"package": "./internal/gateway/tap", "pattern": "^BenchmarkPublishOneSubscriber$", "maxAllocs": 1, "budget": "/tap, one subscriber", "owner": "observability"}
  ]
}
