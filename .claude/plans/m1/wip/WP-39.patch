+
+// tracking is a context that records the distinct goroutines other than
+// the caller's that ask it during a decode: exactly the goroutines the
+// decode started that checked a resource, since every check asks the
+// context first and goroutine ids are never reused. With hold set it also
+// keeps each of them waiting in Err until the parser asks it for element
+// release (by default the last element, so no chunk handed over is
+// checked before the parse ends), and then keeps the parser waiting until
+// every element of the chunks it completed before has begun its check;
+// the parser yields
+// the processor each time it asks, so a goroutine just started runs and
+// takes its chunk before the parser goes on, whatever GOMAXPROCS is.
+type tracking struct {
+	context.Context
+	caller  string
+	hold    bool
+	release int
+	mu      sync.Mutex
+	ids     map[string]bool
+	asked   int
+	checked atomic.Int64
+	open    chan struct{}
+}
+
+func newTracking(hold bool, elements int) *tracking {
+	return &tracking{Context: context.Background(), caller: goroutineID(), hold: hold, release: elements - 1, ids: map[string]bool{}, open: make(chan struct{})}
+}
+
+func (c *tracking) Err() error {
+	id := goroutineID()
+	if id == c.caller {
+		pc := make([]uintptr, 1)
+		if runtime.Callers(2, pc) == 1 {
+			if frame, _ := runtime.CallersFrames(pc).Next(); strings.Contains(frame.Function, "(*Decoder).stream") {
+				c.parsed()
+				return nil
+			}
+		}
+		c.checked.Add(1)
+		return nil
+	}
+	c.mu.Lock()
+	c.ids[id] = true
+	c.mu.Unlock()
+	c.checked.Add(1)
+	if c.hold {
+		<-c.open
+	}
+	return nil
+}
+
+// parsed is the parser asking the context for its next element.
+func (c *tracking) parsed() {
+	if !c.hold {
+		return
+	}
+	c.mu.Lock()
+	k := c.asked
+	c.asked++
+	c.mu.Unlock()
+	if k == c.release {
+		close(c.open)
+		// The chunks the parser completed start at multiples of
+		// streamChunk; the elements of the one it is filling wait for it.
+		for flushed := k / streamChunk * streamChunk; c.checked.Load() < int64(flushed); {
+			runtime.Gosched()
+		}
+	}
+	runtime.Gosched()
+}
+
+// workers returns the number of distinct goroutines beside the caller's
+// that asked c.
+func (c *tracking) workers() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.ids)
+}
+
+// boundsRun is the stream of one decode of content with ctx, and its run.
+func boundsRun(ctx context.Context, t *testing.T, workers int, content []byte) *run {
+	t.Helper()
+	d := NewDecoder(hubIndex(t), DecoderOptions{Workers: workers})
+	r := newRun(d.maxDiags)
+	if _, _, _, err := d.stream(ctx, newInput(content, 0, len(content), Source{}), r, nil); err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+// checkBounds fails unless the decode whose run is r and whose context is
+// c kept the bounds of the package documentation (Concurrency): at most
+// Workers-1 goroutines beside the caller's, never more than the chunks it
+// handed over, every goroutine that checked a resource among them, and at
+// most 2(Workers-1)+1 chunks in flight (Workers-1 waiting in the channel,
+// one in each goroutine and the one the parser holds).
+func checkBounds(t *testing.T, what string, workers int, r *run, c *tracking) {
+	t.Helper()
+	w := min(workerCount(workers), maxWorkers)
+	if r.started > w-1 || r.started > r.handed {
+		t.Errorf("%s: %d goroutines started for %d chunks handed over, want at most min(%d, %d)", what, r.started, r.handed, w-1, r.handed)
+	}
+	if got := c.workers(); got > r.started {
+		t.Errorf("%s: %d goroutines beside the caller's checked resources, %d started", what, got, r.started)
+	}
+	if peak := r.peak.Load(); peak > int64(2*(w-1)+1) {
+		t.Errorf("%s: %d chunks in flight at once, want at most %d", what, peak, 2*(w-1)+1)
+	}
+	if n := r.inFlight.Load(); n != 0 {
+		t.Errorf("%s: %d chunks still in flight after the decode", what, n)
+	}
+}
+
+// TestDecodeWorkersClamped: a decode with a huge worker count gives the
+// trees of one worker, panics nowhere, and runs at most one goroutine per
+// chunk it hands over (WP-39 review: Workers 5,000 started 4,999
+// goroutines for two chunks, 1<<50 panicked in makechan and 1<<40 ran out
+// of memory). The goroutines are counted exactly, never sampled with
+// runtime.NumGoroutine (WP-39 review round 5: that count is the
+// runtime's, includes goroutines of other calls still exiting, and made
+// this test fail 4 runs in 100): the decoder's own count of the
+// goroutines it started, and the distinct goroutines that asked the
+// context, which every check does first.
+func TestDecodeWorkersClamped(t *testing.T) {
+	ctx := context.Background()
+	const n = 300 // nine full chunks and a last one the parser checks
+	content := routes(n)
+	want := mustDecode(t, content)
+	rev := revision.Revision{Content: content, Digest: revision.Sum(content)}
+	body := dumpOf(t, nil, rev, revision.Digest{})
+	_, wantDump, err := NewDecoder(hubIndex(t), DecoderOptions{}).ReadDump(ctx, bytes.NewReader(body), 0, Source{Name: "c.json"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, w := range []int{5000, 1 << 40, 1 << 50, math.MaxInt} {
+		dec := NewDecoder(hubIndex(t), DecoderOptions{Workers: w})
+		if dec.workers != maxWorkers {
+			t.Errorf("workers %d: decoder runs %d", w, dec.workers)
+		}
+		c := newTracking(false, n)
+		got, err := dec.Decode(c, content, Source{Name: "c.json"})
+		if err != nil {
+			t.Fatalf("workers %d: %v", w, err)
+		}
+		if d := diffResources(want, got); d != "" {
+			t.Errorf("workers %d: %s", w, d)
+		}
+		if extra := c.workers(); extra > n/streamChunk {
+			t.Errorf("workers %d: %d goroutines beside the caller's checked resources, want at most %d (one per chunk handed over)", w, extra, n/streamChunk)
+		}
+		c = newTracking(false, n)
+		r := boundsRun(c, t, w, content)
+		checkBounds(t, "workers "+strconv.Itoa(w), w, r, c)
+		if r.handed > n/streamChunk {
+			t.Errorf("workers %d: %d chunks handed over, the content fills %d", w, r.handed, n/streamChunk)
+		}
+		_, gotDump, err := dec.ReadDump(ctx, bytes.NewReader(body), 0, Source{Name: "c.json"})
+		if err != nil {
+			t.Fatalf("workers %d, dump: %v", w, err)
+		}
+		if d := diffResources(wantDump, gotDump); d != "" {
+			t.Errorf("workers %d, dump: %s", w, d)
+		}
+	}
+}
+
+// TestDecodeGoroutineAndQueueBounds: a decode runs on at most Workers
+// goroutines and keeps at most 2(Workers-1)+1 chunks in flight, through a
+// channel of Workers-1 chunks (package documentation, Concurrency; 02 req
+// 78; WP-39 review round 5: a mutant starting a goroutine per chunk
+// handed over and one with a channel of 4,096 chunks both passed the
+// suite). Over 3,000 Routes (93 full chunks), with 2, 3 and 8 workers:
+// first while the goroutines the decode starts are held until the parse
+// ends, so every chunk handed over is in flight at once and the bounds
+// are reached exactly: Workers-1 goroutines, each holding one chunk, and
+// Workers-1 chunks in the channel, the parser checking the others itself;
+// then free running, where the bounds hold whatever the scheduling.
+func TestDecodeGoroutineAndQueueBounds(t *testing.T) {
+	const n = 3000
+	content := routes(n)
+	for _, w := range []int{2, 3, 8} {
+		held := newTracking(true, n)
+		r := boundsRun(held, t, w, content)
+		what := "workers " + strconv.Itoa(w) + ", held"
+		checkBounds(t, what, w, r, held)
+		if r.started < 1 || r.handed > 2*(w-1) {
+			t.Errorf("%s: %d goroutines started, %d chunks handed over; want at least 1 and at most %d chunks", what, r.started, r.handed, 2*(w-1))
+		}
+		for range 5 {
+			free := newTracking(false, n)
+			checkBounds(t, "workers "+strconv.Itoa(w)+", free", w, boundsRun(free, t, w, content), free)
+		}
+	}
+	// One worker checks every chunk on the calling goroutine.
+	c := newTracking(false, n)
+	r := boundsRun(c, t, 1, content)
+	if r.started != 0 || r.handed != 0 || r.peak.Load() != 1 || c.workers() != 0 {
+		t.Errorf("one worker: %d goroutines, %d chunks handed over, %d in flight, %d goroutines asked", r.started, r.handed, r.peak.Load(), c.workers())
+	}
+}
diff --git a/internal/config/canonical/yield.go b/internal/config/canonical/yield.go
new file mode 100644
index 0000000..64fbb8d
--- /dev/null
+++ b/internal/config/canonical/yield.go
@@ -0,0 +1,188 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/ravindu-rev/ruralz/internal/config/revision"
+)
+
+// DefaultYieldAfter is the work a goroutine of a call does before it
+// yields the processor when Options.YieldAfter or DecoderOptions.YieldAfter
+// is zero or negative (01 req 53: 100 µs).
+const DefaultYieldAfter = 100 * time.Microsecond
+
+// yieldCheck is the number of work units between two reads of the yield
+// timer inside a work unit (01 req 53: checked every 256 nodes).
+const yieldCheck = 256
+
+// piece is the most bytes the package hashes or copies in one step, so a
+// goroutine reads its yield timer at least once per piece of a large
+// Revision.
+const piece = 64 << 10
+
+// yieldAfter returns the yield interval of the option v.
+func yieldAfter(v time.Duration) time.Duration {
+	if v <= 0 {
+		return DefaultYieldAfter
+	}
+	return v
+}
+
+// site names one place of the package that reads the yield timer: a loop
+// whose length depends on the content, or a step between two units of
+// work. The tests count each site's units, so each has its own test that
+// fails when the site stops counting.
+type site uint8
+
+// Sites, one per loop or boundary.
+const (
+	siteItem       site = iota // Encode, EncodeResources: a resource collected
+	siteKind                   // order: a resource's kind checked
+	siteSorted                 // order: a comparison of the sortedness check
+	siteSort                   // order: a comparison of the sort
+	siteDuplicate              // order: a resource compared with the one before
+	siteResource               // encode: between two resources written
+	siteValue                  // writer.value: a value written
+	siteJoin                   // encode: between two chunks joined
+	siteHash                   // sum: after a piece hashed
+	siteCopy                   // parse: after a piece of the content copied
+	siteNode                   // parser: a value built
+	siteToken                  // skip: a token of a value scanned, not built
+	siteElement                // stream: between two elements of resources
+	siteCheck                  // checker.run: between two resources checked
+	siteMember                 // checker.resource: a member judged
+	siteWalkMember             // newerWalk: a member judged
+	siteWalkItem               // newerWalk: a list item visited
+	siteOffer                  // keeper: a finding offered
+	siteKeepSort               // keeper: a comparison sorting the findings
+	siteList                   // keeper: a finding listed
+	siteDocument               // envelope: a document member read
+	siteChunk                  // decode: a chunk's entries counted or gathered
+	siteSequence               // sequence: an entry checked
+	siteEnvelope               // envelopes: an envelope built
+	siteDump                   // scanDump: a member of the dump document
+	siteCount
+)
+
+// yielder is the yield timer of one goroutine of a call (01 req 53): the
+// goroutine reads the clock between two units of work (check) and once
+// every yieldCheck units of work inside one (charge), and calls
+// runtime.Gosched once after has passed since its last yield, so a large
+// Revision shares the processor with live traffic. A yielder belongs to
+// one goroutine; the calling goroutine of a call has one, and so has each
+// goroutine the call starts. Its first read starts the interval, so the
+// clock is read only at the sites, inside the work whose panics the call
+// recovers on the goroutines it starts. A nil yielder, or one without a
+// clock, counts nothing and reads no clock.
+type yielder struct {
+	// now is the clock (Options.Now, DecoderOptions.Now); nil never
+	// yields.
+	now func() time.Time
+	// after is the work between two yields.
+	after time.Duration
+	// started reports that last was read.
+	started bool
+	// last is when the goroutine last yielded, or first read the clock.
+	last time.Time
+	// units counts the work units since the timer was last read.
+	units int
+	// yields, checks and sites count the yields, the reads between units
+	// and the units of each site, for tests.
+	yields, checks int
+	sites          [siteCount]int
+}
+
+// newYielder returns the yield timer of a goroutine; it reads no clock.
+func newYielder(now func() time.Time, after time.Duration) *yielder {
+	return &yielder{now: now, after: after}
+}
+
+// on reports whether y reads a clock.
+func (y *yielder) on() bool { return y != nil && y.now != nil }
+
+// charge counts k work units at site s and, each time they reach
+// yieldCheck, reads the timer.
+func (y *yielder) charge(s site, k int) {
+	if !y.on() {
+		return
+	}
+	y.sites[s] += k
+	if y.units += k; y.units >= yieldCheck {
+		y.units = 0
+		y.tick()
+	}
+}
+
+// check reads the timer between two units of work at site s.
+func (y *yielder) check(s site) {
+	if !y.on() {
+		return
+	}
+	y.sites[s]++
+	y.checks++
+	y.units = 0
+	y.tick()
+}
+
+// tick yields once y.after has passed since the last yield; the first
+// tick starts the interval.
+func (y *yielder) tick() {
+	if !y.started {
+		y.started, y.last = true, y.now()
+		return
+	}
+	if y.now().Sub(y.last) >= y.after {
+		runtime.Gosched()
+		y.yields++
+		y.last = y.now()
+	}
+}
+
+// sum returns the digest of content, revision.Sum's, hashing a piece at a
+// time with a read of y's timer after each, so a large Revision is hashed
+// in steps of bounded work. Without a clock it is revision.Sum.
+func sum(content []byte, y *yielder) revision.Digest {
+	if !y.on() {
+		return revision.Sum(content)
+	}
+	h := sha256.New()
+	for rest := content; ; {
+		k := min(len(rest), piece)
+		_, _ = h.Write(rest[:k])
+		rest = rest[k:]
+		y.check(siteHash)
+		if len(rest) == 0 {
+			break
+		}
+	}
+	// The text of a SHA-256 sum always parses.
+	d, _ := revision.Parse("sha256:" + hex.EncodeToString(h.Sum(nil)))
+	return d
+}
+
+// copyString returns a string copy of content, made a piece at a time
+// with a read of y's timer after each. Without a clock it is one copy.
+func copyString(content []byte, y *yielder) string {
+	if !y.on() {
+		return string(content)
+	}
+	var b strings.Builder
+	b.Grow(len(content))
+	for rest := content; ; {
+		k := min(len(rest), piece)
+		_, _ = b.Write(rest[:k])
+		rest = rest[k:]
+		y.check(siteCopy)
+		if len(rest) == 0 {
+			break
+		}
+	}
+	return b.String()
+}
diff --git a/internal/config/canonical/yield_test.go b/internal/config/canonical/yield_test.go
new file mode 100644
index 0000000..2191402
--- /dev/null
+++ b/internal/config/canonical/yield_test.go
@@ -0,0 +1,599 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"runtime"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/ravindu-rev/ruralz/internal/config/hub"
+	"github.com/ravindu-rev/ruralz/internal/config/revision"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+	"github.com/ravindu-rev/ruralz/internal/jsonval"
+)
+
+// stepClock is a fake clock that advances by step on every read; it is
+// safe for concurrent use and reads no wall clock.
+type stepClock struct {
+	step  time.Duration
+	reads atomic.Int64
+}
+
+func (c *stepClock) now() time.Time {
+	return time.Unix(0, 0).Add(time.Duration(c.reads.Add(1)) * c.step)
+}
+
+// observed collects the yield timers of the goroutines of the calls of one
+// Encoder or Decoder, each handed over once its goroutine is done with it.
+type observed struct {
+	mu sync.Mutex
+	ys []*yielder
+}
+
+func (o *observed) add(y *yielder) {
+	o.mu.Lock()
+	o.ys = append(o.ys, y)
+	o.mu.Unlock()
+}
+
+// take returns the timers collected and forgets them.
+func (o *observed) take() []*yielder {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	ys := o.ys
+	o.ys = nil
+	return ys
+}
+
+// total sums the units of every site, the reads between units and the
+// yields of ys.
+func total(ys []*yielder) (sites [siteCount]int, checks, yields int) {
+	for _, y := range ys {
+		for s := range sites {
+			sites[s] += y.sites[s]
+		}
+		checks += y.checks
+		yields += y.yields
+	}
+	return sites, checks, yields
+}
+
+// inner returns the reads of the timers ys made inside units of work, on
+// a clock where every read but a timer's first yields: their yields,
+// plus the first read of each timer that started, minus the reads
+// between units.
+func inner(ys []*yielder) int {
+	_, checks, yields := total(ys)
+	for _, y := range ys {
+		if y.started {
+			yields++
+		}
+	}
+	return yields - checks
+}
+
+// checkYields fails unless every timer of ys yielded at every boundary
+// but its first read, which starts its interval, and the timers yielded
+// at least once per 256 of the values of the largest unit of work.
+func checkYields(t *testing.T, what string, ys []*yielder, unitValues int) {
+	t.Helper()
+	for i, y := range ys {
+		if y.yields < y.checks-1 {
+			t.Errorf("%s: timer %d yielded %d times at %d boundaries", what, i, y.yields, y.checks)
+		}
+	}
+	if got := inner(ys); got < unitValues/yieldCheck {
+		t.Errorf("%s: %d reads inside units, want at least %d for the unit of %d values", what, got, unitValues/yieldCheck, unitValues)
+	}
+}
+
+// siteNames names the sites for messages.
+func siteNames() [siteCount]string {
+	return [siteCount]string{
+		"item", "kind", "sorted", "sort", "duplicate", "resource", "value", "join", "hash", "copy", "node", "token",
+		"element", "check", "member", "walk member", "walk item", "offer", "keep sort", "list", "document", "chunk",
+		"sequence", "envelope", "dump",
+	}
+}
+
+// due is the yield option under which every read of a stepClock finds
+// YieldAfter passed, so every read of the timer yields.
+func due() (func() time.Time, time.Duration) {
+	c := &stepClock{step: time.Microsecond}
+	return c.now, time.Microsecond
+}
+
+// TestYielderTimer covers the yield timer of 01 req 53 on one goroutine:
+// no clock read to build it, the first read starting the interval, no
+// read below 256 units, one read when they reach it, also in one charge,
+// a yield once YieldAfter has passed since the last one and none before,
+// a second read after the yield to restart the interval, a read at every
+// boundary between units, which also restarts the count, and nothing at
+// all without a clock or for a nil timer; zero and negative YieldAfter
+// mean DefaultYieldAfter.
+func TestYielderTimer(t *testing.T) {
+	var at time.Duration
+	reads := 0
+	now := func() time.Time {
+		reads++
+		return time.Unix(0, 0).Add(at)
+	}
+	y := newYielder(now, 100*time.Microsecond)
+	if reads != 0 {
+		t.Fatalf("%d reads to build the timer, want none", reads)
+	}
+	at = time.Hour
+	y.check(siteElement)
+	if reads != 1 || y.yields != 0 || y.last != time.Unix(0, 0).Add(at) {
+		t.Fatalf("first read: %d reads, %d yields, last %v; want the interval started", reads, y.yields, y.last)
+	}
+	at = 0
+	y.last = time.Unix(0, 0)
+	y.charge(siteNode, yieldCheck-1)
+	if reads != 1 {
+		t.Errorf("%d clock reads below %d units", reads-1, yieldCheck)
+	}
+	at = 99 * time.Microsecond
+	y.charge(siteNode, 1)
+	if reads != 2 || y.yields != 0 {
+		t.Errorf("at 99 µs: %d reads, %d yields; want 2 reads, no yield", reads, y.yields)
+	}
+	at = 100 * time.Microsecond
+	y.charge(siteValue, 3*yieldCheck)
+	if reads != 4 || y.yields != 1 || y.last != time.Unix(0, 0).Add(at) {
+		t.Errorf("at 100 µs: %d reads, %d yields, last %v; want 4 reads (check and restart), 1 yield", reads, y.yields, y.last)
+	}
+	y.charge(siteNode, yieldCheck-1)
+	y.check(siteElement)
+	if reads != 5 || y.yields != 1 || y.checks != 2 || y.units != 0 {
+		t.Errorf("a boundary right after a yield: %d reads, %d yields, %d checks, %d units", reads, y.yields, y.checks, y.units)
+	}
+	y.charge(siteNode, yieldCheck-1)
+	if reads != 5 {
+		t.Errorf("the boundary did not restart the count: %d reads", reads)
+	}
+	if y.sites[siteNode] != 3*yieldCheck-2 || y.sites[siteValue] != 3*yieldCheck || y.sites[siteElement] != 2 {
+		t.Errorf("sites %v", y.sites)
+	}
+	for _, idle := range []*yielder{newYielder(nil, time.Microsecond), nil} {
+		idle.charge(siteNode, 10*yieldCheck)
+		idle.check(siteElement)
+		if idle != nil && (idle.yields != 0 || idle.checks != 0 || idle.sites != [siteCount]int{}) {
+			t.Errorf("timer without a clock: %+v", idle)
+		}
+	}
+	for _, tc := range []struct{ in, want time.Duration }{{0, DefaultYieldAfter}, {-time.Second, DefaultYieldAfter}, {time.Nanosecond, time.Nanosecond}, {time.Second, time.Second}} {
+		if got := yieldAfter(tc.in); got != tc.want {
+			t.Errorf("yieldAfter(%v) = %v, want %v", tc.in, got, tc.want)
+		}
+		if got := NewDecoder(nil, DecoderOptions{YieldAfter: tc.in}).yieldAfter; got != tc.want {
+			t.Errorf("DecoderOptions{YieldAfter: %v}: %v, want %v", tc.in, got, tc.want)
+		}
+		if got := NewEncoder(nil).newYielder(Options{Now: now, YieldAfter: tc.in}).after; got != tc.want {
+			t.Errorf("Options{YieldAfter: %v}: %v, want %v", tc.in, got, tc.want)
+		}
+	}
+}
+
+// TestYieldAfterHonored: on a clock that advances 1 µs per read, a timer
+// with YieldAfter 50 µs read at every boundary yields once per 51 reads
+// (50 boundaries without a yield, then the yielding read and the restart
+// read).
+func TestYieldAfterHonored(t *testing.T) {
+	c := &stepClock{step: time.Microsecond}
+	y := newYielder(c.now, 50*time.Microsecond)
+	for range 5100 {
+		y.check(siteElement)
+	}
+	if y.yields < 95 || y.yields > 105 {
+		t.Errorf("%d yields over 5,100 boundaries, want about 100", y.yields)
+	}
+}
+
+// valueCount returns the values of a tree: one per node.
+func valueCount(n *tree.Node) int {
+	if n == nil {
+		return 0
+	}
+	c := 1
+	for _, m := range n.Members {
+		c += valueCount(m.Value)
+	}
+	for _, it := range n.Items {
+		c += valueCount(it)
+	}
+	return c
+}
+
+// tokenCounts returns the values and the tokens of one JSON text.
+func tokenCounts(t *testing.T, data []byte) (values, tokens int) {
+	t.Helper()
+	s := jsonval.NewScanner(data, jsonval.ScanOptions{MaxDepth: jsonval.MaxDepthLimit})
+	for {
+		tok, err := s.Next()
+		if errors.Is(err, io.EOF) {
+			return values, tokens
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		tokens++
+		switch tok.Kind {
+		case jsonval.KindName, jsonval.KindObjectEnd, jsonval.KindArrayEnd:
+		default:
+			values++
+		}
+	}
+}
+
+// pieces returns the pieces a copy or hash of n bytes takes.
+func pieces(n int) int { return max(1, (n+piece-1)/piece) }
+
+// yieldBundle is a Bundle of 121 small resources and one Plugin of more
+// than 2,000 values, so a unit of work holds more than 256 values.
+func yieldBundle(t *testing.T) (*hub.Bundle, int) {
+	t.Helper()
+	big := resourceOf(t, jsonTree(t, largeResource(300)))
+	meta, _ := big.Tree.Get("metadata")
+	spec, _ := big.Tree.Get("spec")
+	return hub.NewBundle(append(slices.Clone(largeBundle(t, 40).Resources()), big)), valueCount(meta) + valueCount(spec)
+}
+
+// TestYieldEncode: every goroutine of an Encode or EncodeResources reads
+// its yield timer at every site, with one worker and with several, and
+// yields when YieldAfter has passed: between resources, chunks and pieces
+// of the hash, and every 256 values inside one resource (01 req 53, WP-39
+// review round 5: stage L never yielded). On a clock where YieldAfter
+// passes at every read, each site counts its exact units, every timer
+// yields at each boundary, and the resource of more than 2,000 values
+// yields inside itself; each pooled goroutine has a timer of its own.
+func TestYieldEncode(t *testing.T) {
+	b, bigValues := yieldBundle(t)
+	n := len(b.Resources())
+	values := 0
+	for _, r := range b.Resources() {
+		meta, _ := r.Tree.Get("metadata")
+		spec, _ := r.Tree.Get("spec")
+		values += valueCount(meta) + valueCount(spec)
+	}
+	enc := NewEncoder(hubIndex(t))
+	var o observed
+	enc.observe = o.add
+	envelopes := make([]tree.Resource, n)
+	for i, r := range b.Resources() {
+		envelopes[n-1-i] = tree.Resource{ID: r.ID, Root: r.Tree}
+	}
+	names := siteNames()
+	for _, w := range []int{1, 4} {
+		for _, mode := range []string{"Encode", "EncodeResources"} {
+			now, after := due()
+			opt := Options{Workers: w, Now: now, YieldAfter: after}
+			var rev revision.Revision
+			var err error
+			if mode == "Encode" {
+				rev, err = enc.Encode(context.Background(), b, opt)
+			} else {
+				rev, err = enc.EncodeResources(context.Background(), slices.Clone(envelopes), opt)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			ys := o.take()
+			sites, _, _ := total(ys)
+			what := mode + ", workers " + strconv.Itoa(w)
+			chunks := chunkCount(n, w)
+			want := map[site]int{
+				siteItem: n, siteKind: n, siteDuplicate: n - 1, siteResource: n, siteValue: values,
+				siteHash: pieces(len(rev.Content)),
+			}
+			if mode == "Encode" {
+				// The Bundle is in canonical order: one comparison per pair.
+				want[siteSorted] = n - 1
+			}
+			if chunks > 1 {
+				want[siteJoin] = chunks
+			}
+			for s, name := range names {
+				switch got, exact := sites[s], want[site(s)]; {
+				case site(s) == siteSorted && mode == "EncodeResources":
+					// Reversed input: the sortedness check stops at once.
+					if got < 1 {
+						t.Errorf("%s: site %s counted %d", what, name, got)
+					}
+				case site(s) == siteSort && mode == "EncodeResources":
+					if got < n {
+						t.Errorf("%s: site %s counted %d comparisons for %d resources", what, name, got, n)
+					}
+				case got != exact:
+					t.Errorf("%s: site %s counted %d, want %d", what, name, got, exact)
+				}
+			}
+			if wantYs := 1 + map[bool]int{true: min(w, chunks), false: 0}[w > 1 && chunks > 1]; len(ys) != wantYs {
+				t.Errorf("%s: %d goroutines with a timer, want %d", what, len(ys), wantYs)
+			}
+			checkYields(t, what, ys, bigValues)
+		}
+	}
+	// Without a clock nothing is counted and nothing yields.
+	if _, err := enc.Encode(context.Background(), b, Options{Workers: 4}); err != nil {
+		t.Fatal(err)
+	}
+	if sites, checks, yields := total(o.take()); sites != [siteCount]int{} || checks != 0 || yields != 0 {
+		t.Errorf("no clock: sites %v, %d checks, %d yields", sites, checks, yields)
+	}
+}
+
+// decodeSites returns the units each decode site counts for content, a
+// valid Revision of n resources in chunks that the parser completes.
+func decodeSites(t *testing.T, content []byte, n int) map[site]int {
+	t.Helper()
+	values, _ := tokenCounts(t, content)
+	chunks := (n + streamChunk - 1) / streamChunk
+	return map[site]int{
+		siteCopy: pieces(len(content)), siteNode: values, siteElement: n, siteCheck: n, siteMember: 3 * n,
+		// The document, format and resources, then each resource's root
+		// and kind, are not re-encoded through the writer.
+		siteValue: values - 3 - 2*n, siteDocument: 2, siteChunk: 2 * chunks, siteSequence: n, siteEnvelope: n,
+	}
+}
+
+// TestYieldDecode: every goroutine of a Decode, Verify or ReadDump reads
+// its yield timer at every site, with one worker and with several, and
+// yields when YieldAfter has passed: between elements parsed and checked,
+// entries sequenced and built, and pieces copied and hashed, and every 256
+// units inside one: values built, walked and re-encoded, tokens of a dump
+// scanned (01 req 53, WP-39 review round 5). On a clock where YieldAfter
+// passes at every read each site counts its exact units, every timer
+// yields at each boundary, the resource of more than 2,000 values yields
+// inside itself, and each goroutine the decode starts has a timer of its
+// own.
+func TestYieldDecode(t *testing.T) {
+	b, bigValues := yieldBundle(t)
+	content := mustEncodeBundle(t, b)
+	n := len(b.Resources())
+	rev := revision.Revision{Content: content, Digest: revision.Sum(content)}
+	body := dumpOf(t, nil, rev, rev.Digest)
+	_, contentTokens := tokenCounts(t, content)
+	names := siteNames()
+	for _, w := range []int{1, 4} {
+		for _, mode := range []string{"Decode", "Verify", "ReadDump"} {
+			now, after := due()
+			dec := NewDecoder(hubIndex(t), DecoderOptions{Workers: w, Now: now, YieldAfter: after})
+			var o observed
+			dec.observe = o.add
+			var err error
+			switch mode {
+			case "Decode":
+				_, err = dec.Decode(context.Background(), content, Source{})
+			case "Verify":
+				_, err = dec.Verify(context.Background(), content, rev.Digest, Source{})
+			default:
+				_, _, err = dec.ReadDump(context.Background(), bytes.NewReader(body), 0, Source{})
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			ys := o.take()
+			sites, _, _ := total(ys)
+			what := mode + ", workers " + strconv.Itoa(w)
+			want := decodeSites(t, content, n)
+			if mode != "Decode" {
+				want[siteHash] = pieces(len(content))
+			}
+			if mode == "ReadDump" {
+				// content, digest, lastKnownGood and revision, and the
+				// content's tokens after its first, skipped by the scan.
+				want[siteDump] = 4
+				want[siteToken] = contentTokens - 1
+			}
+			for s, name := range names {
+				got := sites[s]
+				switch site(s) {
+				case siteWalkMember, siteWalkItem:
+					if got < n {
+						t.Errorf("%s: site %s counted %d", what, name, got)
+					}
+				default:
+					if got != want[site(s)] {
+						t.Errorf("%s: site %s counted %d, want %d", what, name, got, want[site(s)])
+					}
+				}
+			}
+			if w > 1 && len(ys) < 2 {
+				t.Errorf("%s: %d goroutines with a timer, want the caller's and at least one worker's", what, len(ys))
+			}
+			checkYields(t, what, ys, bigValues)
+		}
+	}
+}
