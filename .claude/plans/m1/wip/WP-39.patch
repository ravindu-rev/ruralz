+
+// TestSecretValuesNeverEncoded is the stage L part of the secret leak test
+// (02 test plan 26; 02 req 34; 04 req 74, "secretRef shown, values
+// never"): with a canary in RURALZ_STATE_STORE_URL and in file secrets, a
+// Gateway whose stateStore.url and listener TLS use secretRefs encodes,
+// dumps, decodes and reads back with the references (provider, name, key)
+// and without any canary. Every output of the package is checked: the
+// canonical bytes, the /config/dump document, the decoded trees and the
+// dump ReadDump returns.
+func TestSecretValuesNeverEncoded(t *testing.T) {
+	t.Setenv("RURALZ_STATE_STORE_URL", envCanary)
+	secrets := t.TempDir()
+	certFile := filepath.ToSlash(filepath.Join(secrets, "tls.crt"))
+	keyFile := filepath.ToSlash(filepath.Join(secrets, "tls.json"))
+	if err := os.WriteFile(certFile, []byte(certCanary), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyFile, []byte(`{"pem":"`+keyCanary+`"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bundleDir := t.TempDir()
+	gateway := `apiVersion: ruralz/v1alpha1
+kind: Gateway
+metadata:
+  name: edge
+spec:
+  listeners:
+    - name: https
+      protocol: https
+      port: 8443
+      tls:
+        certificates:
+          - name: edge
+            certificate: {secretRef: {provider: file, name: "` + certFile + `"}}
+            privateKey: {secretRef: {provider: file, name: "` + keyFile + `", key: pem}}
+  stateStore:
+    driver: redis
+    url: {secretRef: {provider: env, name: RURALZ_STATE_STORE_URL}}
+`
+	if err := os.WriteFile(filepath.Join(bundleDir, "ruralz.yaml"), []byte(gateway), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	rev, err := NewEncoder(hubIndex(t)).Encode(ctx, loadBundle(t, bundleDir), Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	refs := [][]byte{
+		[]byte(`"url":{"secretRef":{"name":"RURALZ_STATE_STORE_URL","provider":"env"}}`),
+		append(append([]byte(`"certificate":{"secretRef":{"name":`), quoted(t, certFile)...), `,"provider":"file"}}`...),
+		append(append([]byte(`"privateKey":{"secretRef":{"key":"pem","name":`), quoted(t, keyFile)...), `,"provider":"file"}}`...),
+	}
+	for _, ref := range refs {
+		if !bytes.Contains(rev.Content, ref) {
+			t.Errorf("canonical content lacks the reference %s:\n%s", ref, rev.Content)
+		}
+	}
+	noCanary(t, "canonical content", rev.Content)
+	body := dumpOf(t, nil, rev, rev.Digest)
+	noCanary(t, "/config/dump document", body)
+	for _, ref := range refs {
+		if !bytes.Contains(body, ref) {
+			t.Errorf("/config/dump document lacks the reference %s", ref)
+		}
+	}
+	dec := NewDecoder(hubIndex(t), DecoderOptions{})
+	rs, err := dec.Verify(ctx, rev.Content, rev.Digest, Source{Name: "lkg.json"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, r := range rs {
+		noCanaryTree(t, r.Root)
+	}
+	d, rs, err := dec.ReadDump(ctx, bytes.NewReader(body), 0, Source{Name: "dump.json"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	noCanary(t, "dump read back", d.Body)
+	for _, r := range rs {
+		noCanaryTree(t, r.Root)
+	}
+}
+
+// quoted returns the JSON string of s.
+func quoted(t *testing.T, s string) []byte {
+	t.Helper()
+	q, err := jsonval.AppendString(nil, s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return q
+}
+
+// noCanary fails when b holds a canary.
+func noCanary(t *testing.T, what string, b []byte) {
+	t.Helper()
+	for _, c := range []string{envCanary, certCanary, keyCanary} {
+		if bytes.Contains(b, []byte(c)) {
+			t.Errorf("%s holds the secret value %q", what, c)
+		}
+	}
+}
+
+// noCanaryTree fails when a key or scalar of n holds a canary.
+func noCanaryTree(t *testing.T, n *tree.Node) {
+	t.Helper()
+	if n == nil {
+		return
+	}
+	for _, c := range []string{envCanary, certCanary, keyCanary} {
+		if strings.Contains(n.Text, c) {
+			t.Errorf("decoded tree holds the secret value %q", c)
+		}
+	}
+	for _, m := range n.Members {
+		noCanaryTree(t, m.Value)
+	}
+	for _, it := range n.Items {
+		noCanaryTree(t, it)
+	}
+}
diff --git a/internal/config/canonical/since_test.go b/internal/config/canonical/since_test.go
index a919942..956e123 100644
--- a/internal/config/canonical/since_test.go
+++ b/internal/config/canonical/since_test.go
@@ -5,6 +5,7 @@ package canonical
 
 import (
 	"context"
+	"runtime"
 	"strings"
 	"testing"
 
@@ -159,3 +160,111 @@ func materializeSince(t *testing.T, idx *schemaidx.Index, rs []tree.Resource) {
 		}
 	}
 }
+
+// recursiveSince is a level-1 schema whose Gateway spec nests since
+// positions in one another: N's member c is an N at schema level 1 with
+// the default {}.
+const recursiveSince = `{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "type": "object",
+  "required": ["apiVersion", "kind", "metadata", "spec"],
+  "properties": {"apiVersion": {"const": "test/v1"}, "kind": {"enum": ["Gateway"]}},
+  "allOf": [
+    {"if": {"properties": {"kind": {"const": "Gateway"}}, "required": ["kind"]}, "then": {"$ref": "#/$defs/Gateway"}}
+  ],
+  "$defs": {
+    "Meta": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}}},
+    "Gateway": {"type": "object", "additionalProperties": false, "properties": {
+      "apiVersion": {"const": "test/v1"}, "kind": {"const": "Gateway"},
+      "metadata": {"$ref": "#/$defs/Meta"}, "spec": {"$ref": "#/$defs/N"}}},
+    "N": {"type": "object", "additionalProperties": false, "properties": {
+      "c": {"$ref": "#/$defs/N", "x-ruralz-since": 1, "default": {}},
+      "v": {"type": "integer"}}}
+  }
+}`
+
+// TestSinceLinear: since omission costs one encoding of each value, so
+// encoding and decoding a spec whose since positions nest depth deep is
+// linear in depth (WP-39 review round 5: each since position encoded its
+// whole value once to compare it with the default and again to write it,
+// about 2^depth, so 22 levels took 8 s to encode and 12 s to decode). The
+// bytes Encode and Decode allocate, the least of three runs, grow by less
+// than a factor of 3 from 6 to 12 and from 12 to 18 levels, where the
+// doubling per level made it some 64 (counted bytes, not time); the values
+// written grow by the same number from one depth to the next, and a value
+// at its default is still left out at every level.
+func TestSinceLinear(t *testing.T) {
+	idx, err := schemaidx.Load("test/v1", []byte(recursiveSince))
+	if err != nil {
+		t.Fatal(err)
+	}
+	enc := NewEncoder(idx)
+	dec := NewDecoder(idx, DecoderOptions{Workers: 1})
+	spec := func(depth int) string {
+		return strings.Repeat(`{"c":`, depth) + `{"v":1}` + strings.Repeat(`}`, depth)
+	}
+	gateway := func(depth int) string {
+		return `{"apiVersion":"test/v1","kind":"Gateway","metadata":{"name":"g"},"spec":` + spec(depth) + `}`
+	}
+	least := func(fn func()) float64 {
+		best := ^uint64(0)
+		for range 3 {
+			var before, after runtime.MemStats
+			runtime.ReadMemStats(&before)
+			fn()
+			runtime.ReadMemStats(&after)
+			best = min(best, after.TotalAlloc-before.TotalAlloc)
+		}
+		return float64(best)
+	}
+	var encBytes, decBytes []float64
+	var written []int
+	for _, depth := range []int{6, 12, 18} {
+		b := bundleOf(t, gateway(depth))
+		var content []byte
+		encBytes = append(encBytes, least(func() {
+			rev, err := enc.Encode(context.Background(), b, Options{Level: 1})
+			if err != nil {
+				t.Fatal(err)
+			}
+			content = rev.Content
+		}))
+		if want := doc(`{"kind":"Gateway","metadata":{"name":"g"},"spec":` + spec(depth) + `}`); string(content) != want {
+			t.Fatalf("depth %d: %s, want %s", depth, content, want)
+		}
+		decBytes = append(decBytes, least(func() {
+			if _, err := dec.Decode(context.Background(), content, Source{}); err != nil {
+				t.Fatal(err)
+			}
+		}))
+		var o observed
+		enc.observe = o.add
+		now, after := due()
+		if _, err := enc.Encode(context.Background(), b, Options{Level: 1, Now: now, YieldAfter: after}); err != nil {
+			t.Fatal(err)
+		}
+		enc.observe = nil
+		sites, _, _ := total(o.take())
+		written = append(written, sites[siteValue])
+	}
+	for i := 1; i < 3; i++ {
+		if r := encBytes[i] / encBytes[i-1]; r >= 3 {
+			t.Errorf("Encode: %.0f bytes at %d levels, %.0f at %d: %.1f times, want linear", encBytes[i], 6*(i+1), encBytes[i-1], 6*i, r)
+		}
+		if r := decBytes[i] / decBytes[i-1]; r >= 3 {
+			t.Errorf("Decode: %.0f bytes at %d levels, %.0f at %d: %.1f times, want linear", decBytes[i], 6*(i+1), decBytes[i-1], 6*i, r)
+		}
+	}
+	if written[2]-written[1] != written[1]-written[0] || written[1]-written[0] != 6 {
+		t.Errorf("values written at 6, 12 and 18 levels: %v, want 6 more per 6 levels", written)
+	}
+	// A spec at its default, nested in since positions, is left out level
+	// by level: {"c":{"c":{}}} has the default {} innermost, so the inner c
+	// is omitted, which leaves {"c":{}} at the default again, and so on.
+	at := bundleOf(t, `{"apiVersion":"test/v1","kind":"Gateway","metadata":{"name":"g"},"spec":{"c":{"c":{"c":{}}},"v":2}}`)
+	rev, err := enc.Encode(context.Background(), at, Options{Level: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sameBytes(t, "nested defaults", rev.Content, []byte(doc(`{"kind":"Gateway","metadata":{"name":"g"},"spec":{"v":2}}`)))
+}
diff --git a/internal/config/canonical/stageg_test.go b/internal/config/canonical/stageg_test.go
new file mode 100644
index 0000000..b4f1a5f
--- /dev/null
+++ b/internal/config/canonical/stageg_test.go
@@ -0,0 +1,136 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/defaults"
+	"github.com/ravindu-rev/ruralz/internal/config/profile"
+	"github.com/ravindu-rev/ruralz/internal/config/registry"
+	"github.com/ravindu-rev/ruralz/internal/config/schemaidx"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+	"github.com/ravindu-rev/ruralz/pkg/config/v1alpha1"
+)
+
+// stageG returns stage G over the embedded schemas and the Policy type
+// registry, as the pipeline builds it.
+func stageG(t *testing.T) *defaults.Stage {
+	t.Helper()
+	set, err := schemaidx.Embedded()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := defaults.New(defaults.Options{Schemas: set, Registry: registry.New()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+// parseResources parses every source of a testdata directory with the
+// restricted profile into envelope trees, as stages A to F hand them to
+// stage G, registering each file in files with RoleBase.
+func parseResources(t *testing.T, dir string, files *tree.FileTable) []*tree.Resource {
+	t.Helper()
+	names, err := filepath.Glob(filepath.Join(dir, "*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	slices.Sort(names)
+	var rs []*tree.Resource
+	for _, name := range names {
+		f, ok := profile.FormatOf(name)
+		if !ok {
+			continue
+		}
+		src, err := os.ReadFile(name) //nolint:gosec // G304: a file under testdata.
+		if err != nil {
+			t.Fatal(err)
+		}
+		id := files.Add(tree.File{Path: filepath.ToSlash(name), Role: tree.RoleBase})
+		docs, ds, err := profile.Parse(context.Background(), src, id, name, f, profile.Options{})
+		if err != nil || len(ds) > 0 {
+			t.Fatalf("Parse(%s) = %v, %v", name, ds, err)
+		}
+		for _, d := range docs {
+			k, _ := d.Root.Get("kind")
+			meta, _ := d.Root.Get("metadata")
+			n, _ := meta.Get("name")
+			av, _ := d.Root.Get("apiVersion")
+			rs = append(rs, &tree.Resource{ID: tree.ID{Kind: v1alpha1.Kind(k.Text), Name: n.Text}, APIVersion: av.Text, Root: d.Root, Start: d.Start})
+		}
+	}
+	return rs
+}
+
+// TestStageGRoundTrip runs the real stage G on Decode output, as
+// pipeline.FromResources does with a Last-Known-Good or handover
+// candidate (R-47; 02 test plan item 13, Materialize(Decode(x)) ==
+// Decode(x); WP-39 review round 5: only a synthetic materialization was
+// tested). For the example Bundle, its JSON twin and the minimal Bundle:
+// stage G, then Encode, gives a Revision; Verify of it, with one worker
+// and with four, into a file table whose first file is a base file,
+// re-encodes to the same bytes, and stage G again on the decoded trees
+// gives a Bundle whose resources carry no source file (their positions
+// name the tree.RoleCanonical file Decode registered, which also exempts
+// them from the integer range rule, R-64) and which encodes to the same
+// bytes and digest.
+func TestStageGRoundTrip(t *testing.T) {
+	ctx := context.Background()
+	g := stageG(t)
+	enc := NewEncoder(hubIndex(t))
+	for _, dir := range []string{"shop", "shop-json", "minimal"} {
+		files := &tree.FileTable{}
+		b, ds, err := g.Run(ctx, parseResources(t, filepath.Join("testdata", "bundles", dir), files), files, 2)
+		if err != nil || len(ds) > 0 {
+			t.Fatalf("%s: stage G: %v, %v", dir, ds, err)
+		}
+		rev, err := enc.Encode(ctx, b, Options{Workers: 3})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, w := range []int{1, 4} {
+			lkg := &tree.FileTable{}
+			lkg.Add(tree.File{Path: "base.yaml", Role: tree.RoleBase})
+			rs, err := NewDecoder(hubIndex(t), DecoderOptions{Workers: w}).Verify(ctx, rev.Content, rev.Digest, Source{Name: "lkg.json", Files: lkg})
+			if err != nil {
+				t.Fatalf("%s, workers %d: Verify: %v", dir, w, err)
+			}
+			again, err := enc.EncodeResources(ctx, rs, Options{Workers: w})
+			if err != nil {
+				t.Fatal(err)
+			}
+			sameBytes(t, dir+": decode then encode", again.Content, rev.Content)
+			ptrs := make([]*tree.Resource, len(rs))
+			for i := range rs {
+				ptrs[i] = &rs[i]
+				if role := lkg.File(rs[i].Start.File).Role; role != tree.RoleCanonical {
+					t.Errorf("%s, workers %d: %s starts in a file of role %v", dir, w, rs[i].ID, role)
+				}
+			}
+			b2, ds, err := g.Run(ctx, ptrs, lkg, w)
+			if err != nil || len(ds) > 0 {
+				t.Fatalf("%s, workers %d: stage G on the decoded trees: %v, %v", dir, w, ds, err)
+			}
+			for _, r := range b2.Resources() {
+				if r.Source.File != "" {
+					t.Errorf("%s, workers %d: %s has source file %q, want none for canonical content", dir, w, r.ID, r.Source.File)
+				}
+			}
+			rev2, err := enc.Encode(ctx, b2, Options{Workers: w})
+			if err != nil {
+				t.Fatal(err)
+			}
+			sameBytes(t, dir+": stage G on the decoded trees", rev2.Content, rev.Content)
+			if rev2.Digest != rev.Digest {
+				t.Errorf("%s, workers %d: digest %s, want %s", dir, w, rev2.Digest, rev.Digest)
+			}
+		}
+	}
+}
diff --git a/internal/config/canonical/stream.go b/internal/config/canonical/stream.go
new file mode 100644
index 0000000..1dc9879
--- /dev/null
+++ b/internal/config/canonical/stream.go
@@ -0,0 +1,313 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// streamChunk is how many consecutive resources make one unit of decode
+// work: large enough that handing one over costs little next to checking
+// it, small enough that workers start while the parser is still early in a
+// large Revision.
+const streamChunk = 32
+
+// errPanicked stops the parse once a check panicked: the decode raises
+// that panic once its goroutines have returned.
+var errPanicked = errors.New("canonical: a check panicked")
+
+// chunk is a run of consecutive elements of the top-level resources array
+// and the results of their checks. The parser goroutine fills items and
+// spans before handing the chunk over; the checker that receives it owns
+// the results until stream returns, and drops items and spans once it has
+// checked them. Findings, and a context error a checker meets, go to the
+// decode's run.
+type chunk struct {
+	// lo is the index of the first element in the array.
+	lo    int
+	items []*tree.Node
+	spans [][2]int
+	// entries holds one entry per element whose envelope tree could be
+	// built, in order, while the decode can still succeed (run.fails).
+	entries []entry
+	// done is set once the checker is done with the chunk, after which
+	// only the parser goroutine reads it (sweep).
+	done atomic.Bool
+}
+
+// stream parses the content and checks each element of its top-level
+// resources array as soon as the parser has completed it (02 req 78): the
+// envelope rules, the newer walk and the re-encoding. A decode runs on
+// d.workers goroutines at most: the calling goroutine parses and, each
+// time a chunk fills, hands it to the goroutines stream owns through a
+// channel of capacity d.workers-1, starting one more goroutine with each
+// chunk it hands over until there are d.workers-1, so a decode never runs
+// more goroutines than it has chunks. When the channel is full the parser
+// checks the chunk itself instead of queueing more or waiting. With one
+// worker, or content too small to fill a chunk while parsing, the checks
+// run on the calling goroutine, as do those of the last chunk. Once the
+// parse ends, successfully or not, stream checks the elements the parser
+// completed that no chunk holds yet, closes the channel and waits for
+// every goroutine before it returns, on every path out of it: success,
+// failure, cancellation and a panic.
+//
+// The parser stops early once the newer findings of r passed the cap
+// (errStop), at a format other than ruralz.canonical.v1 (errOther), at a
+// limit of the decoder (CodeLimit) or at invalid JSON (CodeMismatch); end
+// is that reason, or nil when it read the whole content. A worker skips
+// the rest of its chunks once ctx is done, and the parser checks ctx
+// between resources; err is ctx's error, which wins over every other
+// outcome. A panic in a check, on any goroutine, stops the parse and the
+// remaining checks and is raised again once every goroutine has returned
+// (workPanic).
+//
+// y is the calling goroutine's yield timer, which the parser and the
+// checks made on that goroutine share; each goroutine stream starts has
+// its own. r counts the goroutines started and the chunks handed over and
+// in flight (completed by the parser and not yet checked), which the
+// tests of these bounds read.
+func (d *Decoder) stream(ctx context.Context, in *input, r *run, y *yielder) (doc *tree.Node, chunks []*chunk, end, err error) {
+	var (
+		cur      *chunk
+		work     chan *chunk
+		wg       sync.WaitGroup
+		ps       panics
+		own      = d.newChecker(in, r, y)
+		canceled error
+	)
+	// join closes the channel and waits for the workers, once, whichever
+	// way stream returns.
+	joined := false
+	join := func() {
+		if work != nil && !joined {
+			joined = true
+			close(work)
+			wg.Wait()
+		}
+	}
+	defer join()
+	check := func(c *checker, ch *chunk) {
+		if !ps.stop.Load() {
+			ps.run(func() { c.run(ctx, ch) })
+		}
+	}
+	// flush hands the current chunk to a worker, or checks it on the
+	// calling goroutine when there is one worker, when the channel is full
+	// (the workers are behind, so waiting for them would only idle the
+	// parser) or when the parse has ended.
+	flush := func(inline bool) {
+		if cur == nil {
+			return
+		}
+		ch := cur
+		cur = nil
+		r.busy(1)
+		// A chunk is kept for its entries only while the decode can still
+		// succeed; once it is known to fail, none of its elements gets
+		// one, and keeping it would cost memory linear in the content.
+		// The chunks checked before a finding was known are dropped too.
+		chunks = sweep(r, chunks)
+		if !r.fails(ch.lo) {
+			chunks = append(chunks, ch)
+		}
+		if !inline && d.workers > 1 {
+			if work == nil {
+				work = make(chan *chunk, d.workers-1)
+			}
+			select {
+			case work <- ch:
+				r.handed++
+				if r.started < d.workers-1 {
+					r.started++
+					wg.Go(func() {
+						wy := d.newYielder()
+						defer d.done(wy)
+						c := d.newChecker(in, r, wy)
+						for ch := range work {
+							check(c, ch)
+							r.busy(-1)
+						}
+					})
+				}
+				return
+			default:
+			}
+		}
+		check(own, ch)
+		r.busy(-1)
+	}
+	each := func(i int, rn *tree.Node, lo, hi int) error {
+		if err := ctx.Err(); err != nil {
+			canceled = err
+			return err
+		}
+		if ps.stop.Load() {
+			return errPanicked
+		}
+		if r.newer.full.Load() {
+			// The findings kept all lie before this element.
+			return errStop
+		}
+		y.check(siteElement)
+		if cur == nil {
+			cur = &chunk{lo: i, items: make([]*tree.Node, 0, streamChunk), spans: make([][2]int, 0, streamChunk)}
+		}
+		cur.items = append(cur.items, rn)
+		cur.spans = append(cur.spans, [2]int{lo, hi})
+		if len(cur.items) == streamChunk {
+			flush(false)
+		}
+		return nil
+	}
+	doc, end = d.parse(in, r, y, each)
+	if canceled == nil {
+		// The parser is done, so its goroutine checks the elements it
+		// completed last while the workers finish their chunks: after
+		// invalid JSON, a limit or another format too, so the newer
+		// findings before that point are all known.
+		flush(true)
+	}
+	join()
+	ps.raise()
+	if canceled == nil {
+		canceled = r.canceledBy()
+	}
+	if canceled != nil {
+		return nil, nil, nil, canceled
+	}
+	return doc, chunks, end, nil
+}
+
+// checker is the scratch of one goroutine's resource checks: the writer
+// of the re-encoding, its buffer, the findings and the identity of the
+// current resource, the newer walk, and the goroutine's yield timer.
+type checker struct {
+	d     *Decoder
+	in    *input
+	r     *run
+	y     *yielder
+	w     writer
+	buf   []byte
+	found found
+	who   ident
+	nw    newerWalk
+}
+
+func (d *Decoder) newChecker(in *input, r *run, y *yielder) *checker {
+	return &checker{d: d, in: in, r: r, y: y, w: writer{y: y}, found: found{limit: d.maxDiags + 1}, nw: newerWalk{d: d, in: in, y: y}}
+}
+
+// run checks the elements of ch: the envelope rules and the newer walk,
+// offering their findings to the run, and, for each element with an
+// entry, the re-encoding while the decode can still succeed. It stops at
+// the first element whose findings all come after the newer findings
+// kept: none of them can be kept, and with a newer finding known neither
+// form findings nor the re-encoding matter. Form findings are not built
+// once a newer finding is known or none of the element's can be kept.
+// An element's entry, and with it its tree, is kept only while the decode
+// can still succeed (run.fails): once it is known to fail, the trees the
+// checks are done with are unlinked and garbage, so a failing decode
+// holds no more than the elements in flight. The re-encoding is wasted
+// when a later part of the content has a finding; its result is then not
+// read.
+func (c *checker) run(ctx context.Context, ch *chunk) {
+	j := 0
+	defer func() {
+		// The elements left unchecked are dropped too.
+		for ; j < len(ch.items); j++ {
+			unlink(ch.items[j])
+		}
+		ch.items, ch.spans = nil, nil
+		ch.done.Store(true)
+	}()
+	content := c.in.content()
+	r := c.r
+	for ; j < len(ch.items); j++ {
+		rn := ch.items[j]
+		if err := ctx.Err(); err != nil {
+			r.cancel(err)
+			return
+		}
+		i := ch.lo + j
+		if r.newer.after(i) {
+			return
+		}
+		c.y.check(siteCheck)
+		r.checked.Add(1)
+		c.found.reset(!r.newer.any() && !r.form.after(i))
+		e := c.resource(rn, i)
+		r.newer.addResource(i, c.found.newer, c.y)
+		if !r.newer.any() {
+			r.form.addResource(i, c.found.form, c.y)
+		}
+		if e.node == nil || r.fails(i) {
+			unlink(rn)
+			continue
+		}
+		e.start, e.end = ch.spans[j][0], ch.spans[j][1]
+		c.buf = c.d.form(&c.w, c.buf[:0], &e, content, c.in)
+		if e.form != nil || e.diff >= 0 {
+			r.reject(i)
+		}
+		if ch.entries == nil {
+			ch.entries = make([]entry, 0, len(ch.items)-j)
+		}
+		ch.entries = append(ch.entries, e)
+	}
+}
+
+// sweep returns chunks without those whose entries the decode can no
+// longer read: once a finding is known, the decode fails whatever the
+// content holds, so the entries of every chunk whose check is done are
+// unlinked and dropped, those a check made before the finding was known
+// included (with several workers, those checked while another goroutine
+// was still checking an earlier element that had a finding). A chunk
+// still in check stays for a later sweep. Before any finding there is
+// nothing to drop and sweep does no work; after one, chunks holds only
+// the chunks in flight, since no further chunk is kept, so each sweep
+// costs at most 2(Workers-1)+1 steps. A rejected re-encoding alone
+// sweeps nothing: the entries up to the rejected resource still decide
+// the outcome (sequence), and those after it that were checked before
+// the rejection was known are kept until the decode returns, as a decode
+// that succeeds keeps its own. Only the parser goroutine calls sweep.
+func sweep(r *run, chunks []*chunk) []*chunk {
+	if !r.newer.any() && !r.form.any() {
+		return chunks
+	}
+	keep := chunks[:0]
+	for _, ch := range chunks {
+		if !ch.done.Load() {
+			keep = append(keep, ch)
+			continue
+		}
+		for i := range ch.entries {
+			unlink(ch.entries[i].node)
+		}
+		ch.entries = nil
+	}
+	clear(chunks[len(keep):])
+	return keep
+}
+
+// unlink clears the member and item links of the tree under n, an element
+// the decode no longer needs. Its nodes, members and items come from
+// slabs it shares with the elements before and after it, which hold
+// links to each other's nodes, so a dropped element whose links stayed
+// would keep its neighbors' slabs alive, and through them, from the
+// parser's current slabs, every element before it. The checker that
+// received the element owns it: the parser never writes to it again.
+func unlink(n *tree.Node) {
+	for i := range n.Members {
+		unlink(n.Members[i].Value)
+	}
+	for _, it := range n.Items {
+		unlink(it)
+	}
+	n.Members, n.Items = nil, nil
+}
diff --git a/internal/config/canonical/stream_test.go b/internal/config/canonical/stream_test.go
new file mode 100644
index 0000000..9238d52
--- /dev/null
+++ b/internal/config/canonical/stream_test.go
@@ -0,0 +1,256 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/revision"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// routes returns canonical content of n Routes, the sixth (when there is
+// one) holding a non-ASCII annotation so positions after it leave the
+// locator's leading printable run.
+func routes(n int) []byte {
+	rs := make([]string, n)
+	for i := range n {
+		meta := `{"name":"r` + fmt.Sprintf("%04d", i) + `"}`
+		if i == 5 {
+			meta = `{"annotations":{"note":"é€😀"},"name":"r0005"}`
+		}
+		rs[i] = `{"kind":"Route","metadata":` + meta + `,"spec":{"match":{"path":{"prefix":"/` + strconv.Itoa(i) + `"}},"timeout":"4s"}}`
+	}
+	return []byte(doc(rs...))
+}
+
+// diffTree returns where two trees first differ, positions included, or
+// "".
+func diffTree(at string, a, b *tree.Node) string {
+	switch {
+	case a == nil || b == nil:
+		if a != b {
+			return at + ": one side is nil"
+		}
+		return ""
+	case a.Kind != b.Kind || a.Style != b.Style || a.Pos != b.Pos || a.Text != b.Text || a.Bool != b.Bool:
+		return fmt.Sprintf("%s: %v %v %+v %q %v != %v %v %+v %q %v", at, a.Kind, a.Style, a.Pos, a.Text, a.Bool, b.Kind, b.Style, b.Pos, b.Text, b.Bool)
+	case len(a.Members) != len(b.Members) || len(a.Items) != len(b.Items) || (a.Items == nil) != (b.Items == nil):
+		return at + ": different member or item counts"
+	}
+	for i := range a.Members {
+		ma, mb := a.Members[i], b.Members[i]
+		if ma.Key != mb.Key || ma.KeyPos != mb.KeyPos {
+			return fmt.Sprintf("%s: member %d %q %+v != %q %+v", at, i, ma.Key, ma.KeyPos, mb.Key, mb.KeyPos)
+		}
+		if d := diffTree(at+"."+ma.Key, ma.Value, mb.Value); d != "" {
+			return d
+		}
+	}
+	for i := range a.Items {
+		if d := diffTree(at+"["+strconv.Itoa(i)+"]", a.Items[i], b.Items[i]); d != "" {
+			return d
+		}
+	}
+	return ""
+}
+
+// diffResources returns where two decodes first differ, or "".
+func diffResources(a, b []tree.Resource) string {
+	if len(a) != len(b) {
+		return fmt.Sprintf("%d resources != %d", len(a), len(b))
+	}
+	for i := range a {
+		if a[i].ID != b[i].ID || a[i].APIVersion != b[i].APIVersion || a[i].Start != b[i].Start {
+			return fmt.Sprintf("resource %d: %+v != %+v", i, a[i], b[i])
+		}
+		if d := diffTree(a[i].ID.String(), a[i].Root, b[i].Root); d != "" {
+			return d
+		}
+	}
+	return ""
+}
+
+// TestDecodeWorkersSameTrees: the decoded trees, positions included, do
+// not depend on the worker count (02 req 78) at any chunk boundary of the
+// stream (no resource, fewer than one chunk, one chunk exactly, one more,
+// many chunks), for content and for a dump, whose positions count from the
+// document start.
+func TestDecodeWorkersSameTrees(t *testing.T) {
+	ctx := context.Background()
+	for _, n := range []int{0, 1, streamChunk - 1, streamChunk, streamChunk + 1, 2 * streamChunk, 2*streamChunk + 1, 300} {
+		content := routes(n)
+		want := mustDecode(t, content)
+		if len(want) != n {
+			t.Fatalf("%d routes: decoded %d", n, len(want))
+		}
+		rev := revision.Revision{Content: content, Digest: revision.Sum(content)}
+		body := dumpOf(t, nil, rev, revision.Digest{})
+		_, wantDump, err := NewDecoder(hubIndex(t), DecoderOptions{}).ReadDump(ctx, bytes.NewReader(body), 0, Source{Name: "c.json"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, w := range []int{2, 3, 8} {
+			dec := NewDecoder(hubIndex(t), DecoderOptions{Workers: w})
+			got, err := dec.Decode(ctx, content, Source{Name: "c.json"})
+			if err != nil {
+				t.Fatalf("%d routes, workers %d: %v", n, w, err)
+			}
+			if d := diffResources(want, got); d != "" {
+				t.Errorf("%d routes, workers %d: %s", n, w, d)
+			}
+			_, gotDump, err := dec.ReadDump(ctx, bytes.NewReader(body), 0, Source{Name: "c.json"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if d := diffResources(wantDump, gotDump); d != "" {
+				t.Errorf("%d routes, workers %d, dump: %s", n, w, d)
+			}
+		}
+	}
+}
+
+// TestDecodeWorkersSameFindings: the findings of every level, and their
+// order, do not depend on the worker count, with findings spread over many
+// chunks.
+func TestDecodeWorkersSameFindings(t *testing.T) {
+	content := routes(200)
+	newer := bytes.ReplaceAll(content, []byte(`"timeout":"4s"`), []byte(`"timeout":"4s","zz":1`))
+	newer = bytes.Replace(newer, []byte(`"resources":[`), []byte(`"aa":1,"resources":[`), 1)
+	form := bytes.ReplaceAll(content, []byte(`{"kind":"Route","metadata":{"name":"r01`), []byte(`{"apiVersion":"x","kind":"Route","metadata":{"name":"r01`))
+	for _, tc := range []struct {
+		name    string
+		content []byte
+		code    string
+		count   int
+	}{
+		{"newer", newer, CodeNewer, 201},
+		{"form", form, CodeMismatch, 100},
+	} {
+		var first string
+		for _, w := range []int{1, 2, 3, 8} {
+			_, err := NewDecoder(hubIndex(t), DecoderOptions{Workers: w}).Decode(context.Background(), tc.content, Source{Name: "c.json"})
+			ds := DiagnosticsOf(err)
+			if codeOf(err) != tc.code || len(ds) != tc.count {
+				t.Fatalf("%s, workers %d: %d findings, error %v", tc.name, w, len(ds), err)
+			}
+			got := describe(ds)
+			if first == "" {
+				first = got
+			} else if got != first {
+				t.Errorf("%s, workers %d: findings differ from one worker's", tc.name, w)
+			}
+		}
+	}
+}
+
+// describe prints findings by value: code, location, resource, path and
+// message.
+func describe(ds diag.List) string {
+	var b strings.Builder
+	for _, d := range ds {
+		res := ""
+		if d.Resource != nil {
+			res = d.Resource.Kind + "/" + d.Resource.Name
+		}
+		fmt.Fprintf(&b, "%s %s:%d:%d %s %s %s\n", d.Code, d.File, d.Line, d.Column, res, d.Path, d.Message)
+	}
+	return b.String()
+}
+
+// TestDecodedSlicesAreIndependent: every member and item slice of a
+// decoded tree, the envelope roots included, has its length as capacity,
+// so a later stage that appends to one reallocates instead of writing
+// into the slab slot of a neighbor.
+func TestDecodedSlicesAreIndependent(t *testing.T) {
+	var walk func(*tree.Node)
+	walk = func(n *tree.Node) {
+		if cap(n.Members) != len(n.Members) || cap(n.Items) != len(n.Items) {
+			t.Fatalf("node at %+v: members %d/%d, items %d/%d", n.Pos, len(n.Members), cap(n.Members), len(n.Items), cap(n.Items))
+		}
+		for _, m := range n.Members {
+			walk(m.Value)
+		}
+		for _, it := range n.Items {
+			walk(it)
+		}
+	}
+	rs := mustDecode(t, mustEncodeBundle(t, largeBundle(t, 40)))
+	for _, r := range rs {
+		walk(r.Root)
+	}
+	// Appending to one resource's members leaves the next one intact.
+	a, b := rs[1].Root, rs[2].Root
+	before := describeTree(b)
+	a.Members = append(a.Members, tree.Member{Key: "x", Value: &tree.Node{Kind: tree.KindNull}})
+	if describeTree(b) != before {
+		t.Error("appending to one resource's members changed its neighbor")
+	}
+}
+
+// describeTree prints the keys and texts of n in order.
+func describeTree(n *tree.Node) string {
+	var b strings.Builder
+	var walk func(*tree.Node)
+	walk = func(n *tree.Node) {
+		b.WriteString(n.Text)
+		for _, m := range n.Members {
+			b.WriteString("{" + m.Key + ":")
+			walk(m.Value)
+		}
+		for _, it := range n.Items {
+			b.WriteString("[")
+			walk(it)
+		}
+	}
+	walk(n)
+	return b.String()
+}
+
+// countdown is a context whose Err is nil for its first live calls and
+// context.Canceled after, from any goroutine.
+type countdown struct {
+	context.Context
+	live atomic.Int64
+}
+
+func (c *countdown) Err() error {
+	if c.live.Add(-1) >= 0 {
+		return nil
+	}
+	return context.Canceled
+}
+
+// TestDecodeCanceledMidStream: a context that ends at any point of a
+// decode, in the parser between resources or in a worker within a chunk,
+// fails the decode with its error, and a decode the context outlives
+// succeeds. The decode asks the context once, then once per resource as
+// the parser hands it over and once as it is checked, so live counts below
+// 1 + 2n end it and the others do not.
+func TestDecodeCanceledMidStream(t *testing.T) {
+	const n = streamChunk + 8
+	content := routes(n)
+	for _, w := range []int{1, 2, 4} {
+		dec := NewDecoder(hubIndex(t), DecoderOptions{Workers: w})
+		for live := range int64(2*n + 4) {
+			ctx := &countdown{Context: context.Background()}
+			ctx.live.Store(live)
+			rs, err := dec.Decode(ctx, content, Source{})
+			switch {
+			case live < 1+2*n && !errors.Is(err, context.Canceled):
+				t.Errorf("workers %d, live %d: error = %v, want context.Canceled", w, live, err)
+			case live >= 1+2*n && (err != nil || len(rs) != n):
+				t.Errorf("workers %d, live %d: %d resources, error = %v", w, live, len(rs), err)
+			}
+		}
+	}
+}
