new file mode 100644
index 0000000..1496683
--- /dev/null
+++ b/internal/config/canonical/keep.go
@@ -0,0 +1,283 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"cmp"
+	"errors"
+	"math"
+	"slices"
+	"sync"
+	"sync/atomic"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+)
+
+// DefaultMaxDiagnostics is the findings cap of one Decode, Verify or
+// ReadDump when DecoderOptions leaves it zero: the per-run cap of 01 req
+// 50 and 10 req 32 (10,000, proposed), which every other pipeline stage
+// applies too.
+const DefaultMaxDiagnostics = 10_000
+
+// CodeTooMany is the code of the last diagnostic of a decode that met more
+// findings than its cap: "too many diagnostics; stopped after N" (01 req
+// 50), as diag.Collector writes it. It is CodeLimit.
+const CodeTooMany = CodeLimit
+
+// Sentinels the parser stops with: the newer findings reached the cap, or
+// a format member names another format.
+var (
+	errStop  = errors.New("canonical: the findings reached the cap")
+	errOther = errors.New("canonical: the content names another format")
+)
+
+// order is the content order of a finding: the ordinal of its top-level
+// member (-1 for a finding about the document itself), the index of its
+// resource in the resources array and its index among the findings of
+// that resource or member. Findings of one resource are collected in
+// content order, so the order of two findings is the order of their
+// positions in the content, without reading a position.
+type order struct {
+	member, res, seq int
+}
+
+func (a order) compare(b order) int {
+	return cmp.Or(cmp.Compare(a.member, b.member), cmp.Compare(a.res, b.res), cmp.Compare(a.seq, b.seq))
+}
+
+// kept is one finding a keeper holds.
+type kept struct {
+	o order
+	d diag.Diagnostic
+}
+
+// keeper keeps the first n findings of one code of a decode in content
+// order, out of the findings the parser and every checker offer in any
+// order (01 req 50). It holds fewer than 2n: once n were offered it sorts
+// them, and from then on it drops at once a finding that comes after the
+// last one kept, and sorts and cuts back to n whenever it reaches 2n. The
+// kept set is therefore the same whatever order the findings arrive in,
+// so it does not depend on scheduling, and f offers cost at most f/n+2
+// sorts of at most 2n entries, whatever n is: the test for 2n never
+// multiplies, so no n overflows it. It is safe for concurrent use.
+type keeper struct {
+	mu       sync.Mutex
+	n        int
+	entries  []kept
+	bound    order
+	hasBound bool
+	// prunes counts the sorts, which the tests of the keeper's cost read.
+	prunes int
+	// resources is the ordinal of the top-level resources member, set by
+	// the parser before any resource finding is offered; -1 before.
+	resources int
+	// some is set by the first finding offered and full once n were, when
+	// every finding still to come from the parser comes after the n kept.
+	some, full atomic.Bool
+	// last is the index of the last resource that can still hold a kept
+	// finding: math.MaxInt64 until the bound falls in the resources array.
+	// (A bound before the array stops the parser before any resource is
+	// read.)
+	last atomic.Int64
+}
+
+func newKeeper(n int) *keeper {
+	k := &keeper{n: max(1, n), resources: -1}
+	k.last.Store(math.MaxInt64)
+	return k
+}
+
+// setResources records the ordinal of the resources member.
+func (k *keeper) setResources(member int) {
+	k.mu.Lock()
+	k.resources = member
+	k.mu.Unlock()
+}
+
+// any reports whether a finding was offered.
+func (k *keeper) any() bool { return k.some.Load() }
+
+// after reports whether every finding of resource i comes after the last
+// finding kept, so none of them can be kept.
+func (k *keeper) after(i int) bool { return int64(i) > k.last.Load() }
+
+// add offers one finding; y is the offering goroutine's yield timer,
+// charged for the work of the offer, as in addResource and list.
+func (k *keeper) add(o order, d diag.Diagnostic, y *yielder) {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	k.offer(o, d, y)
+}
+
+// addResource offers the findings of resource i, in content order.
+func (k *keeper) addResource(i int, ds diag.List, y *yielder) {
+	if len(ds) == 0 {
+		return
+	}
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	for j := range ds {
+		k.offer(order{member: k.resources, res: i, seq: j}, ds[j], y)
+	}
+}
+
+// offer records d at o; k.mu is held.
+func (k *keeper) offer(o order, d diag.Diagnostic, y *yielder) {
+	y.charge(siteOffer, 1)
+	k.some.Store(true)
+	if k.hasBound && o.compare(k.bound) >= 0 {
+		return
+	}
+	k.entries = append(k.entries, kept{o: o, d: d})
+	if (!k.hasBound && len(k.entries) >= k.n) || len(k.entries)-k.n >= k.n {
+		k.prune(y)
+	}
+}
+
+// prune sorts the entries and keeps the first n; k.mu is held. A yield
+// while it is held only delays the other goroutines of the decode.
+func (k *keeper) prune(y *yielder) {
+	k.prunes++
+	slices.SortFunc(k.entries, func(a, b kept) int {
+		y.charge(siteKeepSort, 1)
+		return a.o.compare(b.o)
+	})
+	if len(k.entries) < k.n {
+		return
+	}
+	clear(k.entries[k.n:])
+	k.entries = k.entries[:k.n]
+	k.bound, k.hasBound = k.entries[k.n-1].o, true
+	if k.resources >= 0 && k.bound.member == k.resources {
+		k.last.Store(int64(k.bound.res))
+	}
+	k.full.Store(true)
+}
+
+// list returns the kept findings in content order: all of them when
+// fewer than n were offered, else the first n.
+func (k *keeper) list(y *yielder) diag.List {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	k.prune(y)
+	if len(k.entries) == 0 {
+		return nil
+	}
+	out := make(diag.List, len(k.entries))
+	for i := range k.entries {
+		y.charge(siteList, 1)
+		out[i] = k.entries[i].d
+	}
+	return out
+}
+
+// run is the state one decode shares between its parser and its
+// checkers: the newer and the form findings kept so far, each code with
+// its own budget so a newer producer still wins over a form problem, the
+// first resource whose re-encoding failed, and the finding of a format
+// member that names another format.
+type run struct {
+	newer, form *keeper
+	// rejected is the index of the first resource whose re-encoding
+	// differs from the content or fails, math.MaxInt64 while there is
+	// none. The resources after it can no longer change the outcome:
+	// sequence reports the first failure by offset, which lies at or
+	// before that resource's own.
+	rejected atomic.Int64
+	// other is written by the parser goroutine before it stops with
+	// errOther.
+	other diag.Diagnostic
+	// mu guards canceled, the context error a checker met first.
+	mu       sync.Mutex
+	canceled error
+	// started counts the goroutines the decode started and handed the
+	// chunks it handed to them, both written by the parser goroutine;
+	// inFlight counts the chunks the parser completed that no check has
+	// finished, and peak the most there were at once. The tests of the
+	// decode's goroutine and queue bounds read them (at most Workers-1
+	// goroutines, never more than chunks handed over, and 2(Workers-1)+1
+	// chunks in flight).
+	started, handed int
+	inFlight, peak  atomic.Int64
+	// checked counts the elements the checks judged, for the tests of
+	// what they skip.
+	checked atomic.Int64
+}
+
+// busy adds k to the chunks in flight, recording the most.
+func (r *run) busy(k int64) {
+	n := r.inFlight.Add(k)
+	for {
+		p := r.peak.Load()
+		if n <= p || r.peak.CompareAndSwap(p, n) {
+			return
+		}
+	}
+}
+
+// cancel records the context error a checker met.
+func (r *run) cancel(err error) {
+	r.mu.Lock()
+	if r.canceled == nil {
+		r.canceled = err
+	}
+	r.mu.Unlock()
+}
+
+// canceledBy returns the context error a checker met, or nil.
+func (r *run) canceledBy() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.canceled
+}
+
+// newRun returns the state of a decode whose cap is maxDiags, at most
+// maxCount: each keeper holds one finding more, which tells that the cap
+// was passed.
+func newRun(maxDiags int) *run {
+	r := &run{newer: newKeeper(maxDiags + 1), form: newKeeper(maxDiags + 1)}
+	r.rejected.Store(math.MaxInt64)
+	return r
+}
+
+// reject records that the re-encoding of resource i failed.
+func (r *run) reject(i int) {
+	for {
+		cur := r.rejected.Load()
+		if int64(i) >= cur || r.rejected.CompareAndSwap(cur, int64(i)) {
+			return
+		}
+	}
+}
+
+// fails reports whether the decode is known to fail whatever resource i
+// holds: a finding is known, or a resource before i failed its
+// re-encoding. The checks then keep no tree of resource i (no tree is
+// returned) and do not re-encode it.
+func (r *run) fails(i int) bool {
+	return r.newer.any() || r.form.any() || int64(i) > r.rejected.Load()
+}
+
+// found collects the findings of one resource in content order, at most
+// limit of each code: a finding after the first limit of its resource
+// cannot be among the first limit of the decode. wantForm is false when
+// form findings of the resource cannot matter, so none is built.
+type found struct {
+	newer, form diag.List
+	limit       int
+	wantForm    bool
+}
+
+// reset prepares f for the next resource.
+func (f *found) reset(wantForm bool) {
+	clear(f.newer)
+	clear(f.form)
+	f.newer, f.form, f.wantForm = f.newer[:0], f.form[:0], wantForm
+}
+
+// takeNewer reports whether one more newer finding is kept.
+func (f *found) takeNewer() bool { return len(f.newer) < f.limit }
+
+// takeForm reports whether one more form finding is kept.
+func (f *found) takeForm() bool { return f.wantForm && len(f.form) < f.limit }
diff --git a/internal/config/canonical/keep_test.go b/internal/config/canonical/keep_test.go
new file mode 100644
index 0000000..ed01dc8
--- /dev/null
+++ b/internal/config/canonical/keep_test.go
@@ -0,0 +1,199 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package canonical
+
+import (
+	"context"
+	"math"
+	"math/rand/v2"
+	"strconv"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+)
+
+// TestKeeper: a keeper holds the first n findings in content order
+// whatever order they are offered in, fewer than 2n at any time, reports
+// full once n were offered, and skips the resources after its bound (01
+// req 50; the decode's determinism, 02 req 78).
+func TestKeeper(t *testing.T) {
+	const n, total = 5, 200
+	all := make([]order, 0, total)
+	for i := range total / 4 {
+		// Four findings per resource of the resources member (ordinal 1),
+		// and a few document members before and after it.
+		for j := range 4 {
+			all = append(all, order{member: 1, res: i, seq: j})
+		}
+	}
+	all = append(all, order{member: 0}, order{member: 2}, order{member: 3})
+	for seed := range uint64(20) {
+		r := rand.New(rand.NewPCG(seed, 7)) //nolint:gosec // G404: deterministic test data
+		k := newKeeper(n)
+		k.setResources(1)
+		if k.any() || k.full.Load() || k.after(1<<40) {
+			t.Fatal("fresh keeper is not empty")
+		}
+		perm := r.Perm(len(all))
+		for c, p := range perm {
+			o := all[p]
+			k.add(o, diag.Diagnostic{Message: strconv.Itoa(o.member) + "/" + strconv.Itoa(o.res) + "/" + strconv.Itoa(o.seq)}, nil)
+			if len(k.entries) >= 2*n {
+				t.Fatalf("seed %d: %d entries held", seed, len(k.entries))
+			}
+			if got, want := k.full.Load(), c+1 >= n; got != want {
+				t.Fatalf("seed %d: full = %v after %d offers", seed, got, c+1)
+			}
+		}
+		got := k.list(nil)
+		want := []string{"0/0/0", "1/0/0", "1/0/1", "1/0/2", "1/0/3"}
+		if len(got) != n {
+			t.Fatalf("seed %d: %d kept", seed, len(got))
+		}
+		for i, d := range got {
+			if d.Message != want[i] {
+				t.Errorf("seed %d: kept %d = %s, want %s", seed, i, d.Message, want[i])
+			}
+		}
+		// The bound is resource 0's last finding: resource 1 and later are
+		// after it, resource 0 is not.
+		if !k.any() || k.after(0) || !k.after(1) {
+			t.Errorf("seed %d: after(0) = %v, after(1) = %v", seed, k.after(0), k.after(1))
+		}
+	}
+	// A keeper offered fewer than n keeps them all and sets no bound.
+	k := newKeeper(n)
+	k.setResources(0)
+	k.addResource(3, diag.List{{Message: "b"}, {Message: "c"}}, nil)
+	k.add(order{member: -1}, diag.Diagnostic{Message: "a"}, nil)
+	if got := k.list(nil); len(got) != 3 || got[0].Message != "a" || got[2].Message != "c" || k.full.Load() || k.after(1<<40) {
+		t.Errorf("under the cap: kept %v, full %v", got, k.full.Load())
+	}
+	// A bound outside the resources array skips no resource.
+	k = newKeeper(1)
+	k.setResources(0)
+	k.add(order{member: 1}, diag.Diagnostic{}, nil)
+	if !k.full.Load() || k.after(1<<40) {
+		t.Errorf("bound after the array: full %v, after %v", k.full.Load(), k.after(1<<40))
+	}
+	if newKeeper(0).n != 1 {
+		t.Error("newKeeper(0) keeps no finding")
+	}
+}
+
+// streamOf runs the parse and checks of a decode with one worker and
+// returns its state, and the yield timer of its goroutine, whose site
+// counts tell what the checks did, for the tests of what they skip.
+func streamOf(t *testing.T, maxDiags int, content string) (*run, []*chunk, *yielder) {
+	t.Helper()
+	d := NewDecoder(hubIndex(t), DecoderOptions{Workers: 1, MaxDiagnostics: maxDiags})
+	r := newRun(d.maxDiags)
+	now, after := due()
+	y := newYielder(now, after)
+	_, chunks, _, err := d.stream(context.Background(), newInput([]byte(content), 0, len(content), Source{}), r, y)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r, chunks, y
+}
+
+// TestCheckerSkips: the checks do no work whose result cannot matter
+// (01 req 50): a resource whose findings all come after the newer
+// findings kept is not checked, form findings are not offered once a
+// newer finding is known (before the resource or in it), and the
+// re-encoding is skipped once any finding is known. Each case runs with
+// one worker, so the order of the checks is the content order.
+func TestCheckerSkips(t *testing.T) {
+	newerRoute := func(i int) string {
+		return `{"kind":"Route","metadata":{"name":"r` + num(i) + `"},"spec":{"y":1,"z":1}}`
+	}
+	t.Run("resources after the kept findings", func(t *testing.T) {
+		// Cap 3: the keeper holds 4, which resources 0 and 1 fill; the
+		// rest of the chunk is not checked.
+		r, _, _ := streamOf(t, 3, resources(streamChunk, newerRoute))
+		if r.checked.Load() != 2 {
+			t.Fatalf("%d checked; want resources 0 and 1 checked only", r.checked.Load())
+		}
+		if !r.newer.full.Load() {
+			t.Error("keeper not full")
+		}
+	})
+	t.Run("form findings after a newer document member", func(t *testing.T) {
+		r, _, _ := streamOf(t, 100, `{"aa":1,"format":"ruralz.canonical.v1","resources":[1,true]}`)
+		if !r.newer.any() || r.form.any() {
+			t.Errorf("newer %v, form %v; want no form finding offered", r.newer.any(), r.form.any())
+		}
+	})
+	t.Run("form findings of a resource with a newer finding", func(t *testing.T) {
+		r, _, _ := streamOf(t, 100, doc(`{"apiVersion":"x","kind":"Route","metadata":{"name":"r"},"spec":{},"status":{}}`))
+		if !r.newer.any() || r.form.any() {
+			t.Errorf("newer %v, form %v; want no form finding offered", r.newer.any(), r.form.any())
+		}
+	})
+	// Route/s differs from its re-encoding. An entry is kept, and its
+	// resource re-encoded, only while the decode can still succeed: with
+	// no finding known and no resource before it rejected. The values the
+	// re-encodings wrote (three per Route: metadata, its name and spec)
+	// tell which resources were re-encoded, since a decode known to fail
+	// keeps no entry (sweep).
+	spaced := `{"kind":"Route","metadata":{"name":"s"},"spec": {}}`
+	for _, tc := range []struct {
+		name, first string
+		reencoded   bool
+		values      int
+	}{
+		{"re-encoding without a finding", `{"kind":"Route","metadata":{"name":"r"},"spec":{}}`, true, 6},
+		{"re-encoding after a newer finding", `{"kind":"Route","metadata":{"name":"r"},"spec":{},"status":{}}`, false, 0},
+		{"re-encoding after a form finding", `{"apiVersion":"x","kind":"Route","metadata":{"name":"r"},"spec":{}}`, false, 0},
+		{"re-encoding after a rejected resource", `{"kind":"Route","metadata":{"name":"r"},"spec": {}}`, false, 3},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r, chunks, y := streamOf(t, 100, doc(tc.first, spaced))
+			if r.checked.Load() != 2 {
+				t.Fatalf("%d resources checked, want 2", r.checked.Load())
+			}
+			var s *entry
+			for _, c := range chunks {
+				for i := range c.entries {
+					if e := &c.entries[i]; e.id.Name == "s" {
+						s = e
+					}
+				}
+			}
+			if got := s != nil && s.diff >= 0; got != tc.reencoded {
+				t.Errorf("Route/s kept and re-encoded = %v, want %v", got, tc.reencoded)
+			}
+			if got := y.sites[siteValue]; got != tc.values {
+				t.Errorf("the re-encodings wrote %d values, want %d", got, tc.values)
+			}
+		})
+	}
+}
+
+// TestKeeperCost: the keeper sorts at most f/n+2 times for f offers, for
+// every n up to the largest a decoder can pass and beyond it, where 2n
+// overflows (WP-39 review: n = math.MaxInt/2+2 sorted on every offer,
+// 5.6 s for 20,000 findings); counted sorts, not time.
+func TestKeeperCost(t *testing.T) {
+	const f = 20_000
+	for _, n := range []int{1, 100, maxCount + 1, math.MaxInt/2 + 2, math.MaxInt - 1, math.MaxInt} {
+		k := newKeeper(n)
+		k.setResources(0)
+		// Offered in reverse content order, so a sort is visible.
+		for i := f - 1; i >= 0; i-- {
+			k.add(order{member: 0, res: i}, diag.Diagnostic{}, nil)
+		}
+		offers := k.prunes
+		got := k.list(nil)
+		if limit := f/k.n + 2; k.prunes > limit {
+			t.Errorf("n %d: %d sorts for %d offers, want at most %d", n, k.prunes, f, limit)
+		}
+		if n > f && offers != 0 {
+			t.Errorf("n %d: %d sorts before the list, want none under the cap", n, offers)
+		}
+		if want := min(n, f); len(got) != want {
+			t.Errorf("n %d: kept %d, want %d", n, len(got), want)
+		}
+	}
+}
