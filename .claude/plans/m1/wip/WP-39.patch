+// textSize returns the bytes the text and JSON forms of ds take.
+func textSize(t *testing.T, ds diag.List) (text, js int) {
+	t.Helper()
+	var a, b bytes.Buffer
+	if err := diag.WriteText(&a, ds); err != nil {
+		t.Fatal(err)
+	}
+	if err := diag.WriteJSON(&b, ds); err != nil {
+		t.Fatal(err)
+	}
+	return a.Len(), b.Len()
+}
