+	p := boundPath(diag.Path{diag.Field("spec"), diag.Field(long), diag.Index(2), diag.Keyed("name", long)})
+	if got := p.String(); got != `spec["`+clipped+`"][2][name=`+clipped+`]` {
+		t.Errorf("boundPath = %s", got)
