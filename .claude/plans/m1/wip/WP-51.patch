+// TestRegexpEngine checks the library's regexp engine of one compile: an
+// expression compiles once, its compile shared, and a failure is a nil
+// Regexp with its error every time (07 req 75 and F6: each distinct
+// pattern compiles once per document, review finding B2, architecture
+// R-77). Once frozen (audit class GC-21, rows CC-01 and CC-02), every call
+// fails with errEngineFrozen, for an expression compiled before too,
+// compiling and caching nothing, and calls from 8 goroutines at once write
+// nothing but the atomic count: the engine before the fix wrote its map
+// from every request, and concurrent requests ended the process with a
+// concurrent map write.
+func TestRegexpEngine(t *testing.T) {
+	eng := newRegexpEngine()
+	a, errA := eng.compile(`^a+$`)
+	b, errB := eng.compile(`^a+$`)
+	if errA != nil || errB != nil || a != b || len(eng.cache) != 1 {
+		t.Errorf("compile twice = %v, %v, %v, %v, want one shared regexp", a, errA, b, errB)
+	}
+	for range 2 {
+		if re, err := eng.compile(`(`); re != nil || err == nil || errors.Is(err, errEngineFrozen) {
+			t.Errorf("compile(%q) = %v, %v, want a nil Regexp and the parse error", `(`, re, err)
+		}
+	}
+	if len(eng.cache) != 2 || eng.calls.Load() != 4 || eng.frozen {
+		t.Fatalf("before the freeze: %d cached, %d calls, frozen %v, want 2, 4, false", len(eng.cache), eng.calls.Load(), eng.frozen)
+	}
+	eng.freeze()
+	for _, expr := range []string{`^a+$`, `^b$`, `(`} {
+		if re, err := eng.compile(expr); re != nil || !errors.Is(err, errEngineFrozen) {
+			t.Errorf("frozen compile(%q) = %v, %v, want errEngineFrozen", expr, re, err)
+		}
+	}
+	const goroutines, each = 8, 500
+	var wg sync.WaitGroup
+	for g := range goroutines {
+		wg.Go(func() {
+			for i := range each {
+				if _, err := eng.compile(fmt.Sprintf("g%d-%d", g, i)); !errors.Is(err, errEngineFrozen) {
+					t.Errorf("concurrent frozen compile = %v, want errEngineFrozen", err)
+					return
+				}
+			}
+		})
+	}
+	wg.Wait()
+	if eng.cache != nil || !eng.frozen || eng.calls.Load() != 4+3+goroutines*each {
+		t.Errorf("after the freeze: cache %v, frozen %v, %d calls, want nil, true, %d", eng.cache, eng.frozen, eng.calls.Load(), 4+3+goroutines*each)
+	}
+}
+
+// TestRegexpEngineFrozen covers audit class GC-21 (rows CC-02, CC-03 and
+// CR-24's note): whatever the compile's outcome, the engine it gave the
+// library is frozen when it returns, its cache dropped, so a later call
+// compiles and caches nothing, and the compile used that engine (a
+// pattern, a patternProperties name and the meta-schema's format 'regex'
+// call it).
+func TestRegexpEngineFrozen(t *testing.T) {
+	errStop := errors.New("stop")
+	stopAt := func(n int) func() error {
+		return func() error {
+			if n--; n < 0 {
+				return errStop
+			}
+			return nil
+		}
+	}
+	// The base-mismatch route, which the walk walks since class GC-02, so
+	// its $schema rule refuses the asserting dialect there before the
+	// library compiles or calls the engine (before the fix the library
+	// compiled, and called the engine, before the compile's backstop
+	// refused it).
+	escapedRegex, _ := onRoute(mismatchRoute, assertingVocabulary, "", `{"$id":"urn:w","$schema":"`+baseURL+`","format":"regex","pattern":"^a"}`)
+	fanned := `{"pattern":"^a","anyOf":[` + strings.TrimSuffix(strings.Repeat(`{"oneOf":[`+strings.TrimSuffix(strings.Repeat(`{"minLength":1},`, 32), ",")+`]},`, 33), ",") + `]}`
+	for _, tc := range []struct {
+		name, schema string
+		stop         func() error
+		// compiled: the compile returns a Schema; calls: it called the
+		// engine; err: it returns errStop.
+		compiled, calls, err bool
+	}{
+		{"accepted", `{"pattern":"^a","properties":{"b":{"patternProperties":{"^c":true}}}}`, nil, true, true, false},
+		{"refused by the walk", `{"pattern":"(?=a)"}`, nil, false, false, false},
+		{"refused by the library", `{"$ref":"#/x","x":{"type":5},"pattern":"^a"}`, nil, false, true, false},
+		{"refused when checked apart", `{"$ref":"#/additionalItems","additionalItems":{"pattern":"^a","multipleOf":0}}`, nil, false, true, false},
+		{"refused at an escaped route's $schema", escapedRegex, nil, false, false, false},
+		{"refused by the inspector", fanned, nil, false, true, false},
+		{"refused by the analysis", `{"patternProperties":{"^a":{"$ref":"#"},"b$":{"$ref":"#"}}}`, nil, false, true, false},
+		{"stopped before the library compiles", `{"pattern":"^a"}`, stopAt(0), false, false, true},
+		{"stopped before the analysis", `{"pattern":"^a"}`, stopAt(1), false, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p, issues := prepare([]byte(tc.schema))
+			if len(issues) > 0 {
+				t.Fatal(issues)
+			}
+			eng := newRegexpEngine()
+			s, issues, err := compileWith(p, refusingLoader{}, tc.stop, eng)
+			if (s != nil) != tc.compiled || (len(issues) > 0) == (tc.compiled || tc.err) || errors.Is(err, errStop) != tc.err {
+				t.Fatalf("compile compiled %v with %+v, %v", s != nil, issues, err)
+			}
+			n := eng.calls.Load()
+			if (n > 0) != tc.calls {
+				t.Errorf("compile called the engine %d times, want calls %v", n, tc.calls)
+			}
+			if !eng.frozen || eng.cache != nil {
+				t.Fatalf("after the compile: frozen %v, cache %v, want frozen and no cache", eng.frozen, eng.cache)
+			}
+			if re, err := eng.compile(`^a`); re != nil || !errors.Is(err, errEngineFrozen) || eng.cache != nil || eng.calls.Load() != n+1 {
+				t.Errorf("a later call = %v, %v, cache %v, want errEngineFrozen and nothing cached", re, err, eng.cache)
+			}
+		})
+	}
+}
+
+// engineFilter compiles schema with a regexp engine the test keeps and
+// builds its Filter under testLimit.
+func engineFilter(t *testing.T, schema string) (*Filter, *regexpEngine) {
+	t.Helper()
+	p, issues := prepare([]byte(schema))
+	if len(issues) > 0 {
+		t.Fatal(issues)
+	}
+	eng := newRegexpEngine()
+	s, issues, err := compileWith(p, refusingLoader{}, nil, eng)
+	if s == nil {
+		t.Fatalf("compile(%.80s) = %+v, %v", schema, issues, err)
+	}
+	return newFilter(s, errcode.Status(CodeRejected), limitsOf(testLimit)), eng
+}
+
+// Handle runs from concurrentGoroutines goroutines, concurrentBodies
+// bodies each: 2,000 distinct bodies, the count of library audit CC-02.
+const concurrentGoroutines, concurrentBodies = 8, 250
+
+// handleConcurrently runs body(g, i) through f from concurrentGoroutines
+// goroutines, concurrentBodies bodies each, and reports every result whose
+// outcome or detail is not what want returns.
+func handleConcurrently(t *testing.T, f *Filter, body func(g, i int) string, want func(g, i int) (filter.Outcome, string)) {
+	t.Helper()
+	errs := make(chan string, 16)
+	var wg sync.WaitGroup
+	for g := range concurrentGoroutines {
+		wg.Go(func() {
+			for i := range concurrentBodies {
+				b := body(g, i)
+				x, _ := exchange("application/json", []byte(b))
+				r := f.Handle(context.Background(), phase.OnRequestBody, x)
+				outcome, detail := want(g, i)
+				if r.Outcome != outcome || (detail != "" && (r.Response == nil || r.Response.Detail != detail)) {
+					select {
+					case errs <- fmt.Sprintf("body %s: %+v", b, r):
+					default:
+					}
+				}
+			}
+		})
+	}
+	wg.Wait()
+	close(errs)
+	for e := range errs {
+		t.Error(e)
+	}
+}
+
+// TestHandleNeverCallsEngine covers audit class GC-21 (rows VAL-68 and
+// CC-01; 07 req 91): validation never calls the regexp engine of the
+// compile. Handle runs from 8 goroutines on a Filter whose schema has
+// patterns and patternProperties names at the root, in properties, items,
+// a reference target, an allOf branch and propertyNames, and the engine's
+// call count does not move once the compile has returned (run under -race
+// in CI, beside TestHandleConcurrent).
+func TestHandleNeverCallsEngine(t *testing.T) {
+	const schema = `{"type":"object","propertyNames":{"pattern":"^[a-z0-9-]+$"},` +
+		`"properties":{"name":{"type":"string","pattern":"^[a-z]+$"},"tags":{"type":"array","items":{"type":"string","pattern":"^#"}},"ref":{"$ref":"#/$defs/code"}},` +
+		`"patternProperties":{"^x-":{"type":"string","pattern":"v$"}},"allOf":[{"patternProperties":{"^n[0-9]+$":{"type":"string","minLength":1}}}],` +
+		`"$defs":{"code":{"type":"string","pattern":"^[A-Z]{3}$"}}}`
+	f, eng := engineFilter(t, schema)
+	n := eng.calls.Load()
+	if n == 0 {
+		t.Fatal("the compile never called the engine")
+	}
+	bodies := []struct {
+		body    string
+		outcome filter.Outcome
+	}{
+		{`{"name":"abc","tags":["#a%d"],"ref":"ABC","x-a":"%dv","n%d":"z"}`, filter.Continue},
+		{`{"name":"Abc%d"}`, filter.Respond},
+		{`{"tags":["a%d"]}`, filter.Respond},
+		{`{"ref":"abc%d"}`, filter.Respond},
+		{`{"x-a":"w%d"}`, filter.Respond},
+		{`{"Bad%d":1}`, filter.Respond},
+		{`{"n%d":""}`, filter.Respond},
+	}
+	handleConcurrently(t, f, func(g, i int) string {
+		b := bodies[(g+i)%len(bodies)].body
+		k := strings.Count(b, "%d")
+		args := make([]any, k)
+		for j := range args {
+			args[j] = g*1000 + i
+		}
+		return fmt.Sprintf(b, args...)
+	}, func(g, i int) (filter.Outcome, string) { return bodies[(g+i)%len(bodies)].outcome, "" })
+	if got := eng.calls.Load(); got != n {
+		t.Errorf("validation called the engine %d times, want none", got-n)
+	}
+	if eng.cache != nil {
+		t.Errorf("the engine keeps %d compiles after the compile", len(eng.cache))
+	}
+}
+
+// TestHandleFrozenEngine covers audit class GC-21 (rows CC-01, CC-02,
+// CC-03 and VAL-68): were an asserted format 'regex' to escape the
+// compile's $schema rule and its inspection, the library would call the
+// compile's regexp engine on every body string evaluated there
+// (validator.go:136-142). The test injects the library's own binding of
+// format 'regex' to the engine (objcompiler.go:188-192, which the compile
+// refuses) and runs Handle from 8 goroutines with 2,000 distinct strings,
+// then once with a 180 KB string whose compile as a regexp library audit
+// CC-03 measured at 125 ms and 76 MB: the frozen engine fails every call,
+// so the body is refused at the format keyword (fail closed), nothing is
+// compiled or cached, and under -race no write races; before the fix the
+// engine wrote its map from every request, which ended the process with a
+// concurrent map write and kept every body string compiled.
+func TestHandleFrozenEngine(t *testing.T) {
+	f, eng := engineFilter(t, `{"type":"object","properties":{"a":{"type":"string"}}}`)
+	bind := sjs.NewCompiler()
+	bind.AssertFormat()
+	bind.UseRegexpEngine(eng.compile)
+	if err := bind.AddResource("urn:bind", map[string]any{"format": "regex"}); err != nil {
+		t.Fatal(err)
+	}
+	bound, err := bind.Compile("urn:bind")
+	if err != nil || bound.Format == nil {
+		t.Fatalf("binding = %v, %v", bound, err)
+	}
+	f.schema.root.Properties["a"].Format = bound.Format
+	n := eng.calls.Load()
+	handleConcurrently(t, f, func(g, i int) string { return fmt.Sprintf(`{"a":"g%d-%d"}`, g, i) },
+		func(int, int) (filter.Outcome, string) {
+			return filter.Respond, DetailMismatch + " at /properties/a/format"
+		})
+	if got := eng.calls.Load() - n; got < concurrentGoroutines*concurrentBodies {
+		t.Errorf("the injected format called the engine %d times, want one call at least per body", got)
+	}
+	big := `{"a":"` + strings.Repeat(`(a|b)*`, 30000) + `"}`
+	if detail := detailOf(t, handle(t, f, big)); detail != DetailMismatch+" at /properties/a/format" {
+		t.Errorf("180 KB string: detail %q", detail)
+	}
+	if eng.cache != nil {
+		t.Errorf("the frozen engine cached %d request strings", len(eng.cache))
+	}
+}
diff --git a/internal/filter/validation/jsonschema/compiled.go b/internal/filter/validation/jsonschema/compiled.go
new file mode 100644
index 0000000..23c1c6f
--- /dev/null
+++ b/internal/filter/validation/jsonschema/compiled.go
@@ -0,0 +1,268 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package jsonschema
+
+import (
+	"reflect"
+	"slices"
+	"strings"
+
+	sjs "github.com/santhosh-tekuri/jsonschema/v6"
+)
+
+// The compiled set (audit class GC-21, rows CC-01 to CC-04). The library
+// compiles schemas that no exported field of a compiled schema leads to:
+// with every schema, the root of the resource it belongs to, and with
+// every resource root, eagerly, the schema of each $dynamicAnchor the
+// resource holds (compiler.go:216-236). Validation reaches those anchor
+// schemas through the dynamic scope alone, wherever a $dynamicRef's first
+// target bears the same $dynamicAnchor (validator.go:781-813). The library
+// also reads a $schema at every position it collects, the keyword tree of
+// the document and of every position it compiles, and gives the resource
+// there and the resources inside it that have none the dialect it names
+// (roots.go:70-191, 193-235): a dialect with the format-assertion
+// vocabulary asserts format, and one without the validation or applicator
+// vocabulary drops those keywords. On a route the rule walk did not walk,
+// a $recursiveRef target before class GC-01 made the walk follow it, or a
+// reference the library based on a resource the walk did not before class
+// GC-02 made the walk model the library's collection (walker), the walk's
+// $schema rule never ran, and the inspection from the walked positions
+// never met the anchor schemas: a request body had format asserted on it,
+// or the schema's own type and properties ignored (library audit CC-01 and
+// CC-04). The compile therefore lists every schema the library compiled,
+// applies the walk's $schema rule to the keyword tree of each position the
+// walk did not walk, inspects every compiled schema, the anchor schemas
+// included, and then refuses any compiled schema at a position the walk
+// did not walk live (unwalked), before the evaluation analysis
+// (compileWalked). The walk now walks live every position the library
+// compiles, so the $schema rule and the refusal are backstops, which fire
+// only if the walk's model and the library part (TestCheckCollected,
+// TestUnwalkedBackstop).
+
+// msgDialect is the finding of the $schema rule (07 req 75), at the walk
+// and at the compile alike.
+const msgDialect = "$schema must be " + Draft
+
+// msgUnlisted is the finding when the compile cannot list the schemas the
+// library compiled: it then checks none of them and refuses the document
+// (fail closed).
+const msgUnlisted = "the compile cannot list the schemas the library compiled, so it checks none of them (an internal error)"
+
+// msgUnwalked is the finding of the walked-position backstop (unwalked).
+const msgUnwalked = "the library compiles this schema position on a route the compile's rule walk does not follow, so the walk's rules never applied to it (move the schema a reference names here under $defs)"
+
+// badDialect reports whether the schema object obj has a $schema that is
+// not exactly Draft (07 req 75).
+func badDialect(obj map[string]any) bool {
+	v, ok := obj["$schema"]
+	if !ok {
+		return false
+	}
+	s, isStr := v.(string)
+	return !isStr || s != Draft
+}
+
+// compiledSchema is one schema the library compiled from the document: its
+// pointer, and the address of its compiled form, by which the compile
+// tells it from the schemas the inspection already reached.
+type compiledSchema struct {
+	ptr  string
+	addr uintptr
+}
+
+// compiledSchemas lists every schema c has compiled from the document, in
+// pointer order; ok is false when c's table of compiled schemas cannot be
+// read.
+//
+// The library exports no list of what it compiled, so this reads the
+// compiler's table, the unexported field schemas (a map from location to
+// *Schema, compiler.go:11 and :210-212), through reflect, without unsafe
+// and without writing: only each entry's address and its exported Location
+// are read. The module is pinned at v6.0.3 (go.mod); TestCompiledSchemas
+// pins the table's shape and content, so a library change that moves it
+// fails there, and the compile fails closed (msgUnlisted) rather than
+// check fewer schemas. Schemas of other URLs, the decision and check
+// wrappers and any bundled meta-schema a reference reached, are left out:
+// a reference to a meta-schema is refused at its member by the inspection
+// of the compiled schema that holds it.
+func compiledSchemas(c *sjs.Compiler) ([]compiledSchema, bool) {
+	return compiledIn(reflect.ValueOf(c).Elem())
+}
+
+// compiledIn reads the table of compiled schemas of the compiler value c,
+// as compiledSchemas does.
+func compiledIn(c reflect.Value) ([]compiledSchema, bool) {
+	if c.Kind() != reflect.Struct {
+		return nil, false
+	}
+	m := c.FieldByName("schemas")
+	if m.Kind() != reflect.Map || m.Type().Elem() != reflect.TypeFor[*sjs.Schema]() {
+		return nil, false
+	}
+	out := make([]compiledSchema, 0, m.Len())
+	for it := m.MapRange(); it.Next(); {
+		s := it.Value()
+		if s.IsNil() {
+			return nil, false
+		}
+		if ptr, ok := pointerOf(s.Elem().FieldByName("Location").String()); ok {
+			out = append(out, compiledSchema{ptr: ptr, addr: s.Pointer()})
+		}
+	}
+	// Non-canonical indexes (/allOf/00 beside /allOf/0) compare equal as
+	// pointers; their bytes order them.
+	slices.SortFunc(out, func(a, b compiledSchema) int {
+		if d := comparePointers(a.ptr, b.ptr); d != 0 {
+			return d
+		}
+		return strings.Compare(a.ptr, b.ptr)
+	})
+	return out, true
+}
+
+// checkCollected applies the walk's $schema rule (walker.collect) to every
+// schema position the library collected from a compiled position the walk
+// did not collect: the position and its keyword tree, the positions whose
+// $schema the library reads (roots.go:70-191). A position the walk
+// collected had its keyword tree checked by the walk, and so had the
+// document's own keyword tree, which the library collects first. The walk
+// collects every position the library does, so this is a backstop. The
+// findings come in pointer order, at most MaxIssues of them, and are the
+// walk's own. Each object of the document is walked once, and a pointer is
+// built only for a finding.
+func (w *walker) checkCollected(compiled []compiledSchema) []Issue {
+	var out []Issue
+	done := map[uintptr]bool{}
+	// segs holds the relative pointers from the start down to the object
+	// being walked.
+	var segs []string
+	var walk func(v any, start string)
+	walk = func(v any, start string) {
+		obj, ok := v.(map[string]any)
+		if !ok {
+			return
+		}
+		id := reflect.ValueOf(obj).Pointer()
+		if done[id] {
+			return
+		}
+		done[id] = true
+		if badDialect(obj) {
+			p := start + strings.Join(segs, "")
+			out = append(out, Issue{Pointer: appendToken(p, "$schema"), Message: msgDialect})
+		}
+		eachSubschema(obj, "", func(sv any, at string) {
+			segs = append(segs, at)
+			walk(sv, start)
+			segs = segs[:len(segs)-1]
+		})
+	}
+	for _, cs := range compiled {
+		if w.seen[cs.ptr] != 0 {
+			continue
+		}
+		if v, ok := lookup(w.doc, cs.ptr); ok {
+			walk(v, cs.ptr)
+		}
+	}
+	slices.SortFunc(out, func(a, b Issue) int { return comparePointers(a.Pointer, b.Pointer) })
+	return out[:min(len(out), MaxIssues)]
+}
+
+// unwalked refuses every schema of compiled at a position the walk did
+// not walk live, the class backstop of library audit classes GC-01 and
+// GC-02: the walk's rules (patterns, number bounds, the lists of names,
+// MaxSubschemas, the meta-schema check bounds) and the compile's own
+// meta-schema check of what no check of the library covers
+// (uncheckedPositions) hold only at the positions the walk walks live, so
+// a schema the library compiled anywhere else escaped them all, and the
+// compiled Schema would keep it and validate with it (a multipleOf of 0
+// there panicked at every number, an unbounded literal was parsed at
+// every comparison). The walk walks live every position the library
+// compiles (walker), so this never fires but if the two part. The findings
+// come in pointer order, at the top-most such positions only, at most
+// MaxIssues of them.
+func (w *walker) unwalked(compiled []compiledSchema) []Issue {
+	var out []Issue
+	for _, cs := range compiled {
+		if w.seen[cs.ptr] == walkedLive {
+			continue
+		}
+		below := slices.ContainsFunc(out, func(is Issue) bool { return strings.HasPrefix(cs.ptr, is.Pointer+"/") })
+		if below {
+			continue
+		}
+		if len(out) == MaxIssues {
+			break
+		}
+		out = append(out, Issue{Pointer: cs.ptr, Message: msgUnwalked})
+	}
+	return out
+}
+
+// visitCompiled inspects every schema of compiled that the inspection has
+// not reached from the walked positions, in pointer order, and returns
+// them, the starts the evaluation analysis adds: the library's own Compile
+// returns each from its table, compiling nothing (compiler.go:153-157,
+// 190-214). ok is false when one is not the schema the table holds, so the
+// list did not come from the table.
+func (in *inspector) visitCompiled(c *sjs.Compiler, compiled []compiledSchema) (extra []*sjs.Schema, ok bool) {
+	known := make(map[uintptr]bool, len(in.schemas))
+	mark := func(from int) int {
+		for _, s := range in.schemas[from:] {
+			known[reflect.ValueOf(s).Pointer()] = true
+		}
+		return len(in.schemas)
+	}
+	n := mark(0)
+	for _, cs := range compiled {
+		if known[cs.addr] {
+			continue
+		}
+		s, err := c.Compile(baseURL + "#" + encodeFragment(cs.ptr))
+		if err != nil || reflect.ValueOf(s).Pointer() != cs.addr {
+			return nil, false
+		}
+		in.visit(s, "")
+		n = mark(n)
+		extra = append(extra, s)
+	}
+	return extra, true
+}
+
+// inspectCompiled checks what the library compiled from the document:
+// compiled lists it (listed is false when the listing failed, and the
+// document is refused), starts are the root and the walked positions. It
+// applies the walk's $schema rule where the library read a $schema the
+// walk did not (checkCollected), and only then, as the walk's findings
+// would end the compile first, inspects every compiled schema: the starts,
+// what they reach, and the rest of compiled (visitCompiled), whose fan-out
+// it bounds; last it refuses every compiled schema at a position the walk
+// did not walk live (unwalked), so the analysis never meets one. It
+// returns the inspection and the starts of the evaluation analysis, every
+// compiled schema the starts do not reach appended.
+func inspectCompiled(c *sjs.Compiler, w *walker, starts []*sjs.Schema, compiled []compiledSchema, listed bool) (*inspector, []*sjs.Schema, []Issue) {
+	if !listed {
+		return nil, nil, []Issue{{Message: msgUnlisted}}
+	}
+	if issues := w.checkCollected(compiled); len(issues) > 0 {
+		return nil, nil, issues
+	}
+	in := newInspector()
+	for _, s := range starts {
+		in.visit(s, "")
+	}
+	extra, ok := in.visitCompiled(c, compiled)
+	if !ok {
+		return nil, nil, []Issue{{Message: msgUnlisted}}
+	}
+	in.fanOut()
+	if len(in.issues) > 0 {
+		return nil, nil, in.issues
+	}
+	if issues := w.unwalked(compiled); len(issues) > 0 {
+		return nil, nil, issues
+	}
+	return in, append(starts, extra...), nil
+}
diff --git a/internal/filter/validation/jsonschema/compiled_test.go b/internal/filter/validation/jsonschema/compiled_test.go
new file mode 100644
index 0000000..7cf9918
--- /dev/null
+++ b/internal/filter/validation/jsonschema/compiled_test.go
@@ -0,0 +1,272 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package jsonschema
+
+import (
+	"fmt"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	sjs "github.com/santhosh-tekuri/jsonschema/v6"
+)
+
+// libraryCompiler adds schema as the document and compiles its root, and
+// first a check wrapper whose allOf names checked, as compileWalked does.
+func libraryCompiler(t *testing.T, schema string, checked ...string) *sjs.Compiler {
+	t.Helper()
+	p, issues := prepare([]byte(schema))
+	if len(issues) > 0 {
+		t.Fatal(issues)
+	}
+	c := sjs.NewCompiler()
+	c.DefaultDraft(sjs.Draft2020)
+	c.UseLoader(refusingLoader{})
+	if err := c.AddResource(baseURL, p.doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(checked) > 0 {
+		refs := make([]any, len(checked))
+		for i, ptr := range checked {
+			refs[i] = map[string]any{"$ref": baseURL + "#" + encodeFragment(ptr)}
+		}
+		if err := c.AddResource(checkURL, map[string]any{"allOf": refs}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := c.Compile(checkURL); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := c.Compile(baseURL); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// TestCompiledSchemas pins the listing of what the library compiled
+// (compiledSchemas, audit class GC-21, rows CC-01 and CC-04): every schema
+// of the document the library compiled, the schema of a resource's
+// $dynamicAnchor that no edge reaches included, in pointer order, a
+// non-canonical index after its canonical twin, each with the address of
+// the schema the library's Compile returns for it; the check wrapper's
+// schemas and a bundled meta-schema a reference reached are left out, and
+// a position nothing compiled is absent. A library change that moves the
+// table fails here.
+func TestCompiledSchemas(t *testing.T) {
+	const schema = `{"$ref":"#/$defs/a","allOf":[{"$ref":"#/allOf/00"}],"not":{"$ref":"https://json-schema.org/draft/2020-12/meta/core"},` +
+		`"$defs":{"a":{"$id":"urn:a","$defs":{"d":{"$dynamicAnchor":"n","type":"string"},"e":{"type":"null"}},"properties":{"p":{"$ref":"#/$defs/e"}}},` +
+		`"b":{"type":"null"},"u":{"type":"null"}}}`
+	c := libraryCompiler(t, schema, "/$defs/b")
+	want := []string{"", "/$defs/a", "/$defs/a/$defs/d", "/$defs/a/$defs/e", "/$defs/a/properties/p", "/$defs/b", "/allOf/0", "/allOf/00", "/not"}
+	// The table is a map: each listing reads it in another order, and
+	// every one must come out the same.
+	for range 20 {
+		got, ok := compiledSchemas(c)
+		if !ok {
+			t.Fatal("compiledSchemas() failed")
+		}
+		var ptrs []string
+		for _, cs := range got {
+			ptrs = append(ptrs, cs.ptr)
+			s, err := c.Compile(baseURL + "#" + encodeFragment(cs.ptr))
+			if err != nil || reflect.ValueOf(s).Pointer() != cs.addr {
+				t.Errorf("Compile(%q) = %v, %v, not the listed schema", cs.ptr, s, err)
+			}
+		}
+		if !slices.Equal(ptrs, want) {
+			t.Fatalf("compiled = %q, want %q", ptrs, want)
+		}
+	}
+	// The anchor schema is compiled, but no edge leads to it.
+	root, _ := c.Compile(baseURL)
+	in := newInspector()
+	in.visit(root, "")
+	for _, n := range in.nodes {
+		if n.ptr == "/$defs/a/$defs/d" {
+			t.Error("the root reaches the anchor schema; the shape no longer shows the listing's need")
+		}
+	}
+}
+
+// TestCompiledInRefuses covers the fail-closed listing (audit class GC-21):
+// a compiler value whose table is not a map from location to *Schema, or
+// holds a nil schema, is not listed, and a well-formed one is.
+func TestCompiledInRefuses(t *testing.T) {
+	s := &sjs.Schema{Location: baseURL + "#/q"}
+	for _, tc := range []struct {
+		name string
+		v    reflect.Value
+		want []string
+	}{
+		{"not a struct", reflect.ValueOf(5), nil},
+		{"no table", reflect.ValueOf(struct{ other int }{}), nil},
+		{"table not a map", reflect.ValueOf(struct{ schemas []int }{}), nil},
+		{"table of other values", reflect.ValueOf(struct{ schemas map[string]int }{}), nil},
+		{"nil schema", reflect.ValueOf(struct{ schemas map[string]*sjs.Schema }{map[string]*sjs.Schema{"a": nil}}), nil},
+		{"well formed", reflect.ValueOf(struct{ schemas map[string]*sjs.Schema }{map[string]*sjs.Schema{
+			"a": s, "b": {Location: checkURL + "#"}, "c": {Location: baseURL + "#"},
+		}}), []string{"", "/q"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, ok := compiledIn(tc.v)
