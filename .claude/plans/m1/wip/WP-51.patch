+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package jsonschema
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"regexp"
+	"regexp/syntax"
+	"runtime"
+	"runtime/debug"
+	"slices"
