+						if tc.key != "" {
+							i := slices.IndexFunc(n.Members, func(m tree.Member) bool { return m.Key == tc.key })
+							n.Members[i].Value = nil
+						} else {
+							n.Items[tc.index] = nil
+						}
+						return res
+					}
+					files := table()
+					h, ds := s.Resource(build(), files)
+					if h != nil || !slices.ContainsFunc(texts(ds), func(d string) bool { return strings.HasSuffix(d, tc.want) }) {
+						t.Errorf("Resource = %v, %q; want a diagnostic ending %q", h != nil, texts(ds), tc.want)
+					}
+					if b, rds, err := s.Run(t.Context(), []*tree.Resource{build(), build()}, files, 2); b != nil || err != nil || len(rds) != 2*len(ds) {
+						t.Errorf("Run = %v, %q, %v; want the diagnostics of both", b != nil, texts(rds), err)
+					}
+				})
+			}
+		}
+	}
+}
+
+// TestNilNodesEverywhere sets every member value and list element of the
+// example Bundle's resources to nil in turn: stage G never panics, with or
+// without a lifecycle table, and reports the null, but for the
+// conversion-data annotation, which the conversion strips (02 req 7).
+func TestNilNodesEverywhere(t *testing.T) {
+	lifecycle, err := convert.NewRegistry(convert.Lifecycle{
+		APIVersions: map[string]convert.Notice{v1: {Removal: "0.9.0"}},
+		Fields:      map[string]map[string]convert.Notice{v1: {"spec.upstreams[].weight": {Removal: "0.8.0"}, "spec.config.limits[].burst": {Removal: "0.8.0"}}},
+	}, convert.V1alpha1())
+	if err != nil {
+		t.Fatal(err)
+	}
+	stages := []*Stage{newStage(t), stageWith(t, Options{Converters: lifecycle})}
+	_, rs := loadBundle(t)
+	positions := 0
+	for _, r := range rs {
+		var walk func(n *tree.Node, path []int)
+		walk = func(n *tree.Node, path []int) {
+			count := len(n.Members) + len(n.Items)
+			for i := range count {
+				child := append(slices.Clone(path), i)
+				for _, s := range stages {
+					res := &tree.Resource{ID: r.ID, APIVersion: r.APIVersion, Start: r.Start, Root: r.Root.Clone()}
+					parent := res.Root
+					for _, j := range path {
+						parent = childAt(parent, j)
+					}
+					stripped := false
+					if i < len(parent.Members) {
+						stripped = parent.Members[i].Key == convert.ConversionDataAnnotation
+						parent.Members[i].Value = nil
+					} else {
+						parent.Items[i-len(parent.Members)] = nil
+					}
+					func() {
+						defer func() {
+							if p := recover(); p != nil {
+								t.Fatalf("%s/%s position %v: panic %v", r.ID.Kind, r.ID.Name, child, p)
+							}
+						}()
+						h, ds := s.Resource(res, nil)
+						null := slices.ContainsFunc(ds, func(d diag.Diagnostic) bool { return strings.HasPrefix(d.Message, "null is not allowed") })
+						if stripped == (h == nil) || stripped == null {
+							t.Errorf("%s/%s position %v: %v, %q; want the null reported", r.ID.Kind, r.ID.Name, child, h != nil, texts(ds))
+						}
+					}()
+				}
+				positions++
+				if c := childAt(n, i); c != nil {
+					walk(c, child)
+				}
+			}
+		}
+		walk(r.Root, nil)
+	}
+	if positions < 100 {
+		t.Errorf("%d positions, want the whole Bundle", positions)
+	}
+}
+
+// childAt returns member value i of n, or element i-len(Members).
+func childAt(n *tree.Node, i int) *tree.Node {
+	if i < len(n.Members) {
+		return n.Members[i].Value
+	}
+	return n.Items[i-len(n.Members)]
+}
+
+// TestNilNodeLookups covers the lookups that a nil node reaches outside
+// Normalize: Decode with a nil index decodes nothing (as Normalize), and
+// the exported Decode of a tree with a nil member value decodes it as
+// null, in the kind struct and in a config split into pieces; a
+// converter's diagnostic is located through a nil member value and next
+// to a nil apiVersion member.
+func TestNilNodeLookups(t *testing.T) {
+	res := envelope(mustParse(t, route(`{"match": {}, "timeout": "1s"}`)))
+	if obj, cfg, ds := Decode(nil, registry.New(), res, nil); obj != nil || cfg != nil || ds != nil {
+		t.Errorf("Decode(nil index) = %v %v %q", obj, cfg, texts(ds))
+	}
+	spec, _ := res.Root.Get("spec")
+	spec.Members[1].Value = nil
+	if obj, _, ds := Decode(hubIndex(t), registry.New(), res, nil); obj == nil || len(ds) != 0 {
+		t.Errorf("Decode with a nil member = %v, %q; want the object", obj, texts(ds))
+	}
+	cfg := envelope(mustParse(t, pluginDoc(`{"a": [1, 2, 3, 4, 5, 6, 7, 8], "b": {"c": 1, "d": 2, "e": 3}}`)))
+	at(t, cfg.Root, "spec.config.a").Items[3] = nil
+	at(t, cfg.Root, "spec.config.b").Members[1].Value = nil
+	w := newWork()
+	w.chunk = 2
+	if obj, c, ds, failed := decode(hubIndex(t), registry.New(), cfg, nil, w, nil); obj == nil || c == nil || failed || len(ds) != 0 {
+		t.Errorf("decode in pieces with nil nodes = %v %v %q %v", obj, c, texts(ds), failed)
+	}
+	// own: a path through a nil member value, and the fallback beside a
+	// nil apiVersion member.
+	f := newFixture()
+	conv := f.resource(t, "r.json", route(`{"match": {}, "timeout": "1s"}`))
+	cs, _ := conv.Root.Get("spec")
+	cs.Members[1].Value = nil
+	conv.Root.Members[0].Value = nil
+	got := newStage(t).own(conv, f.files, diag.List{
+		{Path: diag.Path{diag.Field("spec"), diag.Field("timeout"), diag.Field("x")}},
+		{Path: diag.Path{diag.Field("spec"), diag.Field("timeout")}},
+	}, newWork())
+	if got[0].Location != (diag.Location{File: "r.json", Line: int(conv.Start.Line), Column: int(conv.Start.Column)}) {
+		t.Errorf("fallback beside a nil apiVersion = %+v, want the resource start", got[0].Location)
+	}
+	if want := (diag.Location{File: "r.json", Line: int(cs.Pos.Line), Column: int(cs.Pos.Column)}); got[1].Location != want {
+		t.Errorf("path to a nil member = %+v, want its parent's %+v", got[1].Location, want)
+	}
+}
diff --git a/internal/config/defaults/keep.go b/internal/config/defaults/keep.go
new file mode 100644
index 0000000..83db31a
--- /dev/null
+++ b/internal/config/defaults/keep.go
@@ -0,0 +1,200 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package defaults
+
+import (
+	"bytes"
+	"cmp"
+	"encoding/json"
+	"slices"
+	"strings"
+	"sync"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+)
+
+// keeper collects the diagnostics of one Run from its workers and keeps
+// the first n of them in diag.List.Sort order (01 req 50), ties broken by
+// resource index and then by the order within the resource, so the kept
+// set and its order do not depend on the worker count or on which worker
+// finished first. Its memory stays below 2n diagnostics: once it holds
+// 2n, it sorts and keeps n, and from then on drops at once every
+// diagnostic that does not sort before the last one kept. The threshold
+// is tested as len(entries)-n ≥ n, which cannot overflow for any n, so
+// prunes stay at most one per n entries added however large n is. It is
+// safe for concurrent use.
+type keeper struct {
+	mu sync.Mutex
+	n  int
+	// entries holds the candidates; after a prune, the first n in order.
+	entries []entry
+	// bound is the last entry kept by a prune; hasBound is false before
+	// the first one that dropped anything.
+	bound    entry
+	hasBound bool
+	// prunes counts the prunes add made, for tests.
+	prunes int
+}
+
+// entry is one candidate diagnostic with its place in the Run input.
+type entry struct {
+	d diag.Diagnostic
+	// res is the index of the resource in the Run input, seq the index
+	// of the diagnostic in that resource's list.
+	res, seq int
+}
+
+// newKeeper returns a keeper of the first n diagnostics (n ≥ 1).
+func newKeeper(n int) *keeper { return &keeper{n: max(1, n)} }
+
+// compareEntries orders by the key of diag.List.Sort (environment, file,
+// line, column, code, path, message), then by resource index and order
+// within the resource, which no two entries share. The paths are
+// compared only when everything before them ties, and then by
+// comparePaths, which never renders a whole path: a path repeats every
+// ancestor's member name and key, so rendering one per diagnostic would
+// hold the cap times an authored key's length.
+func compareEntries(a, b entry) int {
+	if c := cmp.Or(
+		cmp.Compare(a.d.Environment, b.d.Environment),
+		cmp.Compare(a.d.File, b.d.File),
+		cmp.Compare(a.d.Line, b.d.Line),
+		cmp.Compare(a.d.Column, b.d.Column),
+		cmp.Compare(a.d.Code, b.d.Code),
+	); c != 0 {
+		return c
+	}
+	return cmp.Or(
+		comparePaths(a.d.Path, b.d.Path),
+		cmp.Compare(a.d.Message, b.d.Message),
+		cmp.Compare(a.res, b.res),
+		cmp.Compare(a.seq, b.seq),
+	)
+}
+
+// comparePaths orders a and b as strings.Compare orders their texts
+// (diag.Path.String), without building them: the leading elements both
+// paths share (equal kind and value at the same position) give equal
+// text and are skipped, and the rest is rendered one element at a time,
+// as far as the first differing byte. Its memory is the text of the
+// elements it renders, not of the paths.
+func comparePaths(a, b diag.Path) int {
+	i := 0
+	for i < len(a) && i < len(b) && sameElem(a[i], b[i]) {
+		i++
+	}
+	var ra, rb []byte
+	ia, ib := i, i
+	for {
+		for len(ra) == 0 && ia < len(a) {
+			ra = appendElemText(ra[:0], ia, a[ia])
+			ia++
+		}
+		for len(rb) == 0 && ib < len(b) {
+			rb = appendElemText(rb[:0], ib, b[ib])
+			ib++
+		}
+		if len(ra) == 0 || len(rb) == 0 {
+			return cmp.Compare(len(ra), len(rb))
+		}
+		k := min(len(ra), len(rb))
+		if c := bytes.Compare(ra[:k], rb[:k]); c != 0 {
+			return c
+		}
+		ra, rb = ra[k:], rb[k:]
+	}
+}
+
+// sameElem reports path elements whose text is equal at any one position
+// of a path: the same kind and value. An item of a type other than those
+// of diag.Item's documentation is never the same, so its text decides.
+func sameElem(x, y diag.PathElem) bool {
+	if x.Kind != y.Kind {
+		return false
+	}
+	switch x.Kind {
+	case diag.ElemField:
+		return x.Name == y.Name
+	case diag.ElemIndex:
+		return x.Index == y.Index
+	case diag.ElemKeyed:
+		return x.KeyField == y.KeyField && x.Key == y.Key
+	case diag.ElemItem:
+		switch v := x.Item.(type) {
+		case string:
+			w, ok := y.Item.(string)
+			return ok && v == w
+		case bool:
+			w, ok := y.Item.(bool)
+			return ok && v == w
+		case json.Number:
+			w, ok := y.Item.(json.Number)
+			return ok && v == w
+		case json.RawMessage:
+			w, ok := y.Item.(json.RawMessage)
+			return ok && bytes.Equal(v, w)
+		default:
+			return false
+		}
+	default:
+		return false
+	}
+}
+
+// appendElemText appends the text element e has at position i of a
+// path's diag.Path.String form: its own text, after a "." when it is a
+// member name written bare (not bracketed) after the first position.
+func appendElemText(dst []byte, i int, e diag.PathElem) []byte {
+	t := diag.Path{e}.String()
+	if i > 0 && e.Kind == diag.ElemField && !strings.HasPrefix(t, "[") {
+		dst = append(dst, '.')
+	}
+	return append(dst, t...)
+}
+
+// add offers the diagnostics of resource res.
+func (k *keeper) add(res int, ds diag.List) {
+	if len(ds) == 0 {
+		return
+	}
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	for j := range ds {
+		e := entry{d: ds[j], res: res, seq: j}
+		if k.hasBound && compareEntries(e, k.bound) >= 0 {
+			continue
+		}
+		k.entries = append(k.entries, e)
+		if len(k.entries)-k.n >= k.n {
+			k.prunes++
+			k.prune()
+		}
+	}
+}
+
+// prune sorts the entries and keeps the first n.
+func (k *keeper) prune() {
+	slices.SortFunc(k.entries, compareEntries)
+	if len(k.entries) <= k.n {
+		return
+	}
+	clear(k.entries[k.n:])
+	k.entries = k.entries[:k.n]
+	k.bound, k.hasBound = k.entries[k.n-1], true
+}
+
+// list returns the kept diagnostics in order.
+func (k *keeper) list() diag.List {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	k.prune()
+	if len(k.entries) == 0 {
+		return nil
+	}
+	out := make(diag.List, len(k.entries))
+	for i, e := range k.entries {
+		out[i] = e.d
+	}
+	return out
+}
diff --git a/internal/config/defaults/keep_test.go b/internal/config/defaults/keep_test.go
new file mode 100644
index 0000000..7326d05
--- /dev/null
+++ b/internal/config/defaults/keep_test.go
@@ -0,0 +1,154 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package defaults
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/rand/v2"
+	"runtime"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// TestComparePaths checks comparePaths against strings.Compare of the
+// paths' texts (diag.Path.String), the order diag.List.Sort gives, on
+// every pair of a corpus of paths: bare and bracketed member names (a
+// "." only before a bare one after the first position), indexes, keyed
+// entries with bare and quoted keys, set items of every diag.Item type
+// and of other types, shared prefixes, one path the prefix of another,
+// and texts that tie across element boundaries ("a.b" as one name or as
+// two).
+func TestComparePaths(t *testing.T) {
+	elems := []diag.PathElem{
+		diag.Field("a"), diag.Field("b"), diag.Field("a.b"), diag.Field(""), diag.Field("$x"), diag.Field("é"),
+		diag.Field("a-b"), diag.Field("1a"), diag.Field("[x"), diag.Field("<&>"), diag.Field("a\"b"),
+		diag.Index(0), diag.Index(2), diag.Index(10),
+		diag.Keyed("name", "x"), diag.Keyed("name", "x y"), diag.Keyed("n", ""), diag.Keyed("name", "x]"),
+		diag.Item("GET"), diag.Item("a b"), diag.Item(json.Number("1")), diag.Item(json.Number("1.0")), diag.Item(true),
+		diag.Item(false), diag.Item(json.RawMessage(`{"a":1}`)), diag.Item(json.RawMessage(`[1]`)), diag.Item(3), diag.Item([]int{1}),
+		{Kind: diag.ElemKind(9)},
+	}
+	r := rand.New(rand.NewPCG(3, 7)) //nolint:gosec // G404: a seeded corpus makes the property reproducible.
+	paths := []diag.Path{nil, {diag.Field("a"), diag.Field("b")}, {diag.Field("a.b")}, {diag.Field("a")}}
+	for range 150 {
+		p := make(diag.Path, r.IntN(5))
+		for i := range p {
+			p[i] = elems[r.IntN(len(elems))]
+		}
+		paths = append(paths, p)
+		// A twin sharing a prefix, so the skip of equal elements runs.
+		q := slices.Clone(p)
+		if len(q) > 0 {
+			q[r.IntN(len(q))] = elems[r.IntN(len(elems))]
+		}
+		paths = append(paths, q, append(slices.Clone(p), elems[r.IntN(len(elems))]))
+	}
+	texts := make([]string, len(paths))
+	for i, p := range paths {
+		texts[i] = p.String()
+	}
+	for i, a := range paths {
+		for j, b := range paths {
+			want := strings.Compare(texts[i], texts[j])
+			if got := comparePaths(a, b); got != want {
+				t.Fatalf("comparePaths(%s, %s) = %d, want %d", a, b, got, want)
+			}
+		}
+	}
+}
+
+// TestKeeperTiedLongPaths covers the keeper's path comparison (WP-37
+// review round 3): diagnostics that tie on everything before the path
+// come back in diag.List.Sort order, with paths that share a long
+// authored key and differ after it, and the keeper never renders those
+// paths whole, so its allocations stay far below their combined text.
+func TestKeeperTiedLongPaths(t *testing.T) {
+	key := strings.Repeat("k", 20_000)
+	var ds diag.List
+	for i := range 600 {
+		ds = append(ds, diag.Diagnostic{
+			Code: CodeSchema, Severity: diag.SeverityError, Location: diag.Location{File: "a.json", Line: 1, Column: 1},
+			Path:    diag.Path{diag.Field("spec"), diag.Field("l"), diag.Keyed("name", key), diag.Field("m" + string(rune('a'+i%26)))},
+			Message: "tie",
+		})
+	}
+	want := slices.Clone(ds)
+	want.Sort()
+	k := newKeeper(200)
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	k.add(0, ds)
+	got := k.list()
+	runtime.ReadMemStats(&after)
+	for i := range got {
+		if got[i].Path[3].Name != want[i].Path[3].Name {
+			t.Fatalf("keeper diagnostic %d = %s, want %s", i, got[i].Path[3].Name, want[i].Path[3].Name)
+		}
+	}
+	if len(got) != 200 {
+		t.Fatalf("keeper kept %d, want 200", len(got))
+	}
+	if alloc, text := after.TotalAlloc-before.TotalAlloc, uint64(len(ds)*len(key)); alloc > text/20 {
+		t.Errorf("keeper allocated %d bytes for paths of %d bytes of text, want under a twentieth", alloc, text)
+	}
+}
+
+// longKeyCases build resources that pass stage F and give stage G 10,001
+// RZ-CFG-005 diagnostics below one long authored key or member name
+// (WP-37 review round 3): an auth.jwt issuer whose issuer key is long,
+// and an auth.api-key config member with a long name.
+func longKeyCases() map[string]func(key string) string {
+	nulls := func(n int) string {
+		var b strings.Builder
+		for i := range n {
+			b.WriteString(`, "z` + fmt.Sprintf("%07d", i) + `": null`)
+		}
+		return b.String()
+	}
+	return map[string]func(key string) string{
+		"jwt issuer key": func(key string) string {
+			return policyDoc("auth.jwt", `{"issuers": [{"issuer": "`+key+`", "jwksUrl": "https://x.example/j", "audiences": ["a"]`+nulls(DefaultMaxDiagnostics+1)+`}]}`)
+		},
+		"api-key member name": func(key string) string {
+			return policyDoc("auth.api-key", `{"header": "x-a", "`+key+`": {"k": 1`+nulls(DefaultMaxDiagnostics+1)+`}}`)
+		},
+	}
+}
+
+// TestRunLongKeyMemory checks Run's memory on longKeyCases (WP-37 review
+// round 3: the keeper rendered every diagnostic's path, 1 GB for a 280 KB
+// source): the 10,001 diagnostics below a 100,000-byte key allocate at
+// most sixteen copies of the key more than below a 9-byte one, where
+// rendering each path took one copy per diagnostic: the paths share the
+// key, and nothing renders them.
+func TestRunLongKeyMemory(t *testing.T) {
+	s := newStage(t)
+	for name, build := range longKeyCases() {
+		t.Run(name, func(t *testing.T) {
+			alloc := func(key string) (uint64, int) {
+				res := envelope(mustParse(t, build(key)))
+				var before, after runtime.MemStats
+				runtime.ReadMemStats(&before)
+				b, ds, err := s.Run(t.Context(), []*tree.Resource{res}, nil, 1)
+				runtime.ReadMemStats(&after)
+				if b != nil || err != nil || len(ds) != DefaultMaxDiagnostics+1 {
+					t.Fatalf("Run = %v, %d diagnostics, %v; want no Bundle and %d", b, len(ds), err, DefaultMaxDiagnostics+1)
+				}
+				return after.TotalAlloc - before.TotalAlloc, len(build(key))
+			}
+			alloc("short-key") // warm the schema caches
+			short, _ := alloc("short-key")
+			long, src := alloc(strings.Repeat("i", 100_000))
+			t.Logf("short key %d bytes, long key %d bytes allocated; source %d bytes", short, long, src)
+			if extra := int64(long) - int64(short); extra > 16*100_000 { //nolint:gosec // G115: byte counts are far below 2^63.
+				t.Errorf("a 100,000-byte key added %d bytes allocated, want at most sixteen copies of it (%d); source %d bytes", extra, 16*100_000, src)
+			}
+		})
+	}
+}
diff --git a/internal/config/defaults/limits_test.go b/internal/config/defaults/limits_test.go
new file mode 100644
index 0000000..6dba141
--- /dev/null
+++ b/internal/config/defaults/limits_test.go
@@ -0,0 +1,221 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package defaults
+
+import (
+	"errors"
+	"math"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/convert"
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// pluginDoc returns a plugin Policy with config, whose members get no
+// schema checks and no defaults.
+func pluginDoc(config string) string {
+	return `{"apiVersion": "ruralz/v1alpha1", "kind": "Policy", "metadata": {"name": "p"}, "spec": {"type": "plugin", "plugin": "pl", "config": ` + config + `}}`
+}
+
+// TestHugeCaps covers Options.MaxDiagnostics at the top of the int range
+// (01 req 50; WP-37 review round 3: the cap plus one wrapped at
+// math.MaxInt, so every diagnostic was dropped while the resource still
+// failed, and twice the keeper's size wrapped from 2^62 up, so it sorted
+// all its entries after every diagnostic). Every non-negative cap is
+// valid, and each of these keeps both errors of a resource, through
+// Resource and through Run with one and with two workers.
+func TestHugeCaps(t *testing.T) {
+	src := pluginDoc(`{"a": null, "b": null}`)
+	for _, cap := range []int{math.MaxInt, math.MaxInt - 1, math.MaxInt / 2, 1 << 62, 1<<62 - 1} {
+		t.Run(strconv.Itoa(cap), func(t *testing.T) {
+			s := stageWith(t, Options{MaxDiagnostics: cap})
+			if h, ds := s.Resource(envelope(mustParse(t, src)), nil); h != nil || len(ds) != 2 {
+				t.Errorf("Resource = %v, %q; want both errors", h != nil, texts(ds))
+			}
+			for _, workers := range []int{1, 2} {
+				rs := []*tree.Resource{envelope(mustParse(t, src)), envelope(mustParse(t, src))}
+				if b, ds, err := s.Run(t.Context(), rs, nil, workers); b != nil || err != nil || len(ds) != 4 {
+					t.Errorf("Run with %d workers = %v, %d diagnostics, %v; want the 4 errors", workers, b != nil, len(ds), err)
+				}
+			}
+		})
+	}
+	if got := keepOf(math.MaxInt); got != math.MaxInt {
+		t.Errorf("keepOf(math.MaxInt) = %d, want math.MaxInt", got)
+	}
+	if got := keepOf(0); got != 1 {
+		t.Errorf("keepOf(0) = %d, want 1", got)
+	}
+}
+
+// TestKeeperPrunes covers the keeper's memory bound without overflow (01
+// req 50; WP-37 review round 3: with n of 2^62 or more, 2n wrapped to a
+// negative number and every add sorted all entries): it prunes at most
+// once per n entries added, plus one, for every n, and keeps the first n
+// in order.
+func TestKeeperPrunes(t *testing.T) {
+	const adds = 600
+	ds := make(diag.List, adds)
+	for i := range ds {
+		// In reverse order, so a prune would reorder them.
+		ds[i] = diag.Diagnostic{Code: CodeSchema, Location: diag.Location{Line: adds - i}}
+	}
+	for _, n := range []int{1, 7, adds / 2, adds, math.MaxInt / 2, 1 << 62, math.MaxInt - 1, math.MaxInt} {
+		t.Run(strconv.Itoa(n), func(t *testing.T) {
+			k := newKeeper(n)
+			for i, d := range ds {
+				k.add(i, diag.List{d})
+			}
+			if limit := adds/n + 1; k.prunes > limit {
+				t.Errorf("%d prunes for %d adds, want at most %d", k.prunes, adds, limit)
+			}
+			got := k.list()
+			if want := min(n, adds); len(got) != want {
+				t.Fatalf("kept %d, want %d", len(got), want)
+			}
+			for i := range got {
+				if got[i].Line != i+1 {
+					t.Fatalf("kept[%d] at line %d, want %d", i, got[i].Line, i+1)
+				}
+			}
+		})
+	}
+}
+
+// panicky is a converter of the hub apiVersion whose ToHub panics on a
+// resource named boom, with value, or calls runtime.Goexit there when
+// goexit is set, and counts its calls and the calls in flight; on a
+// resource named wait it returns once release is closed.
+type panicky struct {
+	value         any
+	goexit        bool
+	calls, active *atomic.Int64
+	release       chan struct{}
+}
+
+func (panicky) APIVersion() string { return v1 }
+
+func (c panicky) ToHub(_ string, doc *tree.Node, _ bool) (*tree.Node, diag.List) {
+	c.calls.Add(1)
+	c.active.Add(1)
+	defer c.active.Add(-1)
+	meta, _ := doc.Get("metadata")
+	name, _ := meta.Get("name")
+	switch {
+	case name == nil:
+	case name.Text == "boom" && c.goexit:
+		runtime.Goexit()
+	case name.Text == "boom":
+		panic(c.value)
+	case name.Text == "wait":
+		<-c.release
+	}
+	return doc, nil
+}
+
+func (panicky) FromHub(_ string, doc *tree.Node, _ bool) (*tree.Node, diag.List) { return doc, nil }
+
+// TestRunPanic covers a panic inside stage G during Run (WP-37 review
+// round 3: Run's workers did not recover, so a panicking converter ended
+// the process whatever the caller deferred): for one and for four
+// workers, the panic of a Converter reaches the caller's recover in the
+// calling goroutine, as an error that names the resource and wraps an
+// error value, after every started resource has returned (no ToHub call
+// is in flight), and no resource is started after it: one worker stops at
+// the panicking resource, and of two, the other finishes the resource it
+// has (wait, held until the panic stopped the dispatch) and takes no
+// other. A converter that calls runtime.Goexit is handled the same way
+// (WP-37 review round 5: the worker's goroutine ended with nothing to
+// recover, so Run returned a Bundle without that resource and every one
+// the worker had not reached, with no error and no diagnostic): Run
+// raises an error that wraps errGoexit, for every worker count.
+func TestRunPanic(t *testing.T) {
+	sentinel := errors.New("converter bug")
+	for _, tc := range []struct {
+		name    string
+		value   any
+		workers int
+		// wraps reports a value that is the sentinel error.
+		wraps bool
+		// goexit makes the converter call runtime.Goexit.
+		goexit bool
+	}{
+		{"string, one worker", "boom", 1, false, false},
+		{"string, two workers", "boom", 2, false, false},
+		{"string, four workers", "boom", 4, false, false},
+		{"error, four workers", sentinel, 4, true, false},
+		{"Goexit, one worker", errGoexit, 1, false, true},
+		{"Goexit, two workers", errGoexit, 2, false, true},
+		{"Goexit, four workers", errGoexit, 4, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var calls, active atomic.Int64
+			release := make(chan struct{})
+			conv, err := convert.NewRegistry(convert.Lifecycle{}, panicky{value: tc.value, goexit: tc.goexit, calls: &calls, active: &active, release: release})
+			if err != nil {
+				t.Fatal(err)
+			}
+			s := stageWith(t, Options{Converters: conv})
+			boom := 5
+			if tc.workers == 2 {
+				boom = 0
+			}
+			stops := 0
+			s.stopped = func(i int) {
+				stops++
+				if i != boom {
+					t.Errorf("stopped at resource %d, want %d", i, boom)
+				}
+				close(release)
+			}
+			var rs []*tree.Resource
+			for i := range 12 {
+				name := "r" + strconv.Itoa(i)
+				switch {
+				case i == boom:
+					name = "boom"
+				case tc.workers == 2 && i == 1:
+					name = "wait"
+				}
+				rs = append(rs, envelope(mustParse(t, strings.Replace(route(`{"match": {}}`), `"name": "r"`, `"name": "`+name+`"`, 1))))
+			}
+			got := func() (v any) {
+				defer func() { v = recover() }()
+				_, _, _ = s.Run(t.Context(), rs, nil, tc.workers)
+				return nil
+			}()
+			if got == nil {
+				t.Fatal("Run returned; want the converter's panic in the caller")
+			}
+			if n := active.Load(); n != 0 {
+				t.Errorf("%d ToHub calls still in flight after Run panicked", n)
+			}
+			if n := calls.Load(); (tc.workers == 1 && n != 6) || (tc.workers == 2 && n > 2) {
+				t.Errorf("%d resources converted by %d workers: dispatch goes on after the panic", n, tc.workers)
+			}
+			if stops != 1 {
+				t.Errorf("stop hook called %d times, want once", stops)
+			}
+			p, ok := got.(*resourcePanic)
+			if !ok {
+				t.Fatalf("recovered %T %v, want a *resourcePanic", got, got)
+			}
+			verb := map[bool]string{false: "panicked", true: "stopped"}[tc.goexit]
+			if p.index != boom || p.value != tc.value || p.goexit != tc.goexit || !strings.Contains(p.Error(), verb+" on resource "+strconv.Itoa(boom)) || !strings.Contains(p.Error(), "panicky.ToHub") {
+				t.Errorf("panic = index %d, value %v, goexit %v, text %.300q", p.index, p.value, p.goexit, p.Error())
+			}
+			if errors.Is(p, sentinel) != tc.wraps {
+				t.Errorf("errors.Is(panic, sentinel) = %v, want %v", !tc.wraps, tc.wraps)
+			}
+			if errors.Is(p, errGoexit) != tc.goexit {
+				t.Errorf("errors.Is(panic, errGoexit) = %v, want %v", !tc.goexit, tc.goexit)
+			}
+		})
+	}
+}
diff --git a/internal/config/defaults/lookup.go b/internal/config/defaults/lookup.go
new file mode 100644
index 0000000..9816fa0
--- /dev/null
+++ b/internal/config/defaults/lookup.go
@@ -0,0 +1,433 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package defaults
+
+import (
+	"bytes"
+	"encoding/json"
+	"maps"
+	"slices"
+	"strconv"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/schemaidx"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// The lookups of stage G whose cost grows with the value they look at go
+// through the methods of this file, which count what each scans as work
+// units: tree.Node.Get scans an object's members, schemaidx.Node.Select
+// evaluates dispatch rules that look members up, schemaidx.ItemElem looks
+// up a keyed entry's key member or encodes a set element,
+// schemaidx.AppendItemJSON encodes a value, and the finder indexes the
+// containers a path steps into (tree.Node.At). A stage that called one of
+// them once per member of a large object would be quadratic in its size;
+// counted here, that shows in work.total, which TestScaleLinear and
+// TestScaleLinearErrors compare across sizes, and TestLookupsCounted
+// keeps every use of the package (calls, method and function values, by
+// the type selected from) on these methods. Each method takes a nil w, as
+// the test helpers pass.
+
+// get returns member key of object n, as tree.Node.Get does, counting n's
+// members and, for each member whose name is as long as key, the bytes of
+// key, which a string comparison of equal lengths may read.
+func (w *work) get(n *tree.Node, key string) (*tree.Node, bool) {
+	if n == nil || n.Kind != tree.KindMap {
+		return nil, false
+	}
+	units := len(n.Members)
+	for i := range n.Members {
+		if len(n.Members[i].Key) == len(key) {
+			units += len(key)
+		}
+	}
+	w.charge(units)
+	return n.Get(key)
+}
+
+// selectSchema returns s with the dispatch rules for instance n applied,
+// as schemaidx.Node.Select does, counting n's members, which the rules
+// look up. A nil member value is a null to the rules (nullMembers).
+func (w *work) selectSchema(s *schemaidx.Node, n *tree.Node) *schemaidx.Node {
+	if n != nil {
+		w.charge(len(n.Members))
+	}
+	return s.Select(nullMembers(n))
+}
+
+// itemElem returns the key-aware path element of element i of a list
+// whose schema is list, as schemaidx.ItemElem does, counting the item's
+// members (a keyed entry's key lookup) and the bytes of a set element's
+// canonical JSON. A nil key member is a null, which names no entry
+// (nullMembers).
+func (w *work) itemElem(list *schemaidx.Node, item *tree.Node, i int) diag.PathElem {
+	e := schemaidx.ItemElem(list, nullMembers(item), i)
+	if item != nil {
+		w.charge(len(item.Members))
+	}
+	if raw, ok := e.Item.(json.RawMessage); ok {
+		w.charge(len(raw))
+	}
+	return e
+}
+
+// nullMembers returns n, or, when a member value of object n is nil, a
+// shallow copy of n in which each such value is a null node: the
+// dispatch rules of schemaidx.Node.Select and the key lookup of
+// schemaidx.ItemElem read member values and take a nil one for a node.
+// Its scan of the members is part of what the callers count.
+func nullMembers(n *tree.Node) *tree.Node {
+	if n == nil || n.Kind != tree.KindMap {
+		return n
+	}
+	var out *tree.Node
+	for i, m := range n.Members {
+		if m.Value != nil {
+			continue
+		}
+		if out == nil {
+			c := *n
+			c.Members = slices.Clone(n.Members)
+			out = &c
+		}
+		out.Members[i].Value = &tree.Node{Kind: tree.KindNull, Pos: m.KeyPos}
+	}
+	if out == nil {
+		return n
+	}
+	return out
+}
+
+// itemJSON returns the RFC 8785 encoding of n, as
+// schemaidx.AppendItemJSON(nil, n) does, counting the bytes written,
+// which bound the nodes encoded.
+func (w *work) itemJSON(n *tree.Node) []byte {
+	b := schemaidx.AppendItemJSON(nil, n)
+	w.charge(len(b))
+	return b
+}
+
+// finder resolves the paths of many diagnostics below one root, as
+// tree.Node.At does for one (own: the diagnostics a converter returned),
+// at a cost linear in the tree and the paths together. A step into an
+// object of more than smallObject members, a keyed list (per key member)
+// or a set looks the element up in an index of that container, built on
+// first use and counted then; a later step into the same container costs
+// one map lookup, however many diagnostics name its entries. Resolving
+// each path from the root instead would scan the container again per
+// diagnostic: quadratic for one diagnostic per entry of a large list.
+//
+// A step finds what tree.Node.At finds: the first member of the name,
+// the first entry whose key member's text is the key, the element at an
+// index, or the first element equal to an item. The object and list
+// items of a set are matched by their RFC 8785 text (schemaidx.
+// AppendItemJSON), which is exact for every tree whose objects have
+// unique member names, as the profile parses them (TestFinderMatchesAt,
+// FuzzFinder).
+type finder struct {
+	w      *work
+	fields map[*tree.Node]map[string]*tree.Node
+	keyed  map[keyedList]map[string]*tree.Node
+	items  map[*tree.Node]*itemIndex
+}
+
+// keyedList names the index of a keyed list by one key member.
+type keyedList struct {
+	list     *tree.Node
+	keyField string
+}
+
+// itemIndex finds the first element of a list equal to a diag.Item value.
+type itemIndex struct {
+	// scalars reports that the maps below were built.
+	scalars bool
+	// strs maps a string element's text to its first index; numText a
+	// number element's text, numVal the value of one whose text parses.
+	strs    map[string]int
+	numText map[string]int
+	numVal  map[float64]int
+	// bools holds one plus the index of the first false and true
+	// element; null one plus the index of the first null; 0 for none.
+	bools [2]int
+	null  int
+	// values maps the RFC 8785 text of each object and list element to
+	// the index of the first; nil until an object or list item is looked
+	// up.
+	values map[string]int
+}
+
+// newFinder returns a finder counting on w.
+func (w *work) newFinder() *finder { return &finder{w: w} }
+
+// at returns the position of the node path names below n or, when that
+// node has no position, of the nearest positioned node on the way; ok is
+// false for an empty path, a path that names no node, and one with no
+// positioned node. A nil node on the way (a null member value or
+// element) has no position, and nothing below it.
+func (f *finder) at(n *tree.Node, path diag.Path) (tree.Pos, bool) {
+	var pos tree.Pos
+	cur := n
+	for _, e := range path {
+		next, ok := f.step(cur, e)
+		if !ok {
+			return tree.Pos{}, false
+		}
+		cur = next
+		if cur != nil && cur.Pos.Known() {
+			pos = cur.Pos
+		}
+	}
+	return pos, pos.Known()
+}
+
+// step resolves one path element below n as tree.Node.At does.
+func (f *finder) step(n *tree.Node, e diag.PathElem) (*tree.Node, bool) {
+	f.w.tick()
+	switch e.Kind {
+	case diag.ElemField:
+		return f.field(n, e.Name)
+	case diag.ElemKeyed:
+		if n == nil || n.Kind != tree.KindList {
+			return nil, false
+		}
+		k := keyedList{list: n, keyField: e.KeyField}
+		idx, ok := f.keyed[k]
+		if !ok {
+			idx = make(map[string]*tree.Node, len(n.Items))
+			for _, it := range n.Items {
+				if key, ok := f.w.get(it, e.KeyField); ok && key != nil {
+					f.w.charge(len(key.Text))
+					if _, dup := idx[key.Text]; !dup {
+						idx[key.Text] = it
+					}
+				}
+			}
+			if f.keyed == nil {
+				f.keyed = map[keyedList]map[string]*tree.Node{}
+			}
+			f.keyed[k] = idx
+		}
+		f.w.charge(len(e.Key))
+		it, ok := idx[e.Key]
+		return it, ok
+	case diag.ElemItem:
+		if n == nil || n.Kind != tree.KindList {
+			return nil, false
+		}
+		i, ok := f.item(n, e.Item)
+		if !ok {
+			return nil, false
+		}
+		return n.Items[i], true
+	default:
+		next, ok := n.At(diag.Path{e})
+		return next, ok
+	}
+}
+
+// field returns member name of n, through an index of n's members when
+// it has more than smallObject; building the index counts the members and
+// the bytes of their names, and each lookup the bytes of name, which the
+// map hashes.
+func (f *finder) field(n *tree.Node, name string) (*tree.Node, bool) {
+	if n == nil || n.Kind != tree.KindMap || len(n.Members) <= smallObject {
+		return f.w.get(n, name)
+	}
+	idx, ok := f.fields[n]
+	if !ok {
+		f.w.charge(len(n.Members))
+		idx = make(map[string]*tree.Node, len(n.Members))
+		for _, m := range n.Members {
+			f.w.charge(len(m.Key))
+			if _, dup := idx[m.Key]; !dup {
+				idx[m.Key] = m.Value
+			}
+		}
+		if f.fields == nil {
+			f.fields = map[*tree.Node]map[string]*tree.Node{}
+		}
+		f.fields[n] = idx
+	}
+	f.w.charge(len(name))
+	v, ok := idx[name]
+	return v, ok
+}
+
+// item returns the index of the first element of list n equal to v, a
+// diag.Item value, as tree.Node.At compares them.
+func (f *finder) item(n *tree.Node, v any) (int, bool) {
+	x := f.items[n]
+	if x == nil {
+		x = &itemIndex{}
+		if f.items == nil {
+			f.items = map[*tree.Node]*itemIndex{}
+		}
+		f.items[n] = x
+	}
+	if raw, ok := v.(json.RawMessage); ok {
+		return f.value(n, x, raw)
+	}
+	f.scalars(n, x)
+	f.w.charge(scalarBytes(v))
+	return x.scalar(v)
+}
+
+// scalarBytes returns the bytes of the text of a diag.Item scalar, which
+// a lookup of it in the scalar maps hashes and parses.
+func scalarBytes(v any) int {
+	switch t := v.(type) {
+	case string:
+		return len(t)
+	case json.Number:
+		return len(t)
+	default:
+		return 0
+	}
+}
+
+// scalars builds the scalar maps of x, the index of list n, counting the
+// elements and the bytes of their texts, which the maps hash and the
+// number parse reads.
+func (f *finder) scalars(n *tree.Node, x *itemIndex) {
+	if x.scalars {
+		return
+	}
+	x.scalars = true
+	f.w.charge(len(n.Items))
+	x.strs, x.numText, x.numVal = map[string]int{}, map[string]int{}, map[float64]int{}
+	for i, it := range n.Items {
+		if it == nil {
+			continue
+		}
+		f.w.charge(len(it.Text))
+		switch it.Kind {
+		case tree.KindString:
+			if _, dup := x.strs[it.Text]; !dup {
+				x.strs[it.Text] = i
+			}
+		case tree.KindInt, tree.KindFloat:
+			if _, dup := x.numText[it.Text]; !dup {
+				x.numText[it.Text] = i
+			}
+			if fv, err := strconv.ParseFloat(it.Text, 64); err == nil {
+				if _, dup := x.numVal[fv]; !dup {
+					x.numVal[fv] = i
+				}
+			}
+		case tree.KindBool:
+			b := 0
+			if it.Bool {
+				b = 1
+			}
+			if x.bools[b] == 0 {
+				x.bools[b] = i + 1
+			}
+		case tree.KindNull:
+			if x.null == 0 {
+				x.null = i + 1
+			}
+		default:
+		}
+	}
+}
+
+// scalar returns the index of the first element equal to v, a string,
+// json.Number or bool, as tree.Node.At compares them: a number by its
+// text or, when both texts parse, by its float64 value.
+func (x *itemIndex) scalar(v any) (int, bool) {
+	switch t := v.(type) {
+	case string:
+		i, ok := x.strs[t]
+		return i, ok
+	case bool:
+		b := 0
+		if t {
+			b = 1
+		}
+		return x.bools[b] - 1, x.bools[b] > 0
+	case json.Number:
+		i, ok := x.numText[string(t)]
+		if fv, err := strconv.ParseFloat(string(t), 64); err == nil {
+			if j, found := x.numVal[fv]; found && (!ok || j < i) {
+				i, ok = j, true
+			}
+		}
+		return i, ok
+	default:
+		return 0, false
+	}
+}
+
+// value returns the index of the first element of list n equal to the
+// JSON value raw, which tree.Node.At decodes with encoding/json
+// (UseNumber) and compares by value: a scalar through the scalar maps, a
+// null by the first null, and an object or a list by its RFC 8785 text,
+// which two values share exactly when that comparison finds them equal
+// (strings byte for byte, numbers by their text or double, objects by
+// their member names and values), given unique member names. w counts
+// raw's bytes and, on the first such lookup in n, the bytes of every
+// element's text.
+func (f *finder) value(n *tree.Node, x *itemIndex, raw json.RawMessage) (int, bool) {
+	f.w.charge(len(raw))
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	var v any
+	if d.Decode(&v) != nil {
+		return 0, false
+	}
+	switch v.(type) {
+	case nil:
+		f.scalars(n, x)
+		return x.null - 1, x.null > 0
+	case string, bool, json.Number:
+		f.scalars(n, x)
+		return x.scalar(v)
+	default:
+	}
+	if x.values == nil {
+		x.values = map[string]int{}
+		for i, it := range n.Items {
+			if it != nil && (it.Kind == tree.KindMap || it.Kind == tree.KindList) {
+				if k := string(f.w.itemJSON(it)); !hasKey(x.values, k) {
+					x.values[k] = i
+				}
+			}
+		}
+	}
+	i, ok := x.values[string(f.w.itemJSON(valueNode(v)))]
+	return i, ok
+}
+
+// hasKey reports whether m holds k.
+func hasKey(m map[string]int, k string) bool {
+	_, ok := m[k]
+	return ok
+}
+
+// valueNode returns the tree of v, a value encoding/json decoded with
+// UseNumber, for its RFC 8785 text.
+func valueNode(v any) *tree.Node {
+	switch t := v.(type) {
+	case string:
+		return &tree.Node{Kind: tree.KindString, Text: t}
+	case bool:
+		return &tree.Node{Kind: tree.KindBool, Bool: t}
+	case json.Number:
+		return &tree.Node{Kind: tree.KindFloat, Text: string(t)}
+	case []any:
+		n := &tree.Node{Kind: tree.KindList, Items: make([]*tree.Node, len(t))}
+		for i, e := range t {
+			n.Items[i] = valueNode(e)
+		}
+		return n
+	case map[string]any:
+		n := &tree.Node{Kind: tree.KindMap, Members: make([]tree.Member, 0, len(t))}
+		for _, k := range slices.Sorted(maps.Keys(t)) {
+			n.Members = append(n.Members, tree.Member{Key: k, Value: valueNode(t[k])})
+		}
+		return n
+	default:
+		return &tree.Node{Kind: tree.KindNull}
+	}
+}
