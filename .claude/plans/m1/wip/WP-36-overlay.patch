+// value is a scalar, at any depth of the objects both hold. It keeps what
+// the merge reads as a directive rather than a value (01 req 25): a
+// $patch member, any member whose value holds the ruralz.io/patch key at
+// any depth (so the walk never reaches the annotation takeAction reads at
+// metadata.annotations, nor the metadata or annotations holding it), and
+// the root spec of a document carrying the annotation, whose spec then
+// replaces the base spec, removals and all; and it keeps the
+// JSONSchemaDocument positions of the base view and of merged, the merged
+// root, whose overlay value is data. It reports whether it deleted a
+// member.
+func dropRemovals(x *schemaidx.Index, kind string, base, merged, ov *tree.Node) bool {
+	md, _ := ov.Get("metadata")
+	ann, _ := md.Get("annotations")
+	_, annotated := ann.Get(PatchAnnotation)
+	dropped := false
+	var walk func(b, o *tree.Node, path diag.Path)
+	walk = func(b, o *tree.Node, path diag.Path) {
+		kept := o.Members[:0]
+		for _, om := range o.Members {
+			p := path.Append(diag.Field(om.Key))
+			bv, ok := b.Get(om.Key)
+			switch {
+			case !ok || om.Key == PatchKey || holdsKey(om.Value, PatchAnnotation) ||
+				(len(path) == 0 && om.Key == "spec" && annotated) ||
+				documentAt(x, kind, base, p) || documentAt(x, kind, merged, p):
+			case nullTree(om.Value) && !composite(bv):
+				dropped = true
+				continue
+			case om.Value.Kind == tree.KindMap && bv.Kind == tree.KindMap:
+				walk(bv, om.Value, p)
+			default:
+			}
+			kept = append(kept, om)
+		}
+		o.Members = kept
+	}
+	walk(base, ov, nil)
+	return dropped
+}
+
+// nullTree reports an object with members, each null or a null tree, and
+// none of them, at any depth, a $patch member, which the merge reads as a
+// misplaced directive (RZ-CFG-005), not as a removal.
+func nullTree(n *tree.Node) bool {
+	if n.Kind != tree.KindMap || len(n.Members) == 0 {
+		return false
+	}
+	for _, m := range n.Members {
+		if m.Key == PatchKey || (m.Value.Kind != tree.KindNull && !nullTree(m.Value)) {
+			return false
+		}
+	}
+	return true
+}
+
+// holdsKey reports a member keyed key at any depth of n.
+func holdsKey(n *tree.Node, key string) bool {
+	for _, m := range n.Members {
+		if m.Key == key || holdsKey(m.Value, key) {
+			return true
+		}
+	}
+	for _, it := range n.Items {
+		if holdsKey(it, key) {
+			return true
+		}
+	}
+	return false
+}
+
+// documentAt reports a JSONSchemaDocument position at path p of root.
+func documentAt(x *schemaidx.Index, kind string, root *tree.Node, p diag.Path) bool {
+	info, ok := x.Lookup(kind, root, p)
+	return ok && info.Node.Def() == schemaDocumentDef
+}
+
 // strayPatch returns the path of a $patch member of r outside the value of
 // the JSONSchemaDocument definition, found with schemaidx.Walk rather
 // than with the checkBase it verifies.
diff --git a/internal/config/overlay/keyed_test.go b/internal/config/overlay/keyed_test.go
new file mode 100644
index 0000000..3989aa2
--- /dev/null
+++ b/internal/config/overlay/keyed_test.go
@@ -0,0 +1,163 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package overlay
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// TestKeyedIndex covers the keyed-list lookups of 01 req 25 in both of
+// their forms (review finding: they were linear scans per overlay entry):
+// a short list is scanned, so is a long list an overlay list of at most
+// linearScan entries merges into (at most linearScan scans), and a long
+// list merged with a longer overlay list is indexed, and all give the
+// same result. $patch: delete removes every base entry
+// with the key (a base list may repeat one; stage F reports it), a merge
+// goes to the first, entries without a usable key never match, and a
+// list that grows past linearScan by appends is indexed with its base
+// entries still found.
+func TestKeyedIndex(t *testing.T) {
+	listener := func(name, port string) string {
+		return `{"name":` + name + `,"protocol":"http","port":` + port + `}`
+	}
+	gw := func(ls ...string) string {
+		return `{"apiVersion":"ruralz/v1alpha1","kind":"Gateway","metadata":{"name":"edge"},"spec":{"listeners":[` + strings.Join(ls, ",") + `]}}`
+	}
+	filler := func(n int) []string {
+		var out []string
+		for i := range n {
+			out = append(out, listener(`"f`+strconv.Itoa(i)+`"`, "1"))
+		}
+		return out
+	}
+	// noops are deletes of absent keys, which change nothing and make the
+	// overlay list long.
+	noops := func(n int) []string {
+		var out []string
+		for i := range n {
+			out = append(out, `{"name":"absent`+strconv.Itoa(i)+`","$patch":"delete"}`)
+		}
+		return out
+	}
+	for _, size := range []struct {
+		name         string
+		extra, noops int
+	}{{"scanned", 0, 0}, {"long list scanned for a short overlay", linearScan + 1, 0}, {"indexed", linearScan + 1, linearScan + 1}} {
+		pad := filler(size.extra)
+		cases := []struct {
+			name      string
+			base, ovr []string
+			want      []string
+		}{
+			{
+				"delete removes every entry with the key",
+				append([]string{listener(`"a"`, "1"), listener(`"b"`, "2"), listener(`"a"`, "3")}, pad...),
+				[]string{`{"name":"a","$patch":"delete"}`},
+				append([]string{listener(`"b"`, "2")}, pad...),
+			},
+			{
+				"a merge goes to the first entry with the key",
+				append([]string{listener(`"a"`, "1"), listener(`"a"`, "3")}, pad...),
+				[]string{`{"name":"a","port":9}`},
+				append([]string{listener(`"a"`, "9"), listener(`"a"`, "3")}, pad...),
+			},
+			{
+				"entries without a usable key never match",
+				append([]string{`{"protocol":"http","port":1}`, listener(`true`, "2"), listener(`"x"`, "3")}, pad...),
+				[]string{`{"name":"x","$patch":"delete"}`, `{"name":"y","port":4}`},
+				append(append([]string{`{"protocol":"http","port":1}`, listener(`true`, "2")}, pad...), `{"name":"y","port":4}`),
+			},
+			{
+				"numbers and strings are different keys",
+				append([]string{listener(`1`, "1"), listener(`"1"`, "2")}, pad...),
+				[]string{`{"name":1,"$patch":"delete"}`},
+				append([]string{listener(`"1"`, "2")}, pad...),
+			},
+		}
+		for _, tc := range cases {
+			t.Run(size.name+" "+tc.name, func(t *testing.T) {
+				out, ds, _ := run(t, []file{{"ruralz.yaml", gw(tc.base...)}}, []file{{"o.yaml", gw(append(noops(size.noops), tc.ovr...)...)}})
+				if len(ds) != 0 {
+					t.Fatalf("diagnostics %q", texts(ds))
+				}
+				if g, w := dump(at(t, out[0].Root, "spec.listeners")), compact(t, "["+strings.Join(tc.want, ",")+"]"); g != w {
+					t.Errorf("listeners =\n%s\nwant\n%s", g, w)
+				}
+			})
+		}
+	}
+	t.Run("a list grown past linearScan still finds its base entries", func(t *testing.T) {
+		base := []string{listener(`"a"`, "1"), listener(`"b"`, "2")}
+		var ovr, want []string
+		for i := range 2 * linearScan {
+			ovr = append(ovr, `{"name":"n`+strconv.Itoa(i)+`","port":5}`)
+		}
+		ovr = append(ovr, `{"name":"b","port":7}`, `{"name":"a","$patch":"delete"}`)
+		want = []string{listener(`"b"`, "7")}
+		for i := range 2 * linearScan {
+			want = append(want, `{"name":"n`+strconv.Itoa(i)+`","port":5}`)
+		}
+		out, ds, _ := run(t, []file{{"ruralz.yaml", gw(base...)}}, []file{{"o.yaml", gw(ovr...)}})
+		if len(ds) != 0 {
+			t.Fatalf("diagnostics %q", texts(ds))
+		}
+		if g, w := dump(at(t, out[0].Root, "spec.listeners")), compact(t, "["+strings.Join(want, ",")+"]"); g != w {
+			t.Errorf("listeners =\n%s\nwant\n%s", g, w)
+		}
+	})
+	t.Run("a list indexed after a delete skips the removed entry", func(t *testing.T) {
+		base := []string{listener(`"a"`, "1"), listener(`"b"`, "2")}
+		ovr := []string{`{"name":"a","$patch":"delete"}`}
+		want := []string{listener(`"b"`, "7")}
+		for i := range 2 * linearScan {
+			ovr = append(ovr, `{"name":"n`+strconv.Itoa(i)+`","port":5}`)
+			want = append(want, `{"name":"n`+strconv.Itoa(i)+`","port":5}`)
+		}
+		ovr = append(ovr, `{"name":"b","port":7}`)
+		out, ds, _ := run(t, []file{{"ruralz.yaml", gw(base...)}}, []file{{"o.yaml", gw(ovr...)}})
+		if len(ds) != 0 {
+			t.Fatalf("diagnostics %q", texts(ds))
+		}
+		if g, w := dump(at(t, out[0].Root, "spec.listeners")), compact(t, "["+strings.Join(want, ",")+"]"); g != w {
+			t.Errorf("listeners =\n%s\nwant\n%s", g, w)
+		}
+	})
+	t.Run("a long object finds its members by key", func(t *testing.T) {
+		var bl, ol []string
+		for i := range 3 * linearScan {
+			bl = append(bl, `"k`+strconv.Itoa(i)+`":"a"`)
+		}
+		ol = append(ol, `"k3":null`, `"k5":"b"`, `"new":"c"`, `"k0":"a"`)
+		r := func(labels []string) string {
+			return `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r","labels":{` + strings.Join(labels, ",") + `}},"spec":{}}`
+		}
+		out, ds, files := run(t, []file{{"ruralz.yaml", r(bl)}}, []file{{"o.yaml", r(ol)}})
+		if len(ds) != 0 {
+			t.Fatalf("diagnostics %q", texts(ds))
+		}
+		labels := at(t, out[0].Root, "metadata.labels")
+		var want []string
+		for i := range 3 * linearScan {
+			switch i {
+			case 3:
+			case 5:
+				want = append(want, `"k5":"b"`)
+			default:
+				want = append(want, `"k`+strconv.Itoa(i)+`":"a"`)
+			}
+		}
+		want = append(want, `"new":"c"`)
+		if g, w := dump(labels), compact(t, "{"+strings.Join(want, ",")+"}"); g != w {
+			t.Errorf("labels =\n%s\nwant\n%s", g, w)
+		}
+		if k0, _ := labels.Get("k0"); files.Location(k0.Pos).File != "ruralz.yaml" {
+			t.Errorf("an equal overlay scalar replaced the base node: k0 at %v", files.Location(k0.Pos))
+		}
+		_ = tree.KindMap
+	})
+}
diff --git a/internal/config/overlay/lookup_test.go b/internal/config/overlay/lookup_test.go
new file mode 100644
index 0000000..2a850af
--- /dev/null
+++ b/internal/config/overlay/lookup_test.go
@@ -0,0 +1,564 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package overlay
+
+import (
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/importer"
+	goparser "go/parser"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// The structural tests of this file keep the work counter of meter.go
+// complete (01 req 53; review finding: loops and library calls over the
+// whole input ran uncounted or in one bulk charge): outside meteredFiles,
+// no file of the package uses a tree.Node or schemaidx method or function
+// whose cost grows with the instance it reads, nor any function or method
+// of the slices, maps, strings, sort, regexp, bytes or unicode/utf8
+// packages but the strings.Builder methods that copy nothing, nor
+// diag.Nearest. The type checking follows internal/config/defaults
+// (TestLookupsCounted, WP-37).
+
+const (
+	treePkg      = "github.com/ravindu-rev/ruralz/internal/config/tree"
+	schemaidxPkg = "github.com/ravindu-rev/ruralz/internal/config/schemaidx"
+	diagPkg      = "github.com/ravindu-rev/ruralz/internal/config/diag"
+)
+
+// scanning lists, by types.Func.FullName, the tree and schemaidx methods
+// and functions whose cost grows with what they read; TestScanningInventory
+// keeps the list complete.
+func scanning() []string {
+	var out []string
+	for _, m := range []string{"Get", "Set", "Delete", "At", "Clone", "JSONValue"} {
+		out = append(out, "(*"+treePkg+".Node)."+m)
+	}
+	for _, m := range []string{"Select", "SelectValue", "DispatchValues", "PolicyConfig"} {
+		out = append(out, "(*"+schemaidxPkg+".Node)."+m)
+	}
+	for _, m := range []string{"Lookup", "SchemaPath", "Walk", "Fields", "FieldsSeq"} {
+		out = append(out, "(*"+schemaidxPkg+".Index)."+m)
+	}
+	return append(out, schemaidxPkg+".ItemElem", schemaidxPkg+".AppendItemJSON", diagPkg+".Nearest")
+}
+
+// scanningPackages are the standard library packages whose functions and
+// methods each loop over a whole slice, map or string.
+func scanningPackages() []string {
+	return []string{"slices", "maps", "strings", "sort", "regexp", "bytes", "unicode/utf8"}
+}
+
+// copyFree are the methods of scanning packages that read no text: a
+// strings.Builder's Grow allocates, String and Len return what it holds.
+func copyFree() []string {
+	return []string{"(*strings.Builder).Grow", "(*strings.Builder).String", "(*strings.Builder).Len"}
+}
+
+// meteredFiles are the files allowed to use what scanning lists: meter.go,
+// which counts each use, and selection.go, whose Selection.Absent runs
+// once per render outside Apply and CheckBase, on the names of the
+// overlay directories.
+func meteredFiles() []string { return []string{"meter.go", "selection.go"} }
+
+// checked is the type-checked non-test Go code of one directory.
+type checked struct {
+	fset  *token.FileSet
+	files []*ast.File
+	info  *types.Info
+	pkg   *types.Package
+}
+
+// goflagsOverlay returns the file replacements of the -overlay file that
+// GOFLAGS names, by absolute path, or nil, so a mutation proof run as
+// GOFLAGS=-overlay=<file> go test checks the replaced sources.
+func goflagsOverlay(t *testing.T) map[string]string {
+	t.Helper()
+	for _, f := range strings.Fields(os.Getenv("GOFLAGS")) {
+		path, ok := strings.CutPrefix(strings.TrimLeft(f, "-"), "overlay=")
+		if !ok {
+			continue
+		}
+		data, err := os.ReadFile(path) //nolint:gosec // G304: the overlay file GOFLAGS names.
+		if err != nil {
+			t.Fatalf("GOFLAGS overlay: %v", err)
+		}
+		var o struct{ Replace map[string]string }
+		if err := json.Unmarshal(data, &o); err != nil {
+			t.Fatalf("GOFLAGS overlay %s: %v", path, err)
+		}
+		return o.Replace
+	}
+	return nil
+}
+
+// typeCheck parses the non-test Go files of dir and type-checks them
+// against the export data of their imports, which "go list -export"
+// builds, so a selector is judged by the type it selects from, not by
+// its spelling.
+func typeCheck(t *testing.T, dir string) checked {
+	t.Helper()
+	if _, err := exec.LookPath("go"); err != nil {
+		t.Skipf("no go command to build export data: %v", err)
+	}
+	cmd := exec.CommandContext(t.Context(), "go", "list", "-export", "-deps", "-f", "{{.ImportPath}}\t{{.Export}}\t{{.DepOnly}}", ".")
+	cmd.Dir = dir
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("go list -export in %s: %v", dir, err)
+	}
+	exports := map[string]string{}
+	var path string
+	for line := range strings.Lines(string(out)) {
+		f := strings.Split(strings.TrimRight(line, "\n"), "\t")
+		if len(f) != 3 {
+			t.Fatalf("go list line %q", line)
+		}
+		exports[f[0]] = f[1]
+		if f[2] == "false" {
+			path = f[0]
+		}
+	}
+	c := checked{fset: token.NewFileSet()}
+	names, err := filepath.Glob(filepath.Join(dir, "*.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay := goflagsOverlay(t)
+	absDir, err := filepath.Abs(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		seen[filepath.Join(absDir, filepath.Base(name))] = true
+	}
+	for abs, repl := range overlay {
+		if filepath.Dir(abs) == absDir && strings.HasSuffix(abs, ".go") && !seen[abs] && repl != "" {
+			names = append(names, filepath.Join(dir, filepath.Base(abs)))
+		}
+	}
+	slices.Sort(names)
+	for _, name := range names {
+		if strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		var src any
+		if repl, ok := overlay[filepath.Join(absDir, filepath.Base(name))]; ok {
+			if repl == "" {
+				continue
+			}
+			data, err := os.ReadFile(repl) //nolint:gosec // G304: a replacement the GOFLAGS overlay names.
+			if err != nil {
+				t.Fatal(err)
+			}
+			src = data
+		}
+		f, err := goparser.ParseFile(c.fset, name, src, goparser.ParseComments)
+		if err != nil {
+			t.Fatal(err)
+		}
+		c.files = append(c.files, f)
+	}
+	imp := importer.ForCompiler(c.fset, "gc", func(p string) (io.ReadCloser, error) {
+		file, ok := exports[p]
+		if !ok || file == "" {
+			return nil, fmt.Errorf("no export data for %s", p)
+		}
+		return os.Open(file) //nolint:gosec // G304: an export data file go list named.
+	})
+	c.info = &types.Info{Selections: map[*ast.SelectorExpr]*types.Selection{}, Uses: map[*ast.Ident]types.Object{}, Types: map[ast.Expr]types.TypeAndValue{}}
+	if c.pkg, err = (&types.Config{Importer: imp}).Check(path, c.fset, c.files, c.info); err != nil {
+		t.Fatalf("type-check %s: %v", dir, err)
+	}
+	return c
+}
+
+// directUses returns the uses, as "file:line: use", of a scanning method
+// or function or of a function or method of a scanning package in the
+// non-test Go files of dir other than allowed, and the number of files
+// checked. A use is any selector that resolves to one by the type it
+// selects from: a call, a method or function value, a method expression,
+// a promoted method, and an interface method a scanning method satisfies.
+func directUses(t *testing.T, dir string, allowed []string) (uses []string, checkedFiles int) {
+	t.Helper()
+	c := typeCheck(t, dir)
+	scan := scanning()
+	scanFuncs := scanningFuncs(c.pkg, scan)
+	for _, file := range c.files {
+		name := c.fset.Position(file.Pos()).Filename
+		if slices.Contains(allowed, filepath.Base(name)) {
+			continue
+		}
+		checkedFiles++
+		ast.Inspect(file, func(n ast.Node) bool {
+			sel, ok := n.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			var fn *types.Func
+			if s, ok := c.info.Selections[sel]; ok {
+				fn, _ = s.Obj().(*types.Func)
+			} else {
+				fn, _ = c.info.Uses[sel.Sel].(*types.Func)
+			}
+			if fn == nil {
+				return true
+			}
+			inPkg := fn.Pkg() != nil && slices.Contains(scanningPackages(), fn.Pkg().Path()) && !slices.Contains(copyFree(), fn.FullName())
+			if inPkg || slices.Contains(scan, fn.FullName()) || viaInterface(fn, scanFuncs) {
+				p := c.fset.Position(sel.Pos())
+				uses = append(uses, filepath.Base(p.Filename)+":"+strconv.Itoa(p.Line)+": "+fn.FullName())
+			}
+			return true
+		})
+	}
+	return uses, checkedFiles
+}
+
+// scanningFuncs resolves the scanning methods among the packages pkg
+// imports, directly or not.
+func scanningFuncs(pkg *types.Package, scan []string) []*types.Func {
+	var out []*types.Func
+	for _, f := range exportedFuncs(pkg) {
+		if slices.Contains(scan, f.FullName()) && f.Signature().Recv() != nil {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// viaInterface reports a method of an interface type with the name and
+// signature of a scanning method, which a tree.Node or schemaidx value
+// would satisfy.
+func viaInterface(fn *types.Func, scan []*types.Func) bool {
+	recv := fn.Signature().Recv()
+	if recv == nil || !types.IsInterface(recv.Type()) {
+		return false
+	}
+	for _, s := range scan {
+		if s.Name() == fn.Name() && types.Identical(withoutRecv(s.Signature()), withoutRecv(fn.Signature())) {
+			return true
+		}
+	}
+	return false
+}
+
+// withoutRecv returns sig without its receiver.
+func withoutRecv(sig *types.Signature) *types.Signature {
+	return types.NewSignatureType(nil, nil, nil, sig.Params(), sig.Results(), sig.Variadic())
+}
+
+// exportedFuncs returns the exported package functions and the exported
+// methods of the exported named types of the tree, schemaidx and diag
+// packages among the imports of pkg, directly or not.
+func exportedFuncs(pkg *types.Package) []*types.Func {
+	var out []*types.Func
+	seen := map[*types.Package]bool{}
+	var visit func(p *types.Package)
+	visit = func(p *types.Package) {
+		if seen[p] {
+			return
+		}
+		seen[p] = true
+		for _, q := range p.Imports() {
+			visit(q)
+		}
+		if p.Path() != treePkg && p.Path() != schemaidxPkg && p.Path() != diagPkg {
+			return
+		}
+		for _, name := range p.Scope().Names() {
+			switch obj := p.Scope().Lookup(name).(type) {
+			case *types.Func:
+				if obj.Exported() {
+					out = append(out, obj)
+				}
+			case *types.TypeName:
+				named, ok := obj.Type().(*types.Named)
+				if !ok || !obj.Exported() {
+					continue
+				}
+				for m := range named.Methods() {
+					if m.Exported() {
+						out = append(out, m)
+					}
+				}
+			default:
+			}
+		}
+	}
+	visit(pkg)
+	return out
+}
+
+// TestLookupsMetered: outside meteredFiles, no file of the package uses a
