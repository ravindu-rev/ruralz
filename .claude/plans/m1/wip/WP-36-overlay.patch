+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package overlay
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+	"github.com/ravindu-rev/ruralz/pkg/config/v1alpha1"
+)
+
+func sv(text string) *tree.Node { return &tree.Node{Kind: tree.KindString, Text: text} }
+
+func iv(i int) *tree.Node { return &tree.Node{Kind: tree.KindInt, Text: strconv.Itoa(i)} }
+
+func nullv() *tree.Node { return &tree.Node{Kind: tree.KindNull} }
+
+// obj returns an object of alternating keys and values.
+func obj(kv ...any) *tree.Node {
+	n := &tree.Node{Kind: tree.KindMap}
+	for i := 0; i+1 < len(kv); i += 2 {
+		n.Members = append(n.Members, tree.Member{Key: kv[i].(string), Value: kv[i+1].(*tree.Node)})
+	}
+	return n
+}
+
+func arr(items ...*tree.Node) *tree.Node { return &tree.Node{Kind: tree.KindList, Items: items} }
+
+// doc returns a resource of kind and name holding spec (and metadata
+// members md, when given).
+func doc(kind, name string, spec *tree.Node, md ...any) *tree.Resource {
+	meta := obj(append([]any{"name", sv(name)}, md...)...)
+	root := obj("apiVersion", sv(v1), "kind", sv(kind), "metadata", meta)
+	if spec != nil {
+		root.Members = append(root.Members, tree.Member{Key: "spec", Value: spec})
+	}
+	return &tree.Resource{ID: tree.ID{Kind: v1alpha1.Kind(kind), Name: name}, APIVersion: v1, Root: root}
+}
+
+// scaleShape builds a stage D input of size n: one or more base
+// resources and overlay documents.
+type scaleShape struct {
+	name  string
+	build func(n int) (base, patches []*tree.Resource)
+}
+
+// listenerName is a listener name of width bytes or more.
+func listenerName(i, width int) string {
+	s := "l" + strconv.Itoa(i)
+	if len(s) < width {
+		s += strings.Repeat("x", width-len(s))
+	}
+	return s
+}
+
+func listeners(n, width int, entry func(name string) *tree.Node) *tree.Node {
+	l := arr()
+	for i := range n {
+		l.Items = append(l.Items, entry(listenerName(i, width)))
+	}
+	return l
+}
+
+func baseListener(name string) *tree.Node {
+	return obj("name", sv(name), "protocol", sv("http"), "port", iv(80))
+}
+
+// scaleShapes are the shapes of the review finding (01 req 54, S14): each
+// costs work quadratic in n when a lookup scans a whole object or list
+// per overlay entry or member.
+func scaleShapes() []scaleShape {
+	gw := func(spec *tree.Node) *tree.Resource { return doc("Gateway", "edge", spec) }
+	return []scaleShape{
+		{"map list patched by key", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			return []*tree.Resource{gw(obj("listeners", listeners(n, 0, baseListener)))},
+				[]*tree.Resource{gw(obj("listeners", listeners(n, 0, func(s string) *tree.Node { return obj("name", sv(s), "port", iv(2)) })))}
+		}},
+		{"map list entries deleted", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			return []*tree.Resource{gw(obj("listeners", listeners(n, 0, baseListener)))},
+				[]*tree.Resource{gw(obj("listeners", listeners(n, 0, func(s string) *tree.Node { return obj("name", sv(s), PatchKey, sv(PatchDelete)) })))}
+		}},
+		{"map list with long keys", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			return []*tree.Resource{gw(obj("listeners", listeners(n, 40, baseListener)))},
+				[]*tree.Resource{gw(obj("listeners", listeners(n, 40, func(s string) *tree.Node { return obj("name", sv(s), "port", iv(2)) })))}
+		}},
+		{"absent entries deleted from a short list", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			over := listeners(n, 0, func(s string) *tree.Node { return obj("name", sv("d"+s), PatchKey, sv(PatchDelete)) })
+			return []*tree.Resource{gw(obj("listeners", listeners(2, 0, baseListener)))}, []*tree.Resource{gw(obj("listeners", over))}
+		}},
+		{"absent entries deleted from a short list of wide entries", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			wide := listeners(4, 0, func(s string) *tree.Node {
+				e := obj()
+				for i := range n / 4 {
+					e.Members = append(e.Members, tree.Member{Key: "x" + strconv.Itoa(i), Value: iv(i)})
+				}
+				e.Members = append(e.Members, tree.Member{Key: "name", Value: sv(s)})
+				return e
+			})
+			over := listeners(n, 0, func(s string) *tree.Node { return obj("name", sv("d"+s), PatchKey, sv(PatchDelete)) })
+			return []*tree.Resource{gw(obj("listeners", wide))}, []*tree.Resource{gw(obj("listeners", over))}
+		}},
+		{"orderedMap list merged and appended", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			named := func(s string) *tree.Node { return obj("name", sv(s)) }
+			over := listeners(n, 0, named)
+			for i := range n {
+				over.Items = append(over.Items, named("new"+strconv.Itoa(i)))
+			}
+			return []*tree.Resource{gw(obj("policies", listeners(n, 0, named)))}, []*tree.Resource{gw(obj("policies", over))}
+		}},
+		{"labels merged, added and removed", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			base, over := obj(), obj()
+			for i := range n {
+				k := "k" + strconv.Itoa(i)
+				base.Members = append(base.Members, tree.Member{Key: k, Value: sv("a")})
+				switch i % 3 {
+				case 0:
+					over.Members = append(over.Members, tree.Member{Key: k, Value: nullv()})
+				case 1:
+					over.Members = append(over.Members, tree.Member{Key: k, Value: sv("b")})
+				default:
+					over.Members = append(over.Members, tree.Member{Key: "n" + k, Value: sv("c")})
+				}
+			}
+			return []*tree.Resource{doc("Route", "r", obj("timeout", sv("1s")), "labels", base)},
+				[]*tree.Resource{doc("Route", "r", obj("timeout", sv("2s")), "labels", over)}
+		}},
+		{"added resource with a long keyed list", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			return nil, []*tree.Resource{gw(obj("listeners", listeners(n, 0, baseListener)))}
+		}},
+		{"added resource with a wide object", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			spec := obj()
+			for i := range n {
+				spec.Members = append(spec.Members, tree.Member{Key: "m" + strconv.Itoa(i), Value: obj()})
+			}
+			return nil, []*tree.Resource{doc("Route", "r", spec)}
+		}},
+		{"redispatched Policy with a wide config", func(n int) ([]*tree.Resource, []*tree.Resource) {
+			config := obj("schema", obj(PatchKey, iv(1)))
+			for i := range n {
+				config.Members = append(config.Members, tree.Member{Key: "x" + strconv.Itoa(i), Value: obj("a", iv(i))})
+			}
+			over := obj()
+			for i := range n {
+				over.Members = append(over.Members, tree.Member{Key: "x" + strconv.Itoa(i), Value: obj("b", iv(i))})
+			}
+			return []*tree.Resource{doc("Policy", "p", obj("type", sv("validation.json-schema"), "config", config))},
+				[]*tree.Resource{doc("Policy", "p", obj("type", sv("cors"), "config", over))}
+		}},
+	}
+}
+
+// work returns the Yield calls of one stage D run over shape at size n
+// (CheckBase on every base resource, then Apply): Yield runs every 256
+// work units, so the count measures the work without a clock.
+func work(t testing.TB, sh scaleShape, n int) int {
+	t.Helper()
+	calls := 0
+	base, patches := sh.build(n)
+	opts := Options{Schemas: schemas(t), Yield: func() { calls++ }}
+	for _, r := range base {
+		_ = CheckBase(r, opts)
+	}
+	if _, _, err := Apply(t.Context(), base, patches, opts); err != nil {
+		t.Fatal(err)
+	}
+	return calls
+}
+
+// TestScaleLinear covers the review finding on quadratic merges (01 req 6
+// limits, 01 req 54 load budget, S14 hostile input): for every shape,
+// four times the input costs at most about four times the work units. A
+// lookup scanning a whole object or keyed list per overlay member or
+// entry costs sixteen times. The units count every member, entry and key
+// a lookup reads, so the bound holds whatever the machine.
+func TestScaleLinear(t *testing.T) {
+	const n = 2000
+	for _, sh := range scaleShapes() {
+		t.Run(sh.name, func(t *testing.T) {
+			w1, w4 := work(t, sh, n), work(t, sh, 4*n)
+			if w1 < n/yieldEvery {
+				t.Fatalf("%d work units at n=%d: the shape does too little to measure", w1*yieldEvery, n)
+			}
+			t.Logf("%d Yield calls at n=%d, %d at n=%d (ratio %.2f)", w1, n, w4, 4*n, float64(w4)/float64(w1))
+			if w4 > 4*w1+w1/2+4 {
+				t.Errorf("work grows faster than the input: %d Yield calls at n=%d, %d at n=%d (ratio %.1f, want about 4)",
+					w1, n, w4, 4*n, float64(w4)/float64(w1))
+			}
+		})
+	}
+}
+
+// TestScaleAllocations: the keyed-list lookups allocate nothing per
+// comparison (review finding: matching by "s"+key concatenation allocated
+// once per comparison for keys of 32 bytes or more, so about n²/2
+// allocations), so allocations grow linearly with the list.
+func TestScaleAllocations(t *testing.T) {
+	sh := scaleShapes()[2]
+	allocs := func(n int) float64 {
+		var inputs [][2][]*tree.Resource
+		for range 2 {
+			b, p := sh.build(n)
+			inputs = append(inputs, [2][]*tree.Resource{b, p})
+		}
+		opts := Options{Schemas: schemas(t)}
+		i := 0
+		return testing.AllocsPerRun(1, func() {
+			in := inputs[i]
+			i++
+			if _, _, err := Apply(t.Context(), in[0], in[1], opts); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	a1, a4 := allocs(500), allocs(2000)
+	t.Logf("%.0f allocations at n=500, %.0f at n=2000 (ratio %.2f)", a1, a4, a4/a1)
+	if a4 > 4.5*a1+100 {
+		t.Errorf("allocations grow faster than the list: %.0f at n=500, %.0f at n=2000 (ratio %.1f)", a1, a4, a4/a1)
+	}
+}
+
+// TestYield covers 01 req 53 (review finding): Apply and CheckBase call
+// Options.Yield every 256 work units inside one resource, and Apply also
+// between resources, so the loader's worker can yield within a large
+// resource; a nil Yield is never called.
+func TestYield(t *testing.T) {
+	const n = 1024
+	base, patches := scaleShapes()[0].build(n)
+	calls := 0
+	opts := Options{Schemas: schemas(t), Yield: func() { calls++ }}
+	_ = CheckBase(base[0], opts)
+	// CheckBase visits every listener and its three members.
+	if calls < 4*n/yieldEvery {
+		t.Errorf("CheckBase on %d listeners called Yield %d times, want at least %d", n, calls, 4*n/yieldEvery)
+	}
+	calls = 0
+	if _, _, err := Apply(t.Context(), base, patches, opts); err != nil {
+		t.Fatal(err)
+	}
+	if calls < 2*n/yieldEvery {
+		t.Errorf("Apply merging %d listeners called Yield %d times, want at least %d", n, calls, 2*n/yieldEvery)
+	}
+	calls = 0
+	many := make([]*tree.Resource, 300)
+	for i := range many {
+		many[i] = doc("Route", "r"+strconv.Itoa(i), obj())
+	}
+	if _, _, err := Apply(t.Context(), many, nil, opts); err != nil {
+		t.Fatal(err)
+	}
+	if calls < len(many) {
+		t.Errorf("Apply over %d small resources called Yield %d times, want one between each", len(many), calls)
+	}
+	base, patches = scaleShapes()[0].build(n)
+	if _, _, err := Apply(t.Context(), base, patches, Options{Schemas: schemas(t)}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// BenchmarkMergeShapes merges each scaleShapes input at 10,000 entries
+// (stage D share of the 01 req 54 budget on hostile shapes).
+func BenchmarkMergeShapes(b *testing.B) {
+	for _, sh := range scaleShapes() {
+		b.Run(sh.name, func(b *testing.B) {
+			opts := Options{Schemas: schemas(b)}
+			b.ReportAllocs()
+			for range b.N {
+				b.StopTimer()
+				base, patches := sh.build(10_000)
+				b.StartTimer()
+				for _, r := range base {
+					_ = CheckBase(r, opts)
+				}
+				if _, _, err := Apply(b.Context(), base, patches, opts); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/config/overlay/select_test.go b/internal/config/overlay/select_test.go
new file mode 100644
index 0000000..92dc1dc
--- /dev/null
+++ b/internal/config/overlay/select_test.go
@@ -0,0 +1,239 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package overlay
+
+import (
+	"math/rand/v2"
+	"slices"
+	"strconv"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/schemaidx"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// twoRounds is a rendered schema whose dispatch takes two rounds: mode a
+// selects a branch that declares sub and carries its own rule on sub,
+// which makes doc a JSONSchemaDocument. selectOf reads sub only after
+// the first round shows the branch declares it.
+const twoRounds = `{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "type": "object",
+  "properties": {"apiVersion": {"const": "test/v1"}, "kind": {"enum": ["Thing"]}},
+  "allOf": [{"if": {"properties": {"kind": {"const": "Thing"}}, "required": ["kind"]}, "then": {"$ref": "#/$defs/Thing"}}],
+  "$defs": {
+    "JSONSchemaDocument": {"type": ["object", "boolean"]},
+    "Thing": {"type": "object", "properties": {"kind": {"const": "Thing"}, "spec": {"$ref": "#/$defs/Spec"}}},
+    "Spec": {"type": "object", "properties": {"mode": {"type": "string"}, "n": {"type": "integer"}},
+      "allOf": [
+        {"if": {"properties": {"mode": {"const": "a"}}, "required": ["mode"]},
+         "then": {"properties": {"sub": {"type": "string"}},
+           "allOf": [{"if": {"properties": {"sub": {"const": "x"}}, "required": ["sub"]}, "then": {"properties": {"doc": {"$ref": "#/$defs/JSONSchemaDocument"}}}}]}},
+        {"if": {"properties": {"n": {"const": 3}}, "required": ["n"]}, "then": {"properties": {"three": {"type": "object"}}}}]}
+  }
+}`
+
+// dispatching returns the schema nodes of x that carry if/then rules
+// testing a declared member, with the members and values the rules test
+// (string constants, as DispatchValues lists them) and the declared
+// members.
+func dispatching(x *schemaidx.Index) map[*schemaidx.Node]map[string][]string {
+	out := map[*schemaidx.Node]map[string][]string{}
+	for f := range x.FieldsSeq() {
+		for _, name := range f.Node.PropertyNames() {
+			if vs := f.Node.DispatchValues(name); len(vs) > 0 {
+				if out[f.Node] == nil {
+					out[f.Node] = map[string][]string{}
+				}
+				out[f.Node][name] = vs
+			}
+		}
+	}
+	return out
+}
+
+// instances returns objects for static's dispatch: each tested member
+// given each of its values, another value, a number, null or nothing,
+// among declared and undeclared members before and after it, with
+// repeated keys and removed (nil) members, short and long.
+func instances(r *rand.Rand, static *schemaidx.Node, tested map[string][]string, extra map[string][]any) []*tree.Node {
+	var names []string
+	for name := range tested {
+		names = append(names, name)
+	}
+	for name := range extra {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	declared := static.PropertyNames()
+	value := func(name string) *tree.Node {
+		vs := tested[name]
+		switch k := r.IntN(len(vs) + 4); {
+		case k < len(vs):
+			return sv(vs[k])
+		case k == len(vs):
+			return sv("other")
+		case k == len(vs)+1:
+			return iv(3)
+		case k == len(vs)+2:
+			if ev := extra[name]; len(ev) > 0 {
+				switch v := ev[r.IntN(len(ev))].(type) {
+				case bool:
+					return &tree.Node{Kind: tree.KindBool, Bool: v}
+				case int:
+					return iv(v)
+				case string:
+					return sv(v)
+				}
+			}
+			return nullv()
+		default:
+			return obj()
+		}
+	}
+	var out []*tree.Node
+	for range 400 {
+		inst := obj()
+		width := []int{2, linearScan, linearScan + 1, 3 * linearScan}[r.IntN(4)]
+		for range width {
+			switch k := r.IntN(10); {
+			case k < 4 && len(names) > 0:
+				name := names[r.IntN(len(names))]
+				inst.Members = append(inst.Members, tree.Member{Key: name, Value: value(name)})
+			case k < 6 && len(declared) > 0:
+				inst.Members = append(inst.Members, tree.Member{Key: declared[r.IntN(len(declared))], Value: iv(1)})
+			case k < 7 && len(names) > 0:
+				// A member mergeMap removed: nil, read as absent.
+				inst.Members = append(inst.Members, tree.Member{Key: names[r.IntN(len(names))]})
+			case k < 8:
+				inst.Members = append(inst.Members, tree.Member{Key: "x" + strconv.Itoa(r.IntN(5))})
+			default:
+				inst.Members = append(inst.Members, tree.Member{Key: "u" + strconv.Itoa(r.IntN(100)), Value: sv("v")})
+			}
+		}
+		out = append(out, inst)
+	}
+	return out
+}
+
+// present returns inst without its removed (nil) members, as mergeMap's
+// first pass leaves an object that selectOf reads.
+func present(inst *tree.Node) *tree.Node {
+	c := obj()
+	for _, m := range inst.Members {
+		if m.Value != nil {
+			c.Members = append(c.Members, m)
+		}
+	}
+	return c
+}
+
+// TestSelectOf covers the bounded dispatch of selectOf (review finding:
+// schemaidx Select read every member once per rule, uncounted): on the
+// committed schema and on synthetic ones with a boolean and a number
+// constant and two dispatch rounds, selectOf returns what Select returns
+// for the object without its removed members, for short and long
+// objects, and Select reads at most the declared members.
+func TestSelectOf(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4)) //nolint:gosec // G404: deterministic test data
+	committed, _ := schemas(t).Index(v1)
+	nested, err := schemaidx.Load("test/v1", []byte(nestedDispatch))
+	if err != nil {
+		t.Fatal(err)
+	}
+	two, err := schemaidx.Load("test/v1", []byte(twoRounds))
+	if err != nil {
+		t.Fatal(err)
+	}
+	extras := map[string][]any{"flag": {true, false}, "n": {3, 4}, "sub": {"x", "y"}}
+	checked := 0
+	for name, x := range map[string]*schemaidx.Index{"committed": committed, "nestedDispatch": nested, "twoRounds": two} {
+		for static, tested := range dispatching(x) {
+			for _, inst := range instances(r, static, tested, extras) {
+				a, p := meterProbe()
+				got := a.selectOf(static, inst)
+				if want := static.Select(present(inst)); !sameSchema(got, want) {
+					t.Fatalf("%s: selectOf(%s) differs from Select", name, dump(present(inst)))
+				}
+				if p.selectWidth > max(linearScan, len(static.PropertyNames())+len(extras)) {
+					t.Errorf("%s: Select read %d members", name, p.selectWidth)
+				}
+				checked++
+			}
+		}
+	}
+	if checked < 1000 {
+		t.Errorf("checked %d instances, want the dispatching nodes of three schemas", checked)
+	}
+	a, _ := meterProbe()
+	if a.selectOf(nil, obj("a", iv(1))) != nil || a.selectOf(committed.Root(), nil) != committed.Root() {
+		t.Error("selectOf of a nil schema or instance differs from Select")
+	}
+	// The second round reads a member only the first round's branch
+	// declares: without the second pass, sub would be missing.
+	spec, _ := two.Spec("Thing")
+	inst := obj("mode", sv("a"))
+	for i := range linearScan {
+		inst.Members = append(inst.Members, tree.Member{Key: "u" + strconv.Itoa(i), Value: iv(i)})
+	}
+	inst.Members = append(inst.Members, tree.Member{Key: "sub", Value: sv("x")})
+	if sel := a.selectOf(spec, inst); !opaque(memberSchema(sel, "doc")) {
+		t.Error("two rounds: doc is not a JSONSchemaDocument after mode a and sub x")
+	}
+}
+
+// sameSchema reports two dispatch results that are one schema: the same
+// node, or, since schemaidx builds a result of two matching rules anew
+// on every Select call, nodes with the same definition and declared
+// members, each the same node.
+func sameSchema(a, b *schemaidx.Node) bool {
+	if a == b {
+		return true
+	}
+	if a == nil || b == nil || a.Def() != b.Def() || !slices.Equal(a.PropertyNames(), b.PropertyNames()) {
+		return false
+	}
+	for name, pa := range a.Properties() {
+		if pb, _ := b.Property(name); pa != pb && (pa.Def() != pb.Def() || !slices.Equal(pa.PropertyNames(), pb.PropertyNames())) {
+			return false
+		}
+	}
+	return true
+}
+
+// TestDispatchReadsDeclared pins what selectOf relies on, over the
+// committed schema: every member an if/then rule tests is a declared
+// property of the object whose rule it is, at every schema path where a
+// rule applies (TestDispatchTestsScalars adds that every member a rule
+// requires is one it tests against a constant). A contract change request
+// asks schemaidx to export the members its rules read, so the proxy would
+// not depend on this.
+func TestDispatchReadsDeclared(t *testing.T) {
+	for _, x := range []*schemaidx.Index{func() *schemaidx.Index { x, _ := schemas(t).Index(v1); return x }()} {
+		declared := map[string]map[string]bool{}
+		for f := range x.FieldsSeq() {
+			id := f.Kind + " " + f.Path
+			if declared[id] == nil {
+				declared[id] = map[string]bool{}
+			}
+			for _, name := range f.Node.PropertyNames() {
+				declared[id][name] = true
+			}
+		}
+		rules := 0
+		for f := range x.FieldsSeq() {
+			for _, d := range f.Where {
+				for _, c := range d.Conditions {
+					rules++
+					if !declared[f.Kind+" "+d.Path][c.Member] {
+						t.Errorf("%s %q: a rule tests %s, which is not declared there", f.Kind, d.Path, c.Member)
+					}
+				}
+			}
+		}
+		if rules == 0 {
+			t.Fatal("no dispatch rule found")
+		}
+	}
+}
