+			_, ds := pipeline(t, b, o, Options{Schemas: set, Files: files})
+			if len(ds) != 1 || ds[0].Code != CodeBasePatch {
+				t.Fatalf("diagnostics %q, want one %s", texts(ds), CodeBasePatch)
+			}
+			if !strings.HasPrefix(ds[0].Message, rule) {
