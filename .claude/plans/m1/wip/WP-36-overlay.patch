+// callsCounting reports whether n holds a call of a counting name.
+func callsCounting(n ast.Node, set map[string]bool) bool {
+	found := false
+	ast.Inspect(n, func(n ast.Node) bool {
+		if call, ok := n.(*ast.CallExpr); ok && set[calleeName(call)] {
+			found = true
+		}
+		return !found
+	})
