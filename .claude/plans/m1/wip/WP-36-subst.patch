+// TestDiagnosticsBounded covers the review finding on unbounded
+// diagnostic text (01 req 49 and 50; 01 J row 003 bounded heap): one
+// long key or name repeated by every diagnostic below it made their text
+// grow with the content, up to 10,001 times over. Each row is one member
+// of the class, a long text the walk names in a path element, a resource
+// identity or a message, or a newline the one-line text form must not
+// hold, and asserts that every diagnostic's text and JSON forms are
+// bounded whatever the content's size, so the rows hold for 1 MiB texts.
+func TestDiagnosticsBounded(t *testing.T) {
+	long := strings.Repeat("k", 1<<20)
+	undefined := strings.Repeat("${U}", 50)
+	route := func(name, spec string) string {
+		return `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":` + quote(name) + `},"spec":` + spec + `}`
+	}
+	cases := []struct {
+		name, src string
+		// diags is the number of diagnostics the row makes.
+		diags int
+	}{
+		{"req48 a long mapping key", `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r","annotations":{"` + long + `":"` + undefined + `"}},"spec":{}}`, 50},
+		{"req48 a long mapping key holding ${", `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r","annotations":{"` + long + `${K}":"x"}},"spec":{}}`, 1},
+		{"req48 a long key deep in free content", `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"p"},"spec":{"type":"plugin","plugin":"g","config":{"a":{"` + long + `":{"b":"` + undefined + `"}}}}}`, 50},
+		{"req48 a long keyed entry key", route("r", `{"match":{"headers":[{"name":"`+long+`","exact":"`+undefined+`"}]}}`), 50},
+		{"req48 a long string set element", `{"apiVersion":"ruralz/v1alpha1","kind":"Consumer","metadata":{"name":"c"},"spec":{"tags":["` + long + undefined + `"]}}`, 50},
+		{"req48 a long composite set element", `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"p"},"spec":{"type":"auth.mtls","config":{"subjects":[{"subject":"` + long + undefined + `"}]}}}`, 50},
+		{"req49 a long resource name", route(long, `{"timeout":"`+undefined+`"}`), 50},
+		{"req49 a long kind", `{"apiVersion":"ruralz/v1alpha1","kind":"` + long + `","metadata":{"name":"r"},"spec":{}}`, 1},
+		{"req49 a long apiVersion", `{"apiVersion":"` + long + `","kind":"Route","metadata":{"name":"r"},"spec":{}}`, 1},
+		{"req49 a resource name holding a newline", route("a\nb", `{"timeout":"${U}"}`), 1},
+		{"req49 a kind holding a newline", `{"apiVersion":"ruralz/v1alpha1","kind":"Ro\nute","metadata":{"name":"r"},"spec":{}}`, 1},
+		{"req49 an apiVersion holding a newline", `{"apiVersion":"ruralz/v1\nalpha1","kind":"Route","metadata":{"name":"r"},"spec":{}}`, 1},
+	}
+	const perDiagnostic = 1024
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ds := apply(t, tc.src, nil)
+			if len(ds) != tc.diags {
+				t.Fatalf("%d diagnostics, want %d", len(ds), tc.diags)
+			}
+			for _, d := range ds {
+				text := d.AppendText(nil)
+				if len(text) > perDiagnostic || bytes.ContainsAny(text, "\r\n") {
+					t.Fatalf("a text line of %d bytes, holding a newline %v, want one line of at most %d: %.300q",
+						len(text), bytes.ContainsAny(text, "\r\n"), perDiagnostic, text)
+				}
+				if d.Resource != nil && (len(d.Resource.Kind) > maxShown+5 || len(d.Resource.Name) > maxShown+5) {
+					t.Errorf("resource %.100s/%.100s: %d and %d bytes", d.Resource.Kind, d.Resource.Name, len(d.Resource.Kind), len(d.Resource.Name))
+				}
+			}
+			var js bytes.Buffer
+			if err := diag.WriteJSON(&js, ds); err != nil {
+				t.Fatal(err)
+			}
+			if js.Len() > 2*perDiagnostic*len(ds) {
+				t.Errorf("JSON form of %d bytes for %d diagnostics", js.Len(), len(ds))
+			}
+		})
+	}
+}
