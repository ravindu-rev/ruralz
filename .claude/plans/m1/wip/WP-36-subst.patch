+// referenceScan is the segment reading of 01 req 26 as the first
+// implementation computed it: a byte loop that searches each default's }
+// to the end of the string. It is quadratic on malformed input, and it is
+// the reference FuzzScan compares the linear scanEach against.
+func referenceScan(s string, lenient bool) ([]segment, string) {
+	name := regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*`)
+	var segs []segment
+	var lit strings.Builder
+	flush := func() {
+		if lit.Len() > 0 {
+			segs = append(segs, segment{lit: lit.String()})
+			lit.Reset()
+		}
+	}
+	for i := 0; i < len(s); {
+		switch {
+		case strings.HasPrefix(s[i:], "$${"):
+			lit.WriteString("${")
+			i += 3
+		case strings.HasPrefix(s[i:], "${"):
