+// TestMalformedUndefined covers the review finding on 01 req 27 ("one
+// diagnostic per occurrence") in a malformed scalar, against CM
+// "Validation and diff semantics" (every error in one run): a scalar
+// holding a malformed ${ reports, besides its RZ-CFG-005, RZ-CFG-010 with
+// its hint for each well-formed use of an undefined variable without
+// default, read leniently as the secret-like name warning reads it, so
+// the author learns of both errors in one run. A use with a default, a
+// defined variable, an expression inside the malformed one and a
+// forbidden position take none.
+func TestMalformedUndefined(t *testing.T) {
+	malformed := "r.yaml:1:106 error RZ-CFG-005 Route/r spec.match.path.prefix: malformed substitution (%s); write $${ for a literal ${"
+	undefined := `r.yaml:1:106 error RZ-CFG-010 Route/r spec.match.path.prefix: variable "%s" is not defined and has no default`
+	f := func(format, arg string) string { return strings.Replace(format, "%s", arg, 1) }
+	for _, tc := range []struct {
+		name, text string
+		vars       Map
+		hints      []string
+		want       []string
+	}{
+		{
+			name: "req27 an undefined variable before a malformed ${", text: "${UNDEF} ${1X}",
+			want: []string{f(malformed, reasonName), f(undefined, "UNDEF")},
+		},
+		{
+			name: "req27 an undefined variable after a malformed ${", text: "${1X} ${UNDEF}",
+			want: []string{f(malformed, reasonName), f(undefined, "UNDEF")},
+		},
+		{
+			name: "req27 one diagnostic per occurrence", text: "${U} ${U} ${",
+			want: []string{f(malformed, reasonUnterminated), f(undefined, "U"), f(undefined, "U")},
+		},
+		{
+			name: "req27 the hint names the nearest variable", text: "${UNDEFX} ${", hints: []string{"UNDEF"},
+			want: []string{f(malformed, reasonUnterminated), f(undefined, "UNDEFX") + ` (did you mean "UNDEF"?)`},
+		},
+		{
+			name: "req27 the expression after a malformed default opening is a use", text: "${A:-${B}}",
+			want: []string{f(malformed, reasonNested), f(undefined, "B")},
+		},
+		{
+			name: "req27 a default is taken", text: "${U:-d} ${",
+			want: []string{f(malformed, reasonUnterminated)},
+		},
+		{
+			name: "req27 a defined variable", text: "${A} ${E} ${", vars: Map{"A": "a", "E": ""},
+			want: []string{f(malformed, reasonUnterminated)},
+		},
+		{
+			name: "req27 a name inside a malformed expression is no use", text: "${UNDEF-d}",
+			want: []string{f(malformed, reasonOperator)},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r, ds := apply(t, prefixRoute(tc.text), tc.vars, tc.hints...)
+			if got := texts(ds); !slices.Equal(got, tc.want) {
+				t.Errorf("diagnostics =\n%q\nwant\n%q", got, tc.want)
+			}
+			if got := at(t, r.Root, "spec.match.path.prefix").Text; got != tc.text {
+				t.Errorf("text %q, want the authored %q", got, tc.text)
+			}
+		})
+	}
+	t.Run("req28 a forbidden position takes RZ-CFG-011 alone", func(t *testing.T) {
+		_, ds := apply(t, `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r"},"spec":{"match":{"when":"'${U}' ${"}}}`, nil)
+		if got := codes(ds); !slices.Equal(got, []string{CodeForbidden}) {
+			t.Errorf("codes %v, want [%s]: %q", got, CodeForbidden, texts(ds))
+		}
+	})
+}
+
+// TestShown pins how a diagnostic shows a resource kind or name (review
+// finding: identities carried the whole input, and a newline broke the
+// one-line text form of 01 req 49): clipped to maxShown bytes, Go-quoted
+// when it holds a character that is not graphic, a quote, a backslash or
+// invalid UTF-8, and "" quoted when it is empty, as config/canonical
+// shows it.
+func TestShown(t *testing.T) {
+	long := strings.Repeat("k", 300)
+	for _, tc := range []struct{ in, want string }{
+		{"", `""`},
+		{"Route", "Route"},
+		{"é", "é"},
+		{"a\nb", `"a\nb"`},
+		{`a"b`, `"a\"b"`},
+		{`a\b`, `"a\\b"`},
+		{"a\x7fb", `"a\x7fb"`},
+		{"a\u0085b", `"a\u0085b"`},
+		{"a\u202eb", `"a\u202eb"`},
+		{"a\xffb", `"a\xffb"`},
+		{long, long[:maxShown] + "..."},
+		{long[:100] + "\n", long[:maxShown] + "..."},
+		{long[:maxShown-1] + "\n" + long, `"` + long[:maxShown-1] + `\n..."`},
+	} {
+		if got := shown(tc.in); got != tc.want {
+			t.Errorf("shown(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
+
+// TestBoundElem pins the bounding of path elements (review finding: up
+// to 10,001 diagnostics each repeated one long key in full): a member
+// name, a keyed entry's key and a string set element are clipped, other
+// elements are kept, and a short text is copied, so a diagnostic never
+// keeps the source it was read from alive (clip).
+func TestBoundElem(t *testing.T) {
+	long := strings.Repeat("k", 300)
+	clipped := long[:maxShown] + "..."
+	raw := json.RawMessage(`{"a":1}`)
+	for _, tc := range []struct{ in, want diag.PathElem }{
+		{diag.Field(long), diag.Field(clipped)},
+		{diag.Field("name"), diag.Field("name")},
+		{diag.Keyed("name", long), diag.Keyed("name", clipped)},
+		{diag.Item(long), diag.Item(clipped)},
+		{diag.Item(raw), diag.Item(raw)},
+		{diag.Index(3), diag.Index(3)},
+	} {
+		got := boundElem(tc.in)
+		if g, w := (diag.Path{got}).String(), (diag.Path{tc.want}).String(); g != w {
+			t.Errorf("boundElem(%s) = %s, want %s", diag.Path{tc.in}, g, w)
+		}
+	}
+	short := long[:10]
+	var got string
+	if a := testing.AllocsPerRun(10, func() { got = clip(short) }); a < 1 || got != short {
+		t.Errorf("clip of a short text: %v allocations, %q; want a copy", a, got)
+	}
+}
