diff --git a/internal/config/subst/hint.go b/internal/config/subst/hint.go
new file mode 100644
index 0000000..c28651b
--- /dev/null
+++ b/internal/config/subst/hint.go
@@ -0,0 +1,342 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package subst
+
+import (
+	"slices"
+	"strings"
+	"sync"
+	"unicode"
+)
+
+// Limits of the nearest-name search, as diag.Nearest applies them.
+const (
+	// hintLengthSlack is the most bytes a compared name's length may differ
+	// from the undefined name's.
+	hintLengthSlack = 3
+	// hintCompared is the most length-compatible names compared.
+	hintCompared = 64
+	// hintMaxDistance is the largest distance a hint may have.
+	hintMaxDistance = 3
+	// hintRowsPerCharge is how many rows of the distance table the search
+	// fills between two reports to the meter: at most textStep cells.
+	hintRowsPerCharge = textStep / (2*hintMaxDistance + 1)
+)
+
+// hints computes the RZ-CFG-010 hint of 01 req 27: the HintNames entry
+// nearest an undefined variable name. Its answer is exactly
+// diag.Nearest(name, names) over the sorted, deduplicated names
+// (TestHintsMatchNearest, FuzzHints), at a bounded cost (review finding:
+// diag.Nearest allocates a table of (len(a)+1)*(len(b)+1) ints per
+// compared name and reads every candidate in its case-insensitive pass,
+// so a long undefined name cost time and memory quadratic in its length,
+// once per occurrence):
+//
+//   - a name longer than the longest entry plus hintLengthSlack bytes has
+//     no hint and costs nothing: a case-insensitive match is never shorter
+//     in bytes than a name of ASCII letters, digits and underscores, which
+//     the grammar of 01 req 26 admits only, and no entry is close enough
+//     in length to be compared;
+//   - the case-insensitive match is one lookup of the name's simple-fold
+//     key, the relation strings.EqualFold tests;
+//   - the optimal string alignment distance is computed with the common
+//     prefix and suffix removed, in a band of the distance limit around
+//     the diagonal and with three rows of at most 7 cells, and stops once
+//     two consecutive rows exceed the best distance found so far:
+//     O(len(name)) time per compared entry and O(1) memory;
+//   - each distinct name is computed once per Substituter, safely for
+//     concurrent workers; the memo keeps at most memoMax names.
+//
+// The index over the names, which sorts them and removes repeated ones,
+// is built on the first undefined variable, so a render without one pays
+// nothing, and its work is counted to that variable's walk as it is done
+// (01 req 53). Every pass over a name reads it in windows reported to the
+// meter. A contract change request asks diag.Nearest (WP-01) to adopt the
+// same bounds.
+type hints struct {
+	// names are Options.HintNames as given: in any order, with repeats.
+	names   []string
+	memoMax int
+
+	once sync.Once
+	idx  hintIndex
+
+	mu   sync.Mutex
+	memo map[string]hintResult
+}
+
+// hintIndex is the index over hints.names.
+type hintIndex struct {
+	// names are hints.names sorted, without repeats.
+	names []string
+	// exact maps a fold key to the index of the first name holding it.
+	exact map[string]int
+	// lower holds strings.ToLower of each name, which diag.Nearest
+	// compares.
+	lower []string
+	// byLen lists the indices of the names of each byte length, ascending.
+	byLen map[int][]int
+	// maxLen is the length of the longest name.
+	maxLen int
+}
+
+// hintResult is one memoized answer.
+type hintResult struct {
+	name string
+	ok   bool
+}
+
+// newHints returns the hint search over names, in any order; it reads
+// them only once an undefined variable needs a hint, so the caller must
+// not change them meanwhile.
+func newHints(names []string, memoMax int) *hints {
+	return &hints{names: names, memoMax: memoMax}
+}
+
+// index returns the index over the names, building it on the first call,
+// whose meter receives the bytes the build reads, copies and compares.
+func (h *hints) index(meter func(n int)) *hintIndex {
+	h.once.Do(func() {
+		names := make([]string, 0, len(h.names))
+		for _, n := range h.names {
+			meter(byteUnit)
+			names = append(names, n)
+		}
+		names = sortStrings(names, meter)
+		x := hintIndex{
+			names: names,
+			exact: map[string]int{},
+			lower: make([]string, len(names)),
+			byLen: map[int][]int{},
+		}
+		for i, n := range names {
+			key := foldKey(n, meter)
+			if _, dup := x.exact[key]; !dup {
+				x.exact[key] = i
+			}
+			x.lower[i] = lower(n, meter)
+			x.byLen[len(n)] = append(x.byLen[len(n)], i)
+			x.maxLen = max(x.maxLen, len(n))
+		}
+		h.idx = x
+	})
+	return &h.idx
+}
+
+// nearest returns the hint for name, a variable name of the 01 req 26
+// grammar (ASCII letters, digits and underscores), and whether there is
+// one, reporting the bytes and table cells it reads to meter.
+func (h *hints) nearest(name string, meter func(n int)) (string, bool) {
+	if len(h.names) == 0 {
+		return "", false
+	}
+	x := h.index(meter)
+	if len(name) > x.maxLen+hintLengthSlack {
+		return "", false
+	}
+	h.mu.Lock()
+	r, hit := h.memo[name]
+	h.mu.Unlock()
+	if hit {
+		return r.name, r.ok
+	}
+	r = h.compute(x, name, meter)
+	h.mu.Lock()
+	if h.memo == nil {
+		h.memo = map[string]hintResult{}
+	}
+	if len(h.memo) < h.memoMax {
+		h.memo[name] = r
+	}
+	h.mu.Unlock()
+	return r.name, r.ok
+}
+
+// compute is diag.Nearest(name, x.names) over the index x.
+func (h *hints) compute(x *hintIndex, name string, meter func(n int)) hintResult {
+	if i, ok := x.exact[foldKey(name, meter)]; ok {
+		return hintResult{name: x.names[i], ok: true}
+	}
+	limit := max(1, min(hintMaxDistance, len(name)/3))
+	low := lower(name, meter)
+	best, bestD := -1, limit+1
+	for _, i := range x.window(len(name)) {
+		if bestD == 0 {
+			break
+		}
+		// Later names sort after the best, so only a smaller distance
+		// replaces it, as diag.Nearest breaks ties by byte order.
+		if d := osaWithin(low, x.lower[i], bestD-1, meter); d < bestD {
+			best, bestD = i, d
+		}
+	}
+	if best < 0 {
+		return hintResult{}
+	}
+	return hintResult{name: x.names[best], ok: true}
+}
+
+// window returns the indices, ascending, of the first hintCompared names
+// whose length differs from n by at most hintLengthSlack bytes: the names
+// diag.Nearest compares.
+func (x *hintIndex) window(n int) []int {
+	var out []int
+	// bounded: 2*hintLengthSlack+1 lengths.
+	for l := max(0, n-hintLengthSlack); l <= n+hintLengthSlack; l++ {
+		ids := x.byLen[l]
+		out = append(out, ids[:min(len(ids), hintCompared)]...)
+	}
+	slices.Sort(out)
+	return out[:min(len(out), hintCompared)]
+}
+
+// foldKey returns s with each rune replaced by the smallest rune of its
+// simple case folding orbit, so foldKey(a) == foldKey(b) exactly when
+// strings.EqualFold(a, b): EqualFold compares rune by rune, an invalid
+// byte reading as utf8.RuneError in both, and two runes match when one
+// is in the other's unicode.SimpleFold orbit. It reports the bytes it
+// reads to meter every textStep bytes.
+func foldKey(s string, meter func(n int)) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	last := 0
+	// counted: the runes are reported every textStep bytes.
+	for i, r := range s {
+		if i-last >= textStep {
+			meter(i - last)
+			last = i
+		}
+		m := r
+		// bounded: a simple folding orbit holds at most a few runes.
+		for f := unicode.SimpleFold(r); f != r; f = unicode.SimpleFold(f) {
+			m = min(m, f)
+		}
+		b.WriteRune(m)
+	}
+	meter(len(s) - last)
+	return b.String()
+}
+
+// osaWithin returns the optimal string alignment distance of a and b over
+// bytes, as diag.Nearest computes it, when it is at most k (0 to
+// hintMaxDistance), and k+1 otherwise. It removes the common prefix and
+// suffix, which leaves the distance unchanged, fills only the cells within
+// k of the diagonal (a cell farther off holds more than k) and stops once
+// two consecutive rows exceed k, after which every later cell does too.
+func osaWithin(a, b string, k int, meter func(n int)) int {
+	p := commonPrefix(a, b, meter)
+	a, b = a[p:], b[p:]
+	q := commonSuffix(a, b, meter)
+	a, b = a[:len(a)-q], b[:len(b)-q]
+	if abs(len(a)-len(b)) > k {
+		return k + 1
+	}
+	if len(a) == 0 || len(b) == 0 {
+		return max(len(a), len(b))
+	}
+	const width = 2*hintMaxDistance + 1
+	inf := k + 1
+	// Row i holds d[i][j] at index j-i+k, for j within k of i.
+	var prev2, prev, cur [width]int
+	// bounded: the cells of one row of the band.
+	for x := range prev {
+		prev[x], prev2[x] = inf, inf
+	}
+	// bounded: at most k+1 cells.
+	for j := 0; j <= min(len(b), k); j++ {
+		prev[j+k] = j
+	}
+	prevMin := 0
+	// counted: the rows are reported every hintRowsPerCharge rows.
+	for i := 1; i <= len(a); i++ {
+		// bounded: the cells of one row of the band.
+		for x := range cur {
+			cur[x] = inf
+		}
+		rowMin := inf
+		// left is d[i][j-1], the cell before j in this row: inf before the
+		// band.
+		left := inf
+		// bounded: the 2k+1 cells of the band.
+		for j := max(0, i-k); j <= min(len(b), i+k); j++ {
+			x := j - i + k
+			v := i
+			if j > 0 {
+				cost := 1
+				if a[i-1] == b[j-1] {
+					cost = 0
+				}
+				v = min(prev[x]+cost, left+1)
+				if x+1 < width {
+					v = min(v, prev[x+1]+1)
+				}
+				if i > 1 && j > 1 && a[i-1] == b[j-2] && a[i-2] == b[j-1] {
+					v = min(v, prev2[x]+1)
+				}
+			}
+			cur[x] = min(v, inf)
+			left = cur[x]
+			rowMin = min(rowMin, cur[x])
+		}
+		if i%hintRowsPerCharge == 0 {
+			meter(hintRowsPerCharge * width)
+		}
+		if rowMin > k && prevMin > k {
+			meter((i % hintRowsPerCharge) * width)
+			return inf
+		}
+		prev2, prev, prevMin = prev, cur, rowMin
+	}
+	meter((len(a) % hintRowsPerCharge) * width)
+	return prev[len(b)-len(a)+k]
+}
+
+// commonPrefix returns the length of the longest common prefix of a and
+// b, comparing 64 bytes at a time and reporting the bytes to meter every
+// textStep bytes.
+func commonPrefix(a, b string, meter func(n int)) int {
+	n := min(len(a), len(b))
+	i, reported := 0, 0
+	// counted: the blocks are reported every textStep bytes.
+	for i+64 <= n && a[i:i+64] == b[i:i+64] {
+		if i += 64; i-reported >= textStep {
+			meter(i - reported)
+			reported = i
+		}
+	}
+	// bounded: fewer than 64 bytes past the last compared block.
+	for i < n && a[i] == b[i] {
+		i++
+	}
+	meter(i - reported)
+	return i
+}
+
+// commonSuffix returns the length of the longest common suffix of a and
+// b, comparing 64 bytes at a time and reporting the bytes to meter every
+// textStep bytes.
+func commonSuffix(a, b string, meter func(n int)) int {
+	n := min(len(a), len(b))
+	i, reported := 0, 0
+	// counted: the blocks are reported every textStep bytes.
+	for i+64 <= n && a[len(a)-i-64:len(a)-i] == b[len(b)-i-64:len(b)-i] {
+		if i += 64; i-reported >= textStep {
+			meter(i - reported)
+			reported = i
+		}
+	}
+	// bounded: fewer than 64 bytes past the last compared block.
+	for i < n && a[len(a)-i-1] == b[len(b)-i-1] {
+		i++
+	}
+	meter(i - reported)
+	return i
+}
+
+func abs(x int) int {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
diff --git a/internal/config/subst/hint_test.go b/internal/config/subst/hint_test.go
new file mode 100644
index 0000000..9c8bc30
--- /dev/null
+++ b/internal/config/subst/hint_test.go
@@ -0,0 +1,357 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package subst
+
+import (
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// referenceOSA is the full-table optimal string alignment distance over
+// bytes, as diag.Nearest computes it.
+func referenceOSA(a, b string) int {
+	d := make([][]int, len(a)+1)
+	for i := range d {
+		d[i] = make([]int, len(b)+1)
+		d[i][0] = i
+	}
+	for j := range d[0] {
+		d[0][j] = j
+	}
+	for i := 1; i <= len(a); i++ {
+		for j := 1; j <= len(b); j++ {
+			cost := 1
+			if a[i-1] == b[j-1] {
+				cost = 0
+			}
+			d[i][j] = min(d[i-1][j]+1, d[i][j-1]+1, d[i-1][j-1]+cost)
+			if i > 1 && j > 1 && a[i-1] == b[j-2] && a[i-2] == b[j-1] {
+				d[i][j] = min(d[i][j], d[i-2][j-2]+1)
+			}
+		}
+	}
+	return d[len(a)][len(b)]
+}
+
+func noMeter(int) {}
+
+// TestOSAWithin covers the banded distance of the hint search (review
+// finding on the quadratic hint): osaWithin(a, b, k) is min(OSA(a, b),
+// k+1) for every pair of strings up to length 5 over a three-letter
+// alphabet and every k, so the common prefix and suffix removal, the
+// band and the early stop never change the answer.
+func TestOSAWithin(t *testing.T) {
+	var words []string
+	var gen func(prefix string)
+	gen = func(prefix string) {
+		words = append(words, prefix)
+		if len(prefix) == 5 {
+			return
+		}
+		for _, c := range "abc" {
+			gen(prefix + string(c))
+		}
+	}
+	gen("")
+	for _, a := range words {
+		for _, b := range words {
+			want := referenceOSA(a, b)
+			for k := 0; k <= hintMaxDistance; k++ {
+				if got := osaWithin(a, b, k, noMeter); got != min(want, k+1) {
+					t.Fatalf("osaWithin(%q, %q, %d) = %d, want %d", a, b, k, got, min(want, k+1))
+				}
+			}
+		}
+	}
+}
+
+// TestOSAEarlyStop: the distance table stops once two rows exceed the
+// limit, so names that differ in their first bytes cost a few rows, not
+// one per byte, while TestOSAWithin shows the stop never changes the
+// answer.
+func TestOSAEarlyStop(t *testing.T) {
+	const l = 100_000
+	a := "WXYZ" + strings.Repeat("A", l) + "Q"
+	b := "BCDE" + strings.Repeat("A", l) + "R"
+	for k := 0; k <= hintMaxDistance; k++ {
+		read := 0
+		if d := osaWithin(a, b, k, func(n int) { read += n }); d != k+1 {
+			t.Fatalf("osaWithin(k=%d) = %d, want %d", k, d, k+1)
+		}
+		if read > 16*(2*hintMaxDistance+1) {
+			t.Errorf("k=%d: %d cells read for names that differ in their first bytes, want a few rows", k, read)
+		}
+	}
+}
+
+// TestOSAAffix: the common prefix and suffix are compared at memory
+// speed and leave the table only the bytes between, so near-identical
+// long names cost about one read of the name, not a row per byte, while
+// TestOSAWithin shows the removal never changes the answer.
+func TestOSAAffix(t *testing.T) {
+	const l = 100_000
+	for name, pair := range map[string][2]string{
+		"differ at the end":    {strings.Repeat("A", l) + "X", strings.Repeat("A", l) + "Y"},
+		"differ at the start":  {"X" + strings.Repeat("A", l), "Y" + strings.Repeat("A", l)},
+		"differ in the middle": {strings.Repeat("A", l) + "XY" + strings.Repeat("B", l), strings.Repeat("A", l) + "YX" + strings.Repeat("B", l)},
+	} {
+		read := 0
+		if d := osaWithin(pair[0], pair[1], hintMaxDistance, func(n int) { read += n }); d != 1 {
+			t.Errorf("%s: distance %d, want 1", name, d)
+		}
+		if limit := len(pair[0]) + 64; read > limit {
+			t.Errorf("%s: %d bytes and cells read, want at most %d", name, read, limit)
+		}
+	}
+}
+
+// TestCommonAffix compares the chunked prefix and suffix scans with a
+// byte loop for every length up to 200 and every position of the first
+// mismatch, around the 64-byte chunks.
+func TestCommonAffix(t *testing.T) {
+	naivePrefix := func(a, b string) int {
+		i := 0
+		for i < len(a) && i < len(b) && a[i] == b[i] {
+			i++
+		}
+		return i
+	}
+	naiveSuffix := func(a, b string) int {
+		i := 0
+		for i < len(a) && i < len(b) && a[len(a)-1-i] == b[len(b)-1-i] {
+			i++
+		}
+		return i
+	}
+	for n := 0; n <= 200; n++ {
+		base := strings.Repeat("A", n)
+		for at := 0; at <= n; at++ {
+			b := base
+			if at < n {
+				b = base[:at] + "B" + base[at+1:]
+			}
+			for _, extra := range []string{"", "AA", "C"} {
+				x, y := base+extra, b
+				if got, want := commonPrefix(x, y, noMeter), naivePrefix(x, y); got != want {
+					t.Fatalf("commonPrefix(len %d, mismatch at %d, %q) = %d, want %d", n, at, extra, got, want)
+				}
+				x, y = extra+base, b
+				if got, want := commonSuffix(x, y, noMeter), naiveSuffix(x, y); got != want {
+					t.Fatalf("commonSuffix(len %d, mismatch at %d, %q) = %d, want %d", n, at, extra, got, want)
+				}
+			}
+		}
+	}
+	a, b := "X"+strings.Repeat("A", 200)+"P", "Y"+strings.Repeat("A", 200)+"Q"
+	if d := osaWithin(a, b, hintMaxDistance, noMeter); d != 2 {
+		t.Errorf("long names differing at both ends: distance %d, want 2", d)
+	}
+}
+
+// hintCase is one HintNames list and the names to look up in it.
+type hintCase struct {
+	name  string
+	hints []string
+	look  []string
+}
+
+func hintCases() []hintCase {
+	var many []string
+	for i := range 70 {
+		many = append(many, "V"+strconv.Itoa(100+i))
+	}
+	var lengths []string
+	for l := 1; l <= 12; l++ {
+		lengths = append(lengths, strings.Repeat("B", l))
+	}
+	return []hintCase{
+		{"no names", nil, []string{"A", "ABC"}},
+		{"case-insensitive match first", []string{"db_host", "DB_HOSTS", "DB_HOST"}, []string{"DB_HOST", "Db_Host", "db_hosT"}},
+		{"Kelvin sign and long s fold to ASCII", []string{"\u212Aey", "\u017Fecret", "kez"}, []string{"KEY", "key", "SECRET", "Secret", "SECRE"}},
+		{"a fold match beats a nearer name", []string{"SECREX", "\u017Fecret", "KEX", "\u212Aey"}, []string{"SECRET", "secret", "KEY"}},
+		{"invalid bytes and the replacement rune", []string{"A\xffB", "A\uFFFDC", "A\xfeD"}, []string{"AB", "ACX"}},
+		{"non-ASCII names lower to other lengths", []string{"\u0130STANBUL", "ISTANBUL_", "\u00C9T\u00C9"}, []string{"ISTANBUL", "ETE", "ISTANBUX"}},
+		{"distance limit by length", []string{"AB", "ABCDEF", "ABCDEFGHI", "ABCDEFGHIJKL"}, []string{"AX", "XY", "ABCXYZ", "ABCDEFXYZ", "ABCDXXXXIJKL", "ABCDEFXXXJKL"}},
+		{"ties broken by byte order", []string{"ABD", "ABE", "ABC_"}, []string{"ABX", "ABCX"}},
+		{"transpositions", []string{"PORT_HTTP", "HOST_NAME"}, []string{"PORT_HTPT", "HSOT_NAME", "OPRT_HTTP"}},
+		{"more than 64 length-compatible names", append(slices.Clone(many), "ABCX"), []string{"ABCD", "V1000", "V10"}},
+		{"length window of 3 bytes", lengths, []string{"BBBBB", "BBBBBBBBC", "C", "BBBBBBBBBBBBBBBB"}},
+		{"common prefix and suffix", []string{"PREFIX_A_SUFFIX", "PREFIX_BC_SUFFIX", "PREFIX__SUFFIX"}, []string{"PREFIX_X_SUFFIX", "PREFIX_CB_SUFFIX", "PREFIXSUFFIX"}},
+		{"names that differ at both ends", []string{"XAAAAAAAAY", "ZAAAAAAAAW"}, []string{"YAAAAAAAAX", "XAAAAAAAAW", "QAAAAAAAAQ"}},
+		{"no candidate within the limit", []string{"ALPHA", "BRAVO"}, []string{"ZULU_", "OMEGA"}},
+		{"empty undefined name", []string{"A", ""}, []string{""}},
+	}
+}
+
+// TestHintsMatchNearest covers 01 req 27 (review finding on the hint
+// cost): the bounded hint search gives exactly diag.Nearest's answer
+// over the sorted, deduplicated HintNames, in every case diag.Nearest
+// distinguishes (case-insensitive match first, simple folding beyond
+// ASCII, invalid bytes, the length-dependent limit, ties, transpositions,
+// the 64-name and 3-byte windows), and the memo answers a name the same
+// way twice.
+func TestHintsMatchNearest(t *testing.T) {
+	for _, tc := range hintCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			names := slices.Compact(slices.Sorted(slices.Values(tc.hints)))
+			// The hint search sorts and deduplicates the names itself.
+			h := newHints(append(reversed(tc.hints), tc.hints...), 100)
+			for _, name := range tc.look {
+				for round := range 2 {
+					got, ok := h.nearest(name, noMeter)
+					want, wok := diag.Nearest(name, names)
+					if !wok {
+						want = ""
+					}
+					if got != want || ok != wok {
+						t.Errorf("round %d: nearest(%q) = %q, %v; diag.Nearest gives %q, %v", round, name, got, ok, want, wok)
+					}
+				}
+			}
+		})
+	}
+}
+
+// FuzzHints is the differential property of the hint search: for any
+// variable name of the 01 req 26 grammar and any HintNames, hints gives
+// diag.Nearest's answer.
+func FuzzHints(f *testing.F) {
+	for _, tc := range hintCases() {
+		for _, name := range tc.look {
+			f.Add(name, strings.Join(tc.hints, ","))
+		}
+	}
+	f.Fuzz(func(t *testing.T, name, list string) {
+		if len(name)+len(list) > 4096 || nameLen(name) != len(name) {
+			return
+		}
+		raw := strings.Split(list, ",")
+		names := slices.Compact(slices.Sorted(slices.Values(raw)))
+		got, ok := newHints(raw, 4).nearest(name, noMeter)
+		want, wok := diag.Nearest(name, names)
+		if !wok {
+			want = ""
+		}
+		if got != want || ok != wok {
+			t.Fatalf("nearest(%q) over %q = %q, %v; diag.Nearest gives %q, %v", name, names, got, ok, want, wok)
+		}
+	})
+}
+
+// endNames returns the 64 names diag.Nearest compares, of length l, that
+// each differ from "C"+"A"*(l-2)+"C" in both end bytes, so the distance
+// table runs over the whole name: nothing common to remove, no early stop
+// before the end.
+func endNames(l int) []string {
+	out := make([]string, hintCompared)
+	for i := range out {
+		c := string(rune('D' + i%20))
+		out[i] = c + strings.Repeat("A", l-2-i/20) + c + strings.Repeat("Q", i/20)
+	}
+	return out
+}
+
+// prefixNames returns k distinct names of length l that share their
+// first l-6 bytes with "A"*l: a case-insensitive comparison of each with
+// an undefined "A"*l reads l-6 bytes before it differs.
+func prefixNames(k, l int) []string {
+	out := make([]string, k)
+	for i := range out {
+		out[i] = strings.Repeat("A", l-6) + "B" + fmt4(i) + "B"
+	}
+	return out
+}
+
+// TestHintCost covers the review finding on the hint cost (01 req 27, 54
+// and risk 1): the hint of a long undefined name, compared against long
+// near names, allocates a bounded number of objects (diag.Nearest
+// allocates one table row per byte of the name, at every occurrence), and
+// its work is linear in the name: 64 names times the 7-cell band per
+// byte at most, plus one read of the name for the case-insensitive match
+// however many names share a long prefix with it (diag.Nearest's
+// strings.EqualFold pass reads every name). The work units also bound
+// repeated uses: each later use of a name costs a lookup, not a new
+// search.
+func TestHintCost(t *testing.T) {
+	ends := "C" + strings.Repeat("A", 1998) + "C"
+	for _, tc := range []struct {
+		label, name string
+		hints       []string
+		uses        int
+	}{
+		{"near the last byte", ends, nearNames(2000), 1},
+		{"differing at both ends", ends, endNames(2000), 1},
+		{"differing at both ends, used 50 times", ends, endNames(2000), 50},
+		{"longer than every name", ends, []string{"A", "B"}, 1},
+		{"20000 names sharing a long prefix", strings.Repeat("A", 200), prefixNames(20_000, 200), 1},
+		{"20000 shorter names sharing a long prefix", strings.Repeat("A", 2000), prefixNames(20_000, 200), 1},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			l := len(tc.name)
+			src := labelsRoute(tc.uses, keyN, func(int) string { return "${" + tc.name + "}" })
+			s := New(Options{Schemas: schemas(t), HintNames: tc.hints})
+			rs := []*tree.Resource{docs(t, &tree.FileTable{}, "r.yaml", src)[0], docs(t, &tree.FileTable{}, "r.yaml", src)[0]}
+			i := 0
+			allocs := testing.AllocsPerRun(1, func() {
+				ds := s.Apply(rs[i])
+				i++
+				if len(ds) != tc.uses {
+					t.Fatalf("%d diagnostics, want %d", len(ds), tc.uses)
+				}
+			})
+			if limit := float64(64 + 16*tc.uses); allocs > limit {
+				t.Errorf("%.0f allocations for %d uses of a %d-byte name, want at most %.0f", allocs, tc.uses, l, limit)
+			}
+			calls := 0
+			w := &walker{s: New(Options{Schemas: schemas(t), HintNames: tc.hints}), yield: func() { calls++ }}
+			// The index over the names is built once per Substituter and
+			// counted to the first use (TestHintIndexSpread): build it first.
+			w.s.hints.index(noMeter)
+			for range tc.uses {
+				w.undefined(&tree.Node{}, tc.name)
+			}
+			units := calls*yieldEvery + w.units
+			if limit := (64*7*l+16*l*tc.uses)/byteUnit + 4; units > limit {
+				t.Errorf("%d work units for %d uses, want at most %d", units, tc.uses, limit)
+			}
+		})
+	}
+}
+
+// TestHintMemo: a name is searched once per Substituter, whichever
+// resource and worker uses it, and the memo keeps at most memoMax names
+// while answers beyond it stay exact.
+func TestHintMemo(t *testing.T) {
+	const l = 400
+	name := "C" + strings.Repeat("A", l-2) + "C"
+	h := newHints(endNames(l), 2)
+	cost := func(name string) int {
+		n := 0
+		_, _ = h.nearest(name, func(k int) { n += k })
+		return n
+	}
+	first, second := cost(name), cost(name)
+	if first < 64*l || second > 2*l {
+		t.Errorf("searching %d bytes, then %d bytes for the same name: want a search (at least %d) and then a lookup (at most %d)", first, second, 64*l, 2*l)
+	}
+	other := "D" + strings.Repeat("A", l-2) + "E"
+	third := "E" + strings.Repeat("A", l-2) + "F"
+	_ = cost(other)
+	full := cost(third)
+	if len(h.memo) != 2 {
+		t.Errorf("memo holds %d names, want memoMax = 2", len(h.memo))
+	}
+	if again := cost(third); again != full || again <= 2*l {
+		t.Errorf("a name past memoMax cost %d, then %d: want the same search again, not a lookup", full, again)
+	}
+	want, wok := diag.Nearest(third, h.index(noMeter).names)
+	if got, ok := h.nearest(third, noMeter); got != want || ok != wok {
+		t.Errorf("a name past memoMax: nearest = %q, %v; diag.Nearest gives %q, %v", got, ok, want, wok)
+	}
+}
diff --git a/internal/config/subst/limits_test.go b/internal/config/subst/limits_test.go
new file mode 100644
index 0000000..3c36a28
--- /dev/null
+++ b/internal/config/subst/limits_test.go
@@ -0,0 +1,438 @@
+// Copyright 2026 Revington
+// SPDX-License-Identifier: Apache-2.0
+
+package subst
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/ravindu-rev/ruralz/internal/config/diag"
+	"github.com/ravindu-rev/ruralz/internal/config/tree"
+)
+
+// repeat joins n texts f(i) with sep.
+func repeat(n int, sep string, f func(i int) string) string {
+	parts := make([]string, n)
+	for i := range parts {
+		parts[i] = f(i)
+	}
+	return strings.Join(parts, sep)
+}
+
+// labelsRoute is a Route whose metadata.labels hold n members k<i>: v(i),
+// both JSON-safe.
+func labelsRoute(n int, key, v func(i int) string) string {
+	labels := repeat(n, ",", func(i int) string { return quote(key(i)) + ":" + quote(v(i)) })
+	return `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r","labels":{` + labels + `}},"spec":{}}`
+}
+
+func keyN(i int) string { return "k" + strconv.Itoa(i) }
+
+// raceScaled returns full, or race in a test binary built with -race
+// (raceEnabled): a size the asymptotic checks still measure.
+func raceScaled(full, race int) int {
+	if raceEnabled {
+		return race
+	}
+	return full
+}
+
+// testBudget is the diagnostic budget TestDiagnosticBudget sets:
+// DefaultMaxDiagnostics, or a tenth of it under -race, where the budget
+// check, which needs some multiple of it in occurrences, runs at that
+// size (TestMaxDiagnosticsOption covers a budget other than the default).
+func testBudget() int { return raceScaled(DefaultMaxDiagnostics, DefaultMaxDiagnostics/10) }
+
+// substProducer builds a resource with k occurrences of one stage E
+// diagnostic. list marks a producer whose occurrences are list elements
+// past which, once the budget is spent, the walk does no work.
+type substProducer struct {
+	name, code string
+	build      func(k int) string
+	list       bool
+}
+
+func substProducers() []substProducer {
+	return []substProducer{
+		{"req27 undefined variables in one scalar", CodeUndefined, func(k int) string {
+			return prefixRoute(strings.Repeat("${X}", k))
+		}, false},
+		{"req27 undefined variables in many scalars", CodeUndefined, func(k int) string {
+			return labelsRoute(k, keyN, func(int) string { return "${U}" })
+		}, false},
+		{"req30 secret-like names in one scalar", CodeWarning, func(k int) string {
+			return prefixRoute(strings.Repeat("${TOKEN:-}", k))
+		}, false},
+		{"req26 malformed scalars", CodeMalformed, func(k int) string {
+			return labelsRoute(k, keyN, func(int) string { return "${" })
+		}, false},
+		{"req28 expressions in mapping keys", CodeForbidden, func(k int) string {
+			return labelsRoute(k, func(i int) string { return "${K" + strconv.Itoa(i) + "}" }, func(int) string { return "v" })
+		}, false},
+		{"req28 expressions in reference fields", CodeForbidden, func(k int) string {
+			ups := repeat(k, ",", func(i int) string { return `{"name":"${A` + strconv.Itoa(i) + `}"}` })
+			return `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r"},"spec":{"upstreams":[` + ups + `]}}`
+		}, true},
+		{"J013 credential-shaped literals", CodeWarning, func(k int) string {
+			return labelsRoute(k, keyN, func(int) string { return "AKIAABCDEFGHIJKLMNOP" })
+		}, false},
+		{"J013 credential header literals", CodeWarning, func(k int) string {
+			set := repeat(k, ",", func(i int) string { return `{"name":"authorization","value":"v` + strconv.Itoa(i) + `"}` })
+			return `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"h"},"spec":{"type":"headers","config":{"request":{"set":[` + set + `]}}}}`
+		}, true},
+	}
+}
+
+// TestDiagnosticBudget covers 01 req 50 and risk 1 (review finding): one
+// Apply call records the first MaxDiagnostics+1 diagnostics in walk
+// order, warnings included, so the caller's cap appends its RZ-CFG-001,
+// and stops, so a resource with many more occurrences allocates no more.
+// Every producer of a per-occurrence diagnostic is one row. The budget is
+// the default one, but under -race (testBudget).
+func TestDiagnosticBudget(t *testing.T) {
+	budget := testBudget()
+	k := budget + 50
+	for _, p := range substProducers() {
+		t.Run(p.name, func(t *testing.T) {
+			s := New(Options{Schemas: schemas(t), MaxDiagnostics: budget})
+			parse := func(k int) *tree.Resource {
+				return docs(t, &tree.FileTable{}, "r.yaml", p.build(k))[0]
+			}
+			ds := s.Apply(parse(k))
+			if len(ds) != budget+1 {
+				t.Fatalf("%d diagnostics, want %d", len(ds), budget+1)
+			}
+			for i, d := range ds {
+				if d.Code != p.code {
+					t.Fatalf("diagnostic %d is %s, want %s", i, d.AppendText(nil), p.code)
+				}
+			}
+			c := diag.NewCollector(budget)
+			c.AddAll(ds)
+			if l := c.List(); len(l) != budget+1 || !c.Full() || l.FirstErrorCode() != "RZ-CFG-001" {
+				t.Errorf("a collector with the same cap kept %d diagnostics (full %v, first error %s), want %d and RZ-CFG-001",
+					len(l), c.Full(), l.FirstErrorCode(), budget+1)
+			}
+			allocs := func(k int) float64 {
+				rs := []*tree.Resource{parse(k), parse(k)}
+				i := 0
+				return testing.AllocsPerRun(1, func() {
+					_ = s.Apply(rs[i])
+					i++
+				})
+			}
+			if a1, a2 := allocs(k), allocs(2*k); a2 > a1+float64(k/8) {
+				t.Errorf("%.0f allocations for %d occurrences, %.0f for %d: the walk goes on past the budget", a1, k, a2, 2*k)
+			}
+			if !p.list {
+				return
+			}
+			units := func(k int) int {
+				calls := 0
+				_ = New(Options{Schemas: schemas(t), MaxDiagnostics: budget, Yield: func() { calls++ }}).Apply(parse(k))
+				return calls
+			}
+			if w1, w2 := units(k), units(2*k); w2 > w1+2 {
+				t.Errorf("%d Yield calls for %d occurrences, %d for %d: the walk goes on past the budget", w1, k, w2, 2*k)
+			}
+		})
+	}
+}
+
+// TestReportAfterBudget: once the diagnostic beyond the budget is
+// recorded, report records nothing more, whatever still calls it.
+func TestReportAfterBudget(t *testing.T) {
+	w := &walker{s: New(Options{MaxDiagnostics: 1})}
+	for range 3 {
+		w.report(diag.Diagnostic{Code: CodeUndefined})
+	}
+	if len(w.diags) != 2 || !w.full {
+		t.Errorf("%d diagnostics recorded (full %v), want 2 and full", len(w.diags), w.full)
+	}
+}
+
+// TestMaxDiagnosticsOption: Options.MaxDiagnostics sets the budget and the
+// first diagnostics in walk order are kept, one more than the budget when
+// the input has more; the scalar that reached it keeps its authored text.
+func TestMaxDiagnosticsOption(t *testing.T) {
+	src := prefixRoute("${A}${B}${C}${D}${E}")
+	for _, tc := range []struct {
+		max  int
+		want string
+	}{
+		{3, "A B C D"},
+		{5, "A B C D E"},
+		{0, "A B C D E"},
+	} {
+		r := docs(t, &tree.FileTable{}, "r.yaml", src)[0]
+		ds := New(Options{Schemas: schemas(t), MaxDiagnostics: tc.max}).Apply(r)
+		var got []string
+		for _, d := range ds {
+			got = append(got, strings.TrimSuffix(strings.TrimPrefix(d.Message, `variable "`), `" is not defined and has no default`))
+		}
+		if g := strings.Join(got, " "); g != tc.want {
+			t.Errorf("MaxDiagnostics %d: %s, want %s", tc.max, g, tc.want)
+		}
+		if text := at(t, r.Root, "spec.match.path.prefix").Text; text != "${A}${B}${C}${D}${E}" {
+			t.Errorf("MaxDiagnostics %d: text %q, want the authored text", tc.max, text)
+		}
+	}
+}
+
+// scaleShape is a stage E input of size n for the scale tests.
+type scaleShape struct {
+	name string
+	// code is the only error code the shape raises, "" for none, and also
+	// a second one it raises beside it.
+	code, also string
+	build      func(n int) string
+	// vars are the variables (Map{"A": "a"} when nil) and hints the
+	// HintNames.
+	vars  Map
+	hints func(n int) []string
+}
+
+// nearNames returns the 64 names diag.Nearest compares, of length l,
+// that differ from "A"*l in their last byte, so each is one edit away
+// from an undefined "A"*(l-1)+"C" and none matches it case-insensitively.
+func nearNames(l int) []string {
+	out := make([]string, hintCompared)
+	for i := range out {
+		out[i] = strings.Repeat("A", l-1) + string(rune('D'+i%20)) + strings.Repeat("Q", i/20)
+	}
+	return out
+}
+
+// scaleShapes are stage E inputs of size n that cost quadratic time when
+// a lookup or a search re-reads earlier work per item (review findings:
+// the Vars dedupe scanned every earlier name per expression; the lenient
+// re-read of a malformed scalar searched to its end at each ${; the
+// RZ-CFG-010 hint compared names in a full table, at every occurrence).
+// Each shape's size is linear in n, in bytes as in items.
+func scaleShapes() []scaleShape {
+	return []scaleShape{
+		{name: "distinct variables in one scalar", build: func(n int) string {
+			return prefixRoute(repeat(n, "", func(i int) string { return "${V" + strconv.Itoa(i) + ":-}" }))
+		}},
+		{name: "one variable repeated in one scalar", build: func(n int) string {
+			return prefixRoute(strings.Repeat("${A}", n))
+		}},
+		{name: "labels with expressions", build: func(n int) string {
+			return labelsRoute(n, keyN, func(i int) string { return "a${A}" + strconv.Itoa(i) })
+		}},
+		{name: "credential header entries", build: func(n int) string {
+			set := repeat(n, ",", func(int) string { return `{"name":"x-api-key","value":"${A}"}` })
+			return `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"h"},"spec":{"type":"headers","config":{"request":{"set":[` + set + `]}}}}`
+		}},
+		// 01 req 54, S14 hostile input: malformed scalars, which the
+		// credential detectors re-read leniently.
+		{name: "S14 unterminated defaults", code: CodeMalformed, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${A:-", 16*n))
+		}},
+		{name: "S14 nested defaults closed at the end", code: CodeMalformed, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${A:-", 16*n) + "}")
+		}},
+		{name: "S14 nested defaults each closed", code: CodeMalformed, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${A:-", 8*n) + strings.Repeat("}", 8*n))
+		}},
+		{name: "S14 long names without a brace", code: CodeMalformed, build: func(n int) string {
+			return prefixRoute(repeat(4*n, " ", func(int) string { return "${" + strings.Repeat("N", 64) }))
+		}},
+		{name: "S14 one long name without a brace", code: CodeMalformed, build: func(n int) string {
+			return prefixRoute("${" + strings.Repeat("N", 256*n))
+		}},
+		// B is defined: the lenient read of ${A:-${B}} uses it (01 req 27),
+		// which the next shape covers.
+		{name: "S14 every malformed form repeated", code: CodeMalformed, vars: Map{"A": "a", "B": "b"}, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${1X} ${X-d} ${X:=d} ${A:-${B}} ${ ", 4*n))
+		}},
+		// 01 req 27 in a malformed scalar (review finding): each
+		// well-formed use of an undefined variable, read leniently, is one
+		// RZ-CFG-010 beside the scalar's RZ-CFG-005.
+		{name: "req27 undefined uses in a malformed scalar", code: CodeMalformed, also: CodeUndefined, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${U} ${A:-${V}} ", n) + "${")
+		}},
+		{name: "S14 malformed scalars in many labels", code: CodeMalformed, build: func(n int) string {
+			return labelsRoute(n, keyN, func(int) string { return strings.Repeat("${A:-", 16) })
+		}},
+		// 01 req 27 and 54: the RZ-CFG-010 hint over long names.
+		{
+			name: "req27 one long undefined name with near hints", code: CodeUndefined,
+			build: func(n int) string { return prefixRoute("${" + strings.Repeat("A", 4*n-1) + "C}") },
+			hints: func(n int) []string { return nearNames(4 * n) },
+		},
+		{
+			name: "req27 one long undefined name differing at both ends from every hint", code: CodeUndefined,
+			build: func(n int) string { return prefixRoute("${C" + strings.Repeat("A", 4*n-2) + "C}") },
+			hints: func(n int) []string { return endNames(4 * n) },
+		},
+		{
+			name: "req27 a long undefined name used many times", code: CodeUndefined,
+			build: func(n int) string {
+				return labelsRoute(n/8, keyN, func(int) string { return "${" + strings.Repeat("A", 1023) + "C}" })
+			},
+			hints: func(int) []string { return nearNames(1024) },
+		},
+		{
+			name: "req27 distinct undefined names with near hints", code: CodeUndefined,
+			build: func(n int) string {
+				return labelsRoute(n, keyN, func(i int) string { return "${" + strings.Repeat("A", 59) + "C" + fmt4(i) + "}" })
+			},
+			hints: func(int) []string { return nearNames(64) },
+		},
+		// 01 req 6 and 54: the text written grows with the uses of a value.
+		{name: "req6 a 1 KiB value used many times", vars: Map{"A": strings.Repeat("v", 1024)}, build: func(n int) string {
+			return prefixRoute(strings.Repeat("${A}", n))
+		}},
+	}
+}
+
+// fmt4 is i as four decimal digits.
+func fmt4(i int) string {
+	s := strconv.Itoa(10000 + i%10000)
+	return s[1:]
+}
+
+// work returns the Yield calls of one Apply over shape at size n: Yield
+// runs every 256 work units, so the count measures the work without a
+// clock.
+func work(t *testing.T, sh scaleShape, n int) int {
+	t.Helper()
+	calls := 0
+	s := New(sh.options(t, n, func() { calls++ }))
+	r := docs(t, &tree.FileTable{}, "r.yaml", sh.build(n))[0]
+	for _, d := range s.Apply(r) {
+		if d.Severity == diag.SeverityError && d.Code != sh.code && (sh.also == "" || d.Code != sh.also) {
+			t.Fatalf("%s", d.AppendText(nil))
+		}
+	}
+	return calls
+}
+
+// options returns the Options of shape sh at size n.
+func (sh scaleShape) options(t testing.TB, n int, yield func()) Options {
+	t.Helper()
+	vars := sh.vars
+	if vars == nil {
+		vars = Map{"A": "a"}
+	}
+	var hints []string
+	if sh.hints != nil {
+		hints = sh.hints(n)
+	}
+	return Options{Schemas: schemas(t), Variables: vars, HintNames: hints, Yield: yield}
+}
+
+// TestScaleLinear covers the review findings on quadratic stage E work
+// (01 req 54, S14 hostile input): four times the input costs at most
+// about four times the work units, which count every node, segment,
+// variable name compared and byte read, written or compared, so a search
+// re-reading earlier text or a dedupe scanning every earlier name costs
+// sixteen times.
+func TestScaleLinear(t *testing.T) {
+	n := raceScaled(2000, 500)
+	for _, sh := range scaleShapes() {
+		t.Run(sh.name, func(t *testing.T) {
+			w1, w4 := work(t, sh, n), work(t, sh, 4*n)
+			t.Logf("%d Yield calls at n=%d, %d at n=%d (ratio %.2f)", w1, n, w4, 4*n, float64(w4)/float64(w1))
+			if w1 < n/yieldEvery {
+				t.Fatalf("%d work units at n=%d: the shape does too little to measure", w1*yieldEvery, n)
+			}
+			if w4 > 4*w1+w1/2+4 {
+				t.Errorf("work grows faster than the input: %d Yield calls at n=%d, %d at n=%d (ratio %.1f, want about 4)",
+					w1, n, w4, 4*n, float64(w4)/float64(w1))
+			}
+		})
+	}
+}
+
+// TestYield covers 01 req 53 (review finding): Apply calls Options.Yield
+// every 256 work units inside one resource, a node, a segment, a name
+// compared or byteUnit bytes each counting one or more, and never without
+// a Yield set.
+func TestYield(t *testing.T) {
+	const n = 1024
+	for _, sh := range scaleShapes() {
+		calls := 0
+		s := New(sh.options(t, n, func() { calls++ }))
+		_ = s.Apply(docs(t, &tree.FileTable{}, "r.yaml", sh.build(n))[0])
+		if calls < n/yieldEvery {
+			t.Errorf("%s: %d Yield calls for %d items, want at least %d", sh.name, calls, n, n/yieldEvery)
+		}
+	}
+	if ds := New(Options{Schemas: schemas(t)}).Apply(docs(t, &tree.FileTable{}, "r.yaml", scaleShapes()[0].build(n))[0]); len(ds) != 0 {
+		t.Errorf("without Yield: %q", texts(ds))
+	}
+}
+
+// TestYieldInsideLongScalar covers 01 req 53 inside one node (review
+// finding: a malformed scalar of several MiB was one unit of work, so
+// Yield never ran while it was scanned): the scan reports the bytes it
+// reads at least every searchWindow bytes, so a single scalar of 4 MiB
+// yields many times before the walk reaches its next node.
+func TestYieldInsideLongScalar(t *testing.T) {
+	size := raceScaled(4<<20, 1<<20)
+	for name, text := range map[string]string{
+		"unterminated defaults": strings.Repeat("${A:-", size/5),
+		"one long name":         "${" + strings.Repeat("N", size),
+		"a literal":             strings.Repeat("x", size) + "${A}",
+		"nested defaults":       strings.Repeat("${A:-", size/5) + "}",
+	} {
+		var calls []int
+		s := New(Options{Schemas: schemas(t), Variables: Map{"A": "a"}})
+		r := docs(t, &tree.FileTable{}, "r.yaml", prefixRoute(text))[0]
+		n := at(t, r.Root, "spec.match.path.prefix")
+		w := &walker{s: s, id: r.ID, yield: func() { calls = append(calls, len(calls)) }}
+		w.scalar(n, place{})
+		if least := size / byteUnit / yieldEvery; len(calls) < least {
+			t.Errorf("%s: %d Yield calls inside one %d-byte scalar, want at least %d", name, len(calls), size, least)
+		}
+	}
+}
+
+// TestSearchWindow: every search of the scan reports what it read at
+// least every searchWindow bytes, so a long scalar yields while one
+// search crosses it, not only after (01 req 53), and the reports add up
+// to a bounded number of reads per byte, in both modes.
+func TestSearchWindow(t *testing.T) {
+	const size = 1 << 20
+	for name, text := range map[string]string{
+		"a literal":                   strings.Repeat("x", size),
+		"one unterminated default":    "${A:-" + strings.Repeat("x", size),
+		"a default closed at the end": "${A:-" + strings.Repeat("x", size) + "}",
+		"one long name":               "${" + strings.Repeat("N", size),
+	} {
+		for _, lenient := range []bool{false, true} {
+			largest, total := 0, 0
+			scanEach(text, lenient, func(n int) {
+				largest = max(largest, n)
+				total += n
+			}, func(segment) bool { return true })
+			if largest > searchWindow+1 {
+				t.Errorf("%s (lenient %v): one report of %d bytes, want at most %d", name, lenient, largest, searchWindow+1)
+			}
+			if total > 3*len(text) {
+				t.Errorf("%s (lenient %v): %d bytes read for %d", name, lenient, total, len(text))
+			}
+		}
+	}
+}
+
+// BenchmarkScaleShapes substitutes each scaleShapes input at 10,000 items.
+func BenchmarkScaleShapes(b *testing.B) {
+	for _, sh := range scaleShapes() {
+		b.Run(sh.name, func(b *testing.B) {
+			s := New(sh.options(b, 10_000, nil))
+			r := docs(b, &tree.FileTable{}, "r.yaml", sh.build(10_000))[0]
+			b.ReportAllocs()
+			for range b.N {
+				b.StopTimer()
+				c := &tree.Resource{ID: r.ID, APIVersion: r.APIVersion, Root: r.Root.Clone()}
+				b.StartTimer()
+				_ = s.Apply(c)
+			}
+		})
+	}
+}
