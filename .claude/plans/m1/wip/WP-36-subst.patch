+// TestAuthoredReading covers the reading of the 01 J row for 013 (review
+// finding: the detectors read substituted text on success and literal
+// segments on error, and a default counted only when taken and whenever
+// it was not empty): both credential rules read the authored runs, the
+// literal text and every default whether taken or not, cut at each
+// expression without default, never a variable's value, so a detector's
+// result never depends on the Environment or on another expression
+// failing, and a default that is only framing frames like literal text.
+// The header literal rule also reads where each expression takes its
+// text from: a value whose runs are only framing is a literal unless some
+// expression takes its text from the variable source rather than from a
+// default, so "${A:-;}" warns when A is unset or empty and not when A is
+// set (the rows marked origin).
+func TestAuthoredReading(t *testing.T) {
+	annotation := func(text string) string {
+		return `{"apiVersion":"ruralz/v1alpha1","kind":"Route","metadata":{"name":"r","annotations":{"note":` + quote(text) + `}},"spec":{}}`
+	}
+	header := func(name, value string) string {
+		return `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"h"},"spec":{"type":"headers","config":{"request":{"set":[{"name":"` + name + `","value":` + quote(value) + `}]}}}}`
+	}
+	const url = "URL with a password"
+	const literalHeader = "literal value for the credential header"
+	cases := []struct {
+		name, src string
+		vars      Map
+		// want is the message of each RZ-CFG-013 warning, the codes of
+		// the errors besides.
+		want, errs []string
+	}{
+		{"J013 a credential default not taken warns", annotation("${E:-https://u:p@h}"), Map{"E": "https://example"}, []string{url}, nil},
+		{"J013 a credential default taken warns", annotation("${E:-https://u:p@h}"), nil, []string{url}, nil},
+		{"J013 a credential header default not taken warns", header("authorization", "${H:-hunter2}"), Map{"H": "v"}, []string{literalHeader}, nil},
+		{"J013 a credential header default taken warns", header("authorization", "${H:-hunter2}"), nil, []string{literalHeader}, nil},
+		{"J013 a password from a variable is no match (case A)", annotation("https://user:${PASS}@host"), Map{"PASS": "pw"}, nil, nil},
+		{"J013 the same beside an undefined variable (case B)", annotation("https://user:${PASS}@host ${UNDEF}"), Map{"PASS": "pw"}, nil, []string{CodeUndefined}},
+		{"J013 the same beside a malformed expression", annotation("https://user:${PASS}@host ${1"), Map{"PASS": "pw"}, nil, []string{CodeMalformed}},
+		{"J013 a password written as a default joins its run", annotation("https://user:${P:-pw}@host"), Map{"P": "x"}, []string{url}, nil},
+		{"J013 a credential split by a default joins its run", annotation("AKIA${X:-}ABCDEFGHIJKLMNOP"), Map{"X": "v"}, []string{"AWS access key ID"}, nil},
+		{"J013 a value a detector matches does not warn", annotation("${V}"), Map{"V": "AKIAABCDEFGHIJKLMNOP"}, nil, nil},
+		{"J013 a framing default between variables", header("cookie", "${A}${S:-; }${B}"), Map{"A": "a", "B": "b"}, nil, nil},
+		{"J013 a framing default taken between variables", header("cookie", "${A}${S:-; }${B}"), Map{"A": "a", "B": "b", "S": ""}, nil, nil},
+		{"J013 the same framing written as literal text", header("cookie", "${A}; ${B}"), Map{"A": "a", "B": "b"}, nil, nil},
+		{"J013 a scheme default before a variable", header("authorization", "${P:-Bearer }${T}"), Map{"T": "t"}, nil, nil},
+		{"J013 the same scheme written as literal text", header("authorization", "Bearer ${T}"), Map{"T": "t"}, nil, nil},
+		{"J013 a scheme default after a variable is literal text", header("authorization", "${T}${P:-Bearer }${U}"), Map{"T": "t", "U": "u"}, []string{literalHeader}, nil},
+		{"J013 a default holding a letter is literal text", header("x-api-key", "${A}${S:-k}${B}"), Map{"A": "a", "B": "b"}, []string{literalHeader}, nil},
+		{"J013 a header with every default unset and no other text", header("authorization", "${A:-;}"), nil, []string{literalHeader}, nil},
+		{"J013 origin: the same with the variable empty", header("authorization", "${A:-;}"), Map{"A": ""}, []string{literalHeader}, nil},
+		{"J013 origin: the same with the variable set", header("authorization", "${A:-;}"), Map{"A": "tok"}, nil, nil},
+		{"J013 an empty default supplies no text", header("authorization", "${A}${B:-}"), Map{"A": "tok"}, nil, nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ds := apply(t, tc.src, tc.vars)
+			var warns, errs []string
+			for _, d := range ds {
+				if d.Code == CodeWarning {
+					msg := d.Message
+					if i := strings.Index(msg, " \""); i >= 0 && strings.HasPrefix(msg, literalHeader) {
+						msg = msg[:i]
+					}
+					msg = strings.TrimSuffix(strings.TrimPrefix(msg, "credential-shaped value ("), ")")
+					warns = append(warns, msg)
+					continue
+				}
+				errs = append(errs, d.Code)
+			}
+			if !slices.Equal(warns, tc.want) || !slices.Equal(errs, tc.errs) {
+				t.Errorf("warnings %q and errors %q, want %q and %q: %q", warns, errs, tc.want, tc.errs, texts(ds))
+			}
+		})
+	}
+}
