+		{
+			name: "J013 a mapping key in labels", src: route(`{"name":"r","labels":{"`+aws+`":"x"}}`, `{}`),
+			creds: []string{aws}, want: []string{"metadata.labels"},
+		},
+		{
+			name: "J013 a mapping key in annotations", src: route(`{"name":"r","annotations":{"`+aws+`":"x"}}`, `{}`),
+			creds: []string{aws}, want: []string{"metadata.annotations"},
+		},
+		{
+			name: "J013 a mapping key in free content", src: policy("plugin", `{"tenants":{"`+scheme+`":"a"}}`),
+			creds: []string{scheme}, want: []string{"spec.config.tenants"},
+		},
+		{
+			name: "J013 a string set element", src: policy("cors", `{"allowOrigins":["https://a.example","`+userinfo+`"]}`),
+			creds: []string{userinfo}, want: []string{"spec.config.allowOrigins[1]"},
+		},
+		{
+			name: "J013 a string set element holding an expression", src: policy("cors", `{"allowOrigins":["`+userinfo+`/${P}"]}`), vars: Map{"P": "x"},
+			creds: []string{userinfo}, want: []string{"spec.config.allowOrigins[0]"},
+		},
+		{
+			name:  "J013 a composite set element",
+			src:   policy("auth.mtls", `{"caCertificate":{"secretRef":{"provider":"file","name":"/ca"}},"subjects":[{"subject":"`+aws+`"}]}`),
+			creds: []string{aws}, want: []string{"spec.config.subjects[0].subject"},
+		},
+		{
