+func collect(s string, lenient bool) ([]segment, string) {
+	var segs []segment
+	var lit strings.Builder
+	flush := func() {
+		if lit.Len() > 0 {
+			segs = append(segs, segment{lit: lit.String()})
+			lit.Reset()
+		}
+	}
+	bad := scanEach(s, lenient, nil, func(sg segment) bool {
