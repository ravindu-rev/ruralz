+// TestMessagesClipped: a message quotes at most maxShown bytes of a name
+// from the input (review finding class: quoting a long name was one
+// uncounted pass, and the message as long as the name): the undefined
+// variable, its hint and the secret-like name.
+func TestMessagesClipped(t *testing.T) {
+	long := strings.Repeat("A", 1<<16)
+	for name, tc := range map[string]struct {
