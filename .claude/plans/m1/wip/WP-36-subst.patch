+	}
+	policy := func(typ, config string) string {
+		return `{"apiVersion":"ruralz/v1alpha1","kind":"Policy","metadata":{"name":"p"},"spec":{"type":"` + typ + `","plugin":"g","config":` + config + `}}`
+	}
+	cases := []struct {
+		name, src string
+		vars      Map
+		// creds are the texts no diagnostic may show.
+		creds, want []string
