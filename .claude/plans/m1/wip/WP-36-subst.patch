+
+// FuzzScan is the differential property of the linear scanner (review
+// finding: the lenient re-read searched to the end of the string at each
+// ${): in both modes, for any text, scanEach's pieces joined as scan does
+// equal referenceScan's segments and reason, and eachRun's runs equal the
+// reference runs.
+func FuzzScan(f *testing.F) {
+	for _, s := range scanSeeds() {
+		f.Add(s)
+	}
+	f.Fuzz(func(t *testing.T, s string) {
+		if len(s) > 1<<14 {
+			return
+		}
+		for _, lenient := range []bool{false, true} {
+			got, gotBad := collect(s, lenient)
+			want, wantBad := referenceScan(s, lenient)
+			if gotBad != wantBad || !slices.Equal(got, want) {
+				t.Fatalf("scan(%q, lenient %v) = %v %q, want %v %q", s, lenient, got, gotBad, want, wantBad)
+			}
+		}
+		var got []run
+		eachRun(s, nil, func(r run) bool {
+			got = append(got, r)
+			return true
+		})
+		if want := referenceRuns(s); !slices.Equal(got, want) {
+			t.Fatalf("eachRun(%q) = %v, want %v", s, got, want)
+		}
+	})
+}
