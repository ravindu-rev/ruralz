+	all := mustRun(t, bundle, nil)
+	union := append(mustNew(t, nil, Options{MaxDiagnostics: 1 << 20}).CheckPolicies(bundle, nil), func() diag.List {
+		_, ds, err := mustNew(t, nil, Options{MaxDiagnostics: 1 << 20}).Resolve(t.Context(), bundle, nil, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
