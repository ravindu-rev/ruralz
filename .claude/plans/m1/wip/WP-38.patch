+		t.Fatalf("uncapped Run differs from CheckPolicies and Resolve sorted together")
+	}
+	for _, workers := range []int{1, 4} {
+		r := mustNew(t, nil, Options{MaxDiagnostics: maxDiagnostics})
+		_, ds, err := r.Run(t.Context(), bundle, nil, workers)
