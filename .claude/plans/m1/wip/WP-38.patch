+
+// TestForEachCancelQueued covers the cancellation contract of forEach
+// that Resolve documents (WP-38 S2 round-2 minor on ctx): no unit starts
+// once ctx has ended. Two workers hold units 0 and 1 and units 2 and 3
+// wait in the queue when ctx ends: the queued units never run; the
+// dispatcher, waiting to queue unit 4 of 1000, stops there instead of
+// dispatching the rest (Err is called a bounded number of times, not once
+// per unit); and when every unit was already queued (n 4) forEach still
+// returns ctx.Err(), because a unit did not run.
+func TestForEachCancelQueued(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		n    int
+	}{
+		{"dispatcher waits on a full queue", 1000},
+		{"every unit queued", 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			parent, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			ctx := &errCountingCtx{Context: parent}
+			gate := make(chan struct{})
+			var calls atomic.Int32
+			done := make(chan error, 1)
+			go func() {
+				done <- testPool(2).forEach(ctx, tc.n, func(*worker, int) {
+					calls.Add(1)
+					<-gate
+				})
+			}()
+			for calls.Load() < 2 {
+				runtime.Gosched()
+			}
+			// Both workers are held: let the dispatcher queue what fits.
+			for range 10000 {
+				runtime.Gosched()
+			}
+			cancel()
+			close(gate)
+			if err := <-done; !errors.Is(err, context.Canceled) {
+				t.Errorf("forEach = %v, want context.Canceled", err)
+			}
+			if c := calls.Load(); c != 2 {
+				t.Errorf("%d calls, want 2: a queued unit ran after ctx ended", c)
+			}
+			// About a dozen: the dispatcher's check per queued unit, the
+			// workers' per unit taken, never one per unit of the 1000.
+			if e := ctx.errs.Load(); e > 25 {
+				t.Errorf("%d Err calls: dispatch went on after ctx ended", e)
+			}
+		})
 	}
 }
