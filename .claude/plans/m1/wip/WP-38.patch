+			bb.policy(gw[i], v1alpha1.PolicyTypeAuthzCEL, authzCfg("auth.ok"), slot(gw[i]))
+			rt = append(rt, fmt.Sprintf("r%d", i))
+			bb.policy(rt[i], v1alpha1.PolicyTypeAuthzCEL, authzCfg("request.body.ok"), slot(rt[i]))
+		}
