{
  "annotations": {
    "list": []
  },
  "description": "Error budget remaining over 30 days and burn rate of every M1 SLO; 1 is the rate that spends the budget in exactly 30 days. Generated by telemetrygen from the Ruralz telemetry catalog; Apache-2.0.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ruralz"
      ],
      "title": "Ruralz dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO-GW-1 budget remaining",
      "description": "SLO-GW-1: Node-generated 5xx responses, objective 99.95% over 30 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "exemplar": false,
          "expr": "1 - (sum(rate(ruralz_http_listener_requests_total{status_class=\"5xx\",origin=\"node\"}[30d])) / sum(rate(ruralz_http_listener_requests_total[30d]))) / 0.0005",
          "legendFormat": "remaining",
          "refId": "A"
        }
      ]
    },
