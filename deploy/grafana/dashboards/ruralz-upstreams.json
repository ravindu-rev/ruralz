{
  "annotations": {
    "list": []
  },
  "description": "Attempts, retries, circuit breakers, Endpoints, ejections and connection pools of the selected Upstreams. Generated by telemetrygen from the Ruralz telemetry catalog; Apache-2.0.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ruralz"
      ],
      "title": "Ruralz dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attempts by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "exemplar": false,
          "expr": "sum by (upstream, status_class) (rate(ruralz_upstream_attempts_total{upstream=~\"$upstream\"}[$__rate_interval]))",
          "legendFormat": "{{upstream}} {{status_class}}",
          "refId": "A"
        }
      ]
    },
