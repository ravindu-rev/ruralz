#
# ruralzd.service: Ruralz Gateway (ruralzd) on a VM with systemd, topology
# T5, in file mode (docs/operations/01-deployment-topologies.md, "T5 and
# T6"). Needs systemd 247 or newer (LoadCredential=). Install from the
# linux ruralzd release archive:
#
#   /usr/local/bin/ruralzd                 the binary
#   /usr/local/bin/ruralzd-handover        deploy/systemd/ruralzd-handover
#   /etc/systemd/system/ruralzd.service    this file
#   /etc/sysusers.d/ruralzd.conf           from ruralzd.sysusers: the user ruralz
#   /etc/ruralzd/ruralzd.env               from ruralzd.env; sets RURALZ_CONFIG
#   /etc/ruralzd/admin-token               the admin operator token, mode 0600
#   /etc/sysctl.d/99-ruralzd.conf          net.ipv4.tcp_migrate_req = 1
#
# then run `systemd-sysusers` to create the system user and group ruralz.
#
# `systemctl reload ruralzd` after replacing /usr/local/bin/ruralzd runs a
# Zero-Downtime Upgrade handover (docs/operations/
# 02-zero-downtime-upgrades-and-hot-reload.md, "Handover under systemd"):
# ruralzd-handover starts the new binary in this unit's cgroup, which takes
# the lock and sends MAINPID= and READY=1 while the old process Drains.
# `systemctl stop` sends SIGTERM to every process of the unit, so both
# processes of a handover Drain.

[Unit]
Description=Ruralz Gateway (ruralzd)
Documentation=https://github.com/ravindu-rev/ruralz/blob/main/docs/operations/01-deployment-topologies.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
# The handover successor, a child of ExecReload, sends MAINPID= and READY=1.
NotifyAccess=all
User=ruralz
Group=ruralz
# The data directory, /var/lib/ruralz, owner-only.
StateDirectory=ruralz
StateDirectoryMode=0700
Environment=RURALZ_DATA_DIR=/var/lib/ruralz
EnvironmentFile=/etc/ruralzd/ruralzd.env
# The admin operator token is a systemd credential, outside
# RURALZ_SECRET_ROOT (default /etc/ruralz) both where it is kept and where
# the service reads it ($CREDENTIALS_DIRECTORY).
LoadCredential=admin-token:/etc/ruralzd/admin-token
Environment=RURALZ_ADMIN_TOKEN_FILE=/run/credentials/ruralzd.service/admin-token
ExecStart=/usr/local/bin/ruralzd
ExecReload=/usr/local/bin/ruralzd-handover /usr/local/bin/ruralzd
# Reloads share the start timeout: it exceeds the helper's 75 s wait plus
# its 10 s stop grace.
TimeoutStartSec=90
# The Drain exits within 30 s of SIGTERM (target); stop waits longer.
TimeoutStopSec=40
KillMode=control-group
KillSignal=SIGTERM
# A crash or SIGKILL restarts the Node, which boots Last-Known-Good.
Restart=on-failure

# Hardening. ruralzd writes only under RURALZ_DATA_DIR and binds listener
# ports, below 1024 too.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
