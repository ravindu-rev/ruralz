#
# ruralzd.env: example EnvironmentFile of ruralzd.service, installed as
# /etc/ruralzd/ruralzd.env with mode 0600 (it may hold State Store
# credentials). One NAME=value per line; the RURALZ_* process settings are
# listed in docs/_meta/foundation-pack.md, section 2. ruralzd reads them
# once at start, so a change takes effect at the next handover
# (`systemctl reload ruralzd`) or restart. The unit sets RURALZ_DATA_DIR
# and RURALZ_ADMIN_TOKEN_FILE itself.

# Rendered Bundle directory the Node watches, in file mode. Required.
RURALZ_CONFIG=/etc/ruralzd/bundle

# Process log level: debug, info, warn or error.
RURALZ_LOG_LEVEL=info

# The only directory file secretRef values resolve under. It must not
# contain the data directory, the admin token or TLS directory, or the MAC
# key file.
#RURALZ_SECRET_ROOT=/etc/ruralz

# State Store URL when the Gateway names none; also the secretRef name of
# provider env.
#RURALZ_STATE_STORE_URL=redis://redis.example.internal:6379/0

# Optional State Store entry MAC key: owner-only, 32 bytes or more,
# outside RURALZ_SECRET_ROOT.
#RURALZ_STATE_STORE_MAC_KEY_FILE=/etc/ruralzd/state-store-mac.key

# Addresses and CIDRs that Bundle fetches may reach, comma-separated.
#RURALZ_FETCH_ALLOW=

# Token accepted on /metrics only, and the admin TLS directory (tls.crt,
# tls.key, ca.crt).
#RURALZ_ADMIN_METRICS_TOKEN_FILE=/etc/ruralzd/admin-metrics-token
#RURALZ_ADMIN_TLS_DIR=/etc/ruralzd/admin-tls
