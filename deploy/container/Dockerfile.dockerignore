!dist/linux_amd64/ruralzd
!dist/linux_arm64/ruralzd
!dist/notices/ruralzd_linux_amd64/NOTICE
!dist/notices/ruralzd_linux_amd64/THIRD_PARTY_LICENSES
!dist/notices/ruralzd_linux_arm64/NOTICE
!dist/notices/ruralzd_linux_arm64/THIRD_PARTY_LICENSES
