#compdef ruralz
# zsh completion for ruralz
# Generated by 'ruralz completion zsh'; do not edit.
# Install: ruralz completion zsh > "${fpath[1]}/_ruralz"

_ruralz() {
    local curcontext=$curcontext state state_descr line ret=1
    typeset -A opt_args
    _arguments -C \
        '1: :__ruralz_commands' \
        '*:: :->args' && ret=0
    [[ $state == args ]] || return ret
    case $line[1] in
    (bundle) _ruralz_bundle && ret=0 ;;
    (completion) _ruralz_completion && ret=0 ;;
    (dev) _ruralz_dev && ret=0 ;;
    (help) _ruralz_help && ret=0 ;;
    (node) _ruralz_node && ret=0 ;;
    (version) _ruralz_version && ret=0 ;;
    esac
    return ret
}

__ruralz_commands() {
    local -a commands=(
        'bundle:Validate, render, diff and build Bundles'
        'completion:Print a shell completion script'
        'dev:Run and observe a local ruralzd'
        'help:Print help for a command'
        'node:Operate the local Node'
        'version:Version, commit, flavor, levels'
    )
    _describe -t commands 'ruralz command' commands
}

_ruralz_help() {
    local -a commands=(
        'bundle:Validate, render, diff and build Bundles'
        'completion:Print a shell completion script'
        'dev:Run and observe a local ruralzd'
        'node:Operate the local Node'
        'version:Version, commit, flavor, levels'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'ruralz command' commands
    elif (( CURRENT == 3 )); then
        case $words[2] in
        (bundle) __ruralz_bundle_verbs ;;
        (dev) __ruralz_dev_verbs ;;
        (node) __ruralz_node_verbs ;;
        esac
    fi
}

_ruralz_bundle() {
    local curcontext=$curcontext state state_descr line ret=1
    typeset -A opt_args
    _arguments -C \
        '1: :__ruralz_bundle_verbs' \
        '*:: :->args' && ret=0
    [[ $state == args ]] || return ret
    case $line[1] in
    (build) _ruralz_bundle_build && ret=0 ;;
    (diff) _ruralz_bundle_diff && ret=0 ;;
    (render) _ruralz_bundle_render && ret=0 ;;
    (validate) _ruralz_bundle_validate && ret=0 ;;
    esac
    return ret
}

__ruralz_bundle_verbs() {
    local -a verbs=(
        'build:Build a Revision, print its digest'
        'diff:Compare FROM with TO'
        'render:Render one Environment'\''s one-file Bundle'
        'validate:Offline validation, source-mapped diagnostics'
    )
    _describe -t verbs 'ruralz bundle verb' verbs
}

_ruralz_dev() {
    local curcontext=$curcontext state state_descr line ret=1
    typeset -A opt_args
    _arguments -C \
        '1: :__ruralz_dev_verbs' \
        '*:: :->args' && ret=0
    [[ $state == args ]] || return ret
    case $line[1] in
    (run) _ruralz_dev_run && ret=0 ;;
    (tap) _ruralz_dev_tap && ret=0 ;;
    esac
    return ret
}

__ruralz_dev_verbs() {
    local -a verbs=(
        'run:Local ruralzd with Hot Reload'
        'tap:Stream redacted /tap metadata'
    )
    _describe -t verbs 'ruralz dev verb' verbs
}

_ruralz_node() {
    local curcontext=$curcontext state state_descr line ret=1
    typeset -A opt_args
    _arguments -C \
        '1: :__ruralz_node_verbs' \
        '*:: :->args' && ret=0
    [[ $state == args ]] || return ret
    case $line[1] in
    (drain) _ruralz_node_drain && ret=0 ;;
    (dump) _ruralz_node_dump && ret=0 ;;
    esac
    return ret
}

__ruralz_node_verbs() {
    local -a verbs=(
        'drain:Drain the local ruralzd'
        'dump:Save /config/dump, secrets omitted'
    )
    _describe -t verbs 'ruralz node verb' verbs
}

_ruralz_bundle_build() {
    _arguments -S \
        '--env=[Environment to render with (needs --environments)]:NAME: ' \
        '--environments=[Local Environment resources]:FILE:_files' \
        '--help[Print this help]' \
        '--offline[Skip the online Plugin check]' \
        '--output=[Output format]:text|json:(text json)' \
        '--output-file=[Write the canonical content to PATH]:PATH:_files' \
        '1::DIR:_files -/'
}

_ruralz_bundle_diff() {
    _arguments -S \
        '--admin-token-file=[Operator admin token file]:PATH:_files' \
        '--ca-file=[Extra trust anchors (PEM)]:PATH:_files' \
        '--client-cert=[Client certificate for admin mTLS]:PATH:_files' \
        '--client-key=[Key of --client-cert]:PATH:_files' \
        '--env=[Environment to render with (needs --environments)]:NAME: ' \
        '--environments=[Local Environment resources]:FILE:_files' \
        '--from-env=[Environment of FROM]:NAME: ' \
        '--help[Print this help]' \
        '--output=[Output format]:text|json:(text json)' \
        '--to-env=[Environment of TO]:NAME: ' \
        '1:FROM:_files' \
        '2:TO:_files'
}

_ruralz_bundle_render() {
    local -a v_output=(yaml json)
    if (( ${words[(I)(-|--)(api-version|effective)(|=*)]} )); then
        v_output=(text json)
    fi
    _arguments -S \
        '--api-version=[Convert the sources to VERSION]:VERSION: ' \
        '--effective[Print the resolved Filter Chains of --route]' \
        '--env=[Environment to render with (needs --environments)]:NAME: ' \
        '--environments=[Local Environment resources]:FILE:_files' \
        '--help[Print this help]' \
        '--output=[Output format]:yaml|json|text:{compadd -a v_output}' \
        '--output-dir=[Directory of the converted sources]:DIR:_files -/' \
        '--output-file=[Write the data to PATH instead of stdout]:PATH:_files' \
        '--route=[Route of --effective]:NAME: ' \
        '1::DIR:_files -/'
}

_ruralz_bundle_validate() {
    _arguments -S \
        '--env=[Environment to render with (needs --environments)]:NAME: ' \
        '--environments=[Local Environment resources]:FILE:_files' \
        '--help[Print this help]' \
        '--online[Also check Plugin artifacts]' \
        '--output=[Output format]:text|json:(text json)' \
        '1::DIR:_files -/'
}

_ruralz_completion() {
    _arguments -S \
        '--help[Print this help]' \
        '1:SHELL:(bash zsh fish powershell)'
}

_ruralz_dev_run() {
    _arguments -S \
        '--env=[Environment to render with (needs --environments)]:NAME: ' \
        '--environments=[Local Environment resources]:FILE:_files' \
        '--ephemeral-ports[Replace every port with a free one]' \
        '--help[Print this help]' \
        '--output=[Output format]:text|json:(text json)' \
        '--ready-timeout=[How long to wait for /readyz]:DURATION: ' \
        '--secret-overrides=[Local files replacing secretRefs]:FILE:_files' \
        '1::DIR:_files -/'
}

_ruralz_dev_tap() {
    _arguments -S \
        '--admin=[Admin base URL of the Node]:URL: ' \
        '--admin-token-file=[Operator admin token file]:PATH:_files' \
        '--ca-file=[Extra trust anchors (PEM)]:PATH:_files' \
        '--client-cert=[Client certificate for admin mTLS]:PATH:_files' \
        '--client-key=[Key of --client-cert]:PATH:_files' \
        '--help[Print this help]' \
        '--output=[Output format]:text|json:(text json)' \
        '--route=[Only print exchanges of this Route]:NAME: '
}

_ruralz_node_drain() {
    _arguments -S \
        '--data-dir=[Data directory (default $RURALZ_DATA_DIR, else /var/lib/ruralz)]:PATH:_files -/' \
        '--help[Print this help]' \
        '--timeout=[How long to await the exit]:DURATION: '
}

_ruralz_node_dump() {
    _arguments -S \
        '--admin=[Admin base URL of the Node]:URL: ' \
        '--admin-token-file=[Operator admin token file]:PATH:_files' \
        '--ca-file=[Extra trust anchors (PEM)]:PATH:_files' \
        '--client-cert=[Client certificate for admin mTLS]:PATH:_files' \
        '--client-key=[Key of --client-cert]:PATH:_files' \
        '--help[Print this help]' \
        '--output-file=[Write the document to PATH instead of stdout]:PATH:_files'
}

_ruralz_version() {
    _arguments -S \
        '--help[Print this help]' \
        '--output=[Output format]:text|json:(text json)'
}

if [[ $funcstack[1] == _ruralz ]]; then
    _ruralz "$@"
else
    compdef _ruralz ruralz
fi
