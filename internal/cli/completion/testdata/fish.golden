# fish completion for ruralz
# Generated by 'ruralz completion fish'; do not edit.
# Install: ruralz completion fish > ~/.config/fish/completions/ruralz.fish

complete -c ruralz -f

# Nouns and commands.
complete -c ruralz -n __fish_use_subcommand -a bundle -d 'Validate, render, diff and build Bundles'
complete -c ruralz -n __fish_use_subcommand -a completion -d 'Print a shell completion script'
complete -c ruralz -n __fish_use_subcommand -a dev -d 'Run and observe a local ruralzd'
complete -c ruralz -n __fish_use_subcommand -a help -d 'Print help for a command'
complete -c ruralz -n __fish_use_subcommand -a node -d 'Operate the local Node'
complete -c ruralz -n __fish_use_subcommand -a version -d 'Version, commit, flavor, levels'

# ruralz help <command>
complete -c ruralz -n '__fish_seen_subcommand_from help; and not __fish_seen_subcommand_from bundle completion dev node version' -a bundle -d 'Validate, render, diff and build Bundles'
complete -c ruralz -n '__fish_seen_subcommand_from help; and not __fish_seen_subcommand_from bundle completion dev node version' -a completion -d 'Print a shell completion script'
complete -c ruralz -n '__fish_seen_subcommand_from help; and not __fish_seen_subcommand_from bundle completion dev node version' -a dev -d 'Run and observe a local ruralzd'
complete -c ruralz -n '__fish_seen_subcommand_from help; and not __fish_seen_subcommand_from bundle completion dev node version' -a node -d 'Operate the local Node'
complete -c ruralz -n '__fish_seen_subcommand_from help; and not __fish_seen_subcommand_from bundle completion dev node version' -a version -d 'Version, commit, flavor, levels'

# ruralz bundle <verb>
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and not __fish_seen_subcommand_from build diff render validate' -a build -d 'Build a Revision, print its digest'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and not __fish_seen_subcommand_from build diff render validate' -a diff -d 'Compare FROM with TO'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and not __fish_seen_subcommand_from build diff render validate' -a render -d 'Render one Environment\'s one-file Bundle'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and not __fish_seen_subcommand_from build diff render validate' -a validate -d 'Offline validation, source-mapped diagnostics'

# ruralz dev <verb>
complete -c ruralz -n '__fish_seen_subcommand_from dev; and not __fish_seen_subcommand_from run tap' -a run -d 'Local ruralzd with Hot Reload'
complete -c ruralz -n '__fish_seen_subcommand_from dev; and not __fish_seen_subcommand_from run tap' -a tap -d 'Stream redacted /tap metadata'

# ruralz node <verb>
complete -c ruralz -n '__fish_seen_subcommand_from node; and not __fish_seen_subcommand_from drain dump' -a drain -d 'Drain the local ruralzd'
complete -c ruralz -n '__fish_seen_subcommand_from node; and not __fish_seen_subcommand_from drain dump' -a dump -d 'Save /config/dump, secrets omitted'

# ruralz bundle build
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l env -x -d 'Environment to render with (needs --environments)'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l environments -r -F -d 'Local Environment resources'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l help -d 'Print this help'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l offline -d 'Skip the online Plugin check'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l output -x -a 'text json' -d 'Output format'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -l output-file -r -F -d 'Write the canonical content to PATH'
complete -c ruralz -n '__fish_seen_subcommand_from bundle; and __fish_seen_subcommand_from build' -a '(__fish_complete_directories)'

