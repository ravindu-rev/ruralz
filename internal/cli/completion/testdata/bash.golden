# bash completion for ruralz
# Generated by 'ruralz completion bash'; do not edit.
# Install: source <(ruralz completion bash)
# Needs bash 4.2 or newer.

# __ruralz_reply KIND: completes $cur from the caller as KIND: file, dir, none or
# words:<values>.
__ruralz_reply() {
    case $1 in
    file)
        compopt -o filenames 2>/dev/null
        mapfile -t COMPREPLY < <(compgen -f -- "$cur")
        ;;
    dir)
        compopt -o filenames +o default +o bashdefault 2>/dev/null
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        ;;
    words:*)
        compopt +o default +o bashdefault 2>/dev/null
        mapfile -t COMPREPLY < <(compgen -W "${1#words:}" -- "$cur")
        ;;
    *)
        compopt +o default +o bashdefault 2>/dev/null
        COMPREPLY=()
        ;;
    esac
}

_ruralz() {
    local -A verbs=(
        [bundle]='build diff render validate'
        [dev]='run tap'
        [node]='drain dump'
    )
    local -A flags=(
        ['bundle build']='--env --environments --help --offline --output --output-file'
        ['bundle diff']='--admin-token-file --ca-file --client-cert --client-key --env --environments --from-env --help --output --to-env'
        ['bundle render']='--api-version --effective --env --environments --help --output --output-dir --output-file --route'
        ['bundle validate']='--env --environments --help --online --output'
        ['completion']='--help'
        ['dev run']='--env --environments --ephemeral-ports --help --output --ready-timeout --secret-overrides'
        ['dev tap']='--admin --admin-token-file --ca-file --client-cert --client-key --help --output --route'
        ['node drain']='--data-dir --help --timeout'
        ['node dump']='--admin --admin-token-file --ca-file --client-cert --client-key --help --output-file'
        ['version']='--help --output'
    )
    local -A values=(
        ['bundle build --env']='none'
        ['bundle build --environments']='file'
        ['bundle build --output']='words:text json'
        ['bundle build --output-file']='file'
        ['bundle diff --admin-token-file']='file'
        ['bundle diff --ca-file']='file'
        ['bundle diff --client-cert']='file'
        ['bundle diff --client-key']='file'
        ['bundle diff --env']='none'
        ['bundle diff --environments']='file'
        ['bundle diff --from-env']='none'
        ['bundle diff --output']='words:text json'
        ['bundle diff --to-env']='none'
        ['bundle render --api-version']='none'
        ['bundle render --env']='none'
        ['bundle render --environments']='file'
        ['bundle render --output']='words:yaml json'
        ['bundle render --output 1']='words:text json'
        ['bundle render --output-dir']='dir'
        ['bundle render --output-file']='file'
        ['bundle render --route']='none'
        ['bundle validate --env']='none'
        ['bundle validate --environments']='file'
        ['bundle validate --output']='words:text json'
        ['dev run --env']='none'
        ['dev run --environments']='file'
        ['dev run --output']='words:text json'
        ['dev run --ready-timeout']='none'
        ['dev run --secret-overrides']='file'
        ['dev tap --admin']='none'
        ['dev tap --admin-token-file']='file'
        ['dev tap --ca-file']='file'
        ['dev tap --client-cert']='file'
        ['dev tap --client-key']='file'
        ['dev tap --output']='words:text json'
        ['dev tap --route']='none'
        ['node drain --data-dir']='dir'
        ['node drain --timeout']='none'
        ['node dump --admin']='none'
        ['node dump --admin-token-file']='file'
        ['node dump --ca-file']='file'
        ['node dump --client-cert']='file'
        ['node dump --client-key']='file'
        ['node dump --output-file']='file'
        ['version --output']='words:text json'
    )
    local -A modes=(
        ['bundle render --output 1']=' --api-version --effective '
    )
    local -A args=(
        ['bundle build 0']='dir'
        ['bundle diff 0']='file'
        ['bundle diff 1']='file'
        ['bundle render 0']='dir'
        ['bundle validate 0']='dir'
        ['completion 0']='words:bash zsh fish powershell'
        ['dev run 0']='dir'
    )
    local top='bundle completion dev help node version'
    local helptop='bundle completion dev node version'
    local cur=${COMP_WORDS[COMP_CWORD]} prev= pfx= cmd= w= m= kind= i=0 n=0 start=2 ddash=0 seen=' '
    COMPREPLY=()
    ((COMP_CWORD > 0)) && prev=${COMP_WORDS[COMP_CWORD-1]}
    # "--flag=value" arrives as three words when "=" is in COMP_WORDBREAKS.
    if [[ $cur == = ]]; then
        cur=
    elif [[ $prev == = ]] && ((COMP_CWORD > 1)); then
        prev=${COMP_WORDS[COMP_CWORD-2]}
    elif [[ $cur == -?*=* ]]; then
        prev=${cur%%=*}
        pfx=$prev=
        cur=${cur#*=}
    fi
    if ((COMP_CWORD == 1)); then
        __ruralz_reply "words:$top"
        return 0
    fi
    w=${COMP_WORDS[1]}
    if [[ $w == help ]]; then
        if ((COMP_CWORD == 2)); then
            __ruralz_reply "words:$helptop"
        elif ((COMP_CWORD == 3)) && [[ -n ${COMP_WORDS[2]} && -n ${verbs[${COMP_WORDS[2]}]+set} ]]; then
            __ruralz_reply "words:${verbs[${COMP_WORDS[2]}]}"
        else
            __ruralz_reply none
        fi
        return 0
    fi
    if [[ -n $w && -n ${verbs[$w]+set} ]]; then
        if ((COMP_CWORD == 2)); then
            __ruralz_reply "words:${verbs[$w]}"
            return 0
        fi
        cmd="$w ${COMP_WORDS[2]}"
        start=3
    else
        cmd=$w
    fi
    if [[ -z $cmd || -z ${flags[$cmd]+set} ]]; then
        __ruralz_reply none
        return 0
    fi
    for ((i = start; i < COMP_CWORD; i++)); do
        w=${COMP_WORDS[i]}
        if ((ddash)); then
            n=$((n + 1))
        elif [[ $w == -- ]]; then
            ddash=1
        elif [[ $w == = ]]; then
            i=$((i + 1))
        elif [[ $w == -?* ]]; then
            m=${w#-}
            m=--${m#-}
            m=${m%%=*}
            seen+="$m "
            if [[ $w != *=* && ${COMP_WORDS[i+1]} != = && -n ${values["$cmd $m"]+set} ]]; then
                i=$((i + 1))
            fi
        else
            n=$((n + 1))
        fi
    done
    if ((!ddash)) && [[ $prev == -?* ]]; then
        m=${prev#-}
        m=--${m#-}
        if [[ -n ${values["$cmd $m"]+set} ]]; then
            kind=${values["$cmd $m"]}
            for ((i = 1; ; i++)); do
                [[ -n ${modes["$cmd $m $i"]+set} ]] || break
                for w in ${modes["$cmd $m $i"]}; do
                    if [[ $seen == *" $w "* ]]; then
                        kind=${values["$cmd $m $i"]}
                        break 2
                    fi
                done
            done
            __ruralz_reply "$kind"
            if [[ -n $pfx ]]; then
                COMPREPLY=("${COMPREPLY[@]/#/$pfx}")
            fi
            return 0
        fi
    fi
    if ((!ddash)) && [[ $cur == -* ]]; then
        __ruralz_reply "words:${flags[$cmd]}"
        return 0
    fi
    kind=${args["$cmd $n"]-${args["$cmd *"]-}}
    if [[ -n $kind ]]; then
        __ruralz_reply "$kind"
    elif ((!ddash)); then
        __ruralz_reply "words:${flags[$cmd]}"
    else
        __ruralz_reply none
    fi
    return 0
}

complete -o bashdefault -o default -F _ruralz ruralz
