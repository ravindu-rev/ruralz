# PowerShell completion for ruralz
# Generated by 'ruralz completion powershell'; do not edit.
# Install: ruralz completion powershell | Out-String | Invoke-Expression

Register-ArgumentCompleter -Native -CommandName 'ruralz' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $top = [ordered]@{
        'bundle' = 'Validate, render, diff and build Bundles'
        'completion' = 'Print a shell completion script'
        'dev' = 'Run and observe a local ruralzd'
        'help' = 'Print help for a command'
        'node' = 'Operate the local Node'
        'version' = 'Version, commit, flavor, levels'
    }
    $verbs = @{
        'bundle' = [ordered]@{
            'build' = 'Build a Revision, print its digest'
            'diff' = 'Compare FROM with TO'
            'render' = 'Render one Environment''s one-file Bundle'
            'validate' = 'Offline validation, source-mapped diagnostics'
        }
        'dev' = [ordered]@{
            'run' = 'Local ruralzd with Hot Reload'
            'tap' = 'Stream redacted /tap metadata'
        }
        'node' = [ordered]@{
            'drain' = 'Drain the local ruralzd'
            'dump' = 'Save /config/dump, secrets omitted'
        }
    }
    $flags = @{
        'bundle build' = [ordered]@{
            '--env' = 'Environment to render with (needs --environments)'
            '--environments' = 'Local Environment resources'
            '--help' = 'Print this help'
            '--offline' = 'Skip the online Plugin check'
            '--output' = 'Output format'
            '--output-file' = 'Write the canonical content to PATH'
        }
        'bundle diff' = [ordered]@{
            '--admin-token-file' = 'Operator admin token file'
            '--ca-file' = 'Extra trust anchors (PEM)'
            '--client-cert' = 'Client certificate for admin mTLS'
            '--client-key' = 'Key of --client-cert'
            '--env' = 'Environment to render with (needs --environments)'
            '--environments' = 'Local Environment resources'
            '--from-env' = 'Environment of FROM'
            '--help' = 'Print this help'
            '--output' = 'Output format'
            '--to-env' = 'Environment of TO'
        }
        'bundle render' = [ordered]@{
            '--api-version' = 'Convert the sources to VERSION'
            '--effective' = 'Print the resolved Filter Chains of --route'
            '--env' = 'Environment to render with (needs --environments)'
            '--environments' = 'Local Environment resources'
            '--help' = 'Print this help'
            '--output' = 'Output format'
            '--output-dir' = 'Directory of the converted sources'
            '--output-file' = 'Write the data to PATH instead of stdout'
            '--route' = 'Route of --effective'
        }
        'bundle validate' = [ordered]@{
            '--env' = 'Environment to render with (needs --environments)'
            '--environments' = 'Local Environment resources'
            '--help' = 'Print this help'
            '--online' = 'Also check Plugin artifacts'
            '--output' = 'Output format'
        }
        'completion' = [ordered]@{
            '--help' = 'Print this help'
        }
        'dev run' = [ordered]@{
            '--env' = 'Environment to render with (needs --environments)'
            '--environments' = 'Local Environment resources'
            '--ephemeral-ports' = 'Replace every port with a free one'
            '--help' = 'Print this help'
            '--output' = 'Output format'
            '--ready-timeout' = 'How long to wait for /readyz'
            '--secret-overrides' = 'Local files replacing secretRefs'
        }
        'dev tap' = [ordered]@{
            '--admin' = 'Admin base URL of the Node'
            '--admin-token-file' = 'Operator admin token file'
            '--ca-file' = 'Extra trust anchors (PEM)'
            '--client-cert' = 'Client certificate for admin mTLS'
            '--client-key' = 'Key of --client-cert'
            '--help' = 'Print this help'
            '--output' = 'Output format'
            '--route' = 'Only print exchanges of this Route'
        }
        'node drain' = [ordered]@{
            '--data-dir' = 'Data directory (default $RURALZ_DATA_DIR, else /var/lib/ruralz)'
            '--help' = 'Print this help'
            '--timeout' = 'How long to await the exit'
        }
        'node dump' = [ordered]@{
            '--admin' = 'Admin base URL of the Node'
            '--admin-token-file' = 'Operator admin token file'
            '--ca-file' = 'Extra trust anchors (PEM)'
            '--client-cert' = 'Client certificate for admin mTLS'
            '--client-key' = 'Key of --client-cert'
            '--help' = 'Print this help'
            '--output-file' = 'Write the document to PATH instead of stdout'
        }
        'version' = [ordered]@{
            '--help' = 'Print this help'
            '--output' = 'Output format'
        }
    }
    $values = @{
        'bundle build --env' = 'none'
        'bundle build --environments' = 'file'
        'bundle build --output' = 'words:text json'
        'bundle build --output-file' = 'file'
        'bundle diff --admin-token-file' = 'file'
        'bundle diff --ca-file' = 'file'
        'bundle diff --client-cert' = 'file'
        'bundle diff --client-key' = 'file'
        'bundle diff --env' = 'none'
        'bundle diff --environments' = 'file'
        'bundle diff --from-env' = 'none'
        'bundle diff --output' = 'words:text json'
        'bundle diff --to-env' = 'none'
        'bundle render --api-version' = 'none'
        'bundle render --env' = 'none'
        'bundle render --environments' = 'file'
        'bundle render --output' = 'words:yaml json'
        'bundle render --output 1' = 'words:text json'
        'bundle render --output-dir' = 'dir'
        'bundle render --output-file' = 'file'
        'bundle render --route' = 'none'
        'bundle validate --env' = 'none'
        'bundle validate --environments' = 'file'
        'bundle validate --output' = 'words:text json'
        'dev run --env' = 'none'
        'dev run --environments' = 'file'
        'dev run --output' = 'words:text json'
        'dev run --ready-timeout' = 'none'
        'dev run --secret-overrides' = 'file'
        'dev tap --admin' = 'none'
        'dev tap --admin-token-file' = 'file'
        'dev tap --ca-file' = 'file'
        'dev tap --client-cert' = 'file'
        'dev tap --client-key' = 'file'
        'dev tap --output' = 'words:text json'
        'dev tap --route' = 'none'
        'node drain --data-dir' = 'dir'
        'node drain --timeout' = 'none'
        'node dump --admin' = 'none'
        'node dump --admin-token-file' = 'file'
        'node dump --ca-file' = 'file'
        'node dump --client-cert' = 'file'
        'node dump --client-key' = 'file'
        'node dump --output-file' = 'file'
        'version --output' = 'words:text json'
    }
    $modes = @{
        'bundle render --output 1' = @('--api-version', '--effective')
    }
    $positionals = @{
        'bundle build 0' = 'dir'
        'bundle diff 0' = 'file'
        'bundle diff 1' = 'file'
        'bundle render 0' = 'dir'
        'bundle validate 0' = 'dir'
        'completion 0' = 'words:bash zsh fish powershell'
        'dev run 0' = 'dir'
    }

    $words = [System.Collections.Generic.List[string]]::new()
    foreach ($element in $commandAst.CommandElements) {
        if ($element.Extent.StartOffset -lt $cursorPosition) {
            $words.Add($element.Extent.Text)
        }
    }
    if ($wordToComplete -ne '' -and $words.Count -gt 0) {
        $words.RemoveAt($words.Count - 1)
    }
    $cur = $wordToComplete
    $prefix = ''
    $prev = ''
    if ($words.Count -gt 1) {
        $prev = $words[$words.Count - 1]
    }
    if ($cur -like '-?*=*') {
        $prev = $cur.Substring(0, $cur.IndexOf('='))
        $prefix = $prev + '='
        $cur = $cur.Substring($cur.IndexOf('=') + 1)
    }

    $emitWords = {
        param($table, [string]$type)
        $found = $false
        foreach ($entry in $table.GetEnumerator()) {
            if ($entry.Key.StartsWith($cur, [System.StringComparison]::OrdinalIgnoreCase)) {
                $found = $true
                [System.Management.Automation.CompletionResult]::new($prefix + $entry.Key, $entry.Key, $type, $entry.Value)
            }
        }
        if (-not $found) {
            ''
        }
    }
    $emit = {
        param([string]$kind)
        if ($kind -eq 'file') {
            return
        }
        if ($kind -eq 'dir') {
            $sep = [Math]::Max($cur.LastIndexOf('/'), $cur.LastIndexOf('\'))
            $base = ''
            if ($sep -ge 0) {
                $base = $cur.Substring(0, $sep + 1)
            }
            $found = $false
            foreach ($item in @(Get-ChildItem -Path ($cur + '*') -Directory -Force -ErrorAction SilentlyContinue)) {
                $found = $true
                $text = $base + $item.Name
                if ($text -match '[\s''"]') {
                    $text = "'" + $text.Replace("'", "''") + "'"
                }
                [System.Management.Automation.CompletionResult]::new($prefix + $text, $item.Name, 'ProviderContainer', $item.Name)
            }
            if (-not $found) {
                ''
            }
            return
        }
        if ($kind.StartsWith('words:')) {
            $table = [ordered]@{}
            foreach ($w in $kind.Substring(6).Split(' ')) {
                $table[$w] = $w
            }
            & $emitWords $table 'ParameterValue'
            return
        }
        ''
    }

    if ($words.Count -lt 2) {
        & $emitWords $top 'ParameterValue'
        return
    }
    $w = $words[1]
    if ($w -eq 'help') {
        if ($words.Count -eq 2) {
            $helpTop = [ordered]@{}
            foreach ($entry in $top.GetEnumerator()) {
                if ($entry.Key -ne 'help') {
                    $helpTop[$entry.Key] = $entry.Value
                }
            }
            & $emitWords $helpTop 'ParameterValue'
        } elseif ($words.Count -eq 3 -and $verbs.ContainsKey($words[2])) {
            & $emitWords $verbs[$words[2]] 'ParameterValue'
        } else {
            ''
        }
        return
    }
    $cmd = $w
    $start = 2
    if ($verbs.ContainsKey($w)) {
        if ($words.Count -eq 2) {
            & $emitWords $verbs[$w] 'ParameterValue'
            return
        }
        $cmd = $w + ' ' + $words[2]
        $start = 3
    }
    if (-not $flags.ContainsKey($cmd)) {
        ''
        return
    }

    $n = 0
    $ddash = $false
    $seen = @{}
    for ($i = $start; $i -lt $words.Count; $i++) {
        $t = $words[$i]
        if ($ddash) {
            $n++
            continue
        }
        if ($t -eq '--') {
            $ddash = $true
            continue
        }
        if ($t -like '-?*') {
            $name = '--' + $t.TrimStart('-')
            $eq = $name.IndexOf('=')
            if ($eq -ge 0) {
                $name = $name.Substring(0, $eq)
            }
            $seen[$name] = $true
            if ($eq -lt 0 -and $values.ContainsKey("$cmd $name")) {
                $i++
            }
            continue
        }
        $n++
    }

    if (-not $ddash -and $prev -like '-?*') {
        $name = '--' + $prev.TrimStart('-')
        if ($values.ContainsKey("$cmd $name")) {
            $kind = $values["$cmd $name"]
            for ($m = 1; $modes.ContainsKey("$cmd $name $m"); $m++) {
                $hit = $false
                foreach ($when in $modes["$cmd $name $m"]) {
                    if ($seen.ContainsKey($when)) {
                        $hit = $true
                    }
                }
                if ($hit) {
                    $kind = $values["$cmd $name $m"]
                    break
                }
            }
            & $emit $kind
            return
        }
    }
    if (-not $ddash -and $cur -like '-*') {
        & $emitWords $flags[$cmd] 'ParameterName'
        return
    }
    $kind = $positionals["$cmd $n"]
    if ($null -eq $kind) {
        $kind = $positionals["$cmd *"]
    }
    if ($null -ne $kind) {
        & $emit $kind
    } elseif (-not $ddash) {
        & $emitWords $flags[$cmd] 'ParameterName'
    } else {
        ''
    }
}
