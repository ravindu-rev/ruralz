{
  "apiVersion": "ruralz/v1alpha1",
  "kind": "Policy",
  "metadata": {"name": "orders-token"},
  "spec": {"type": "auth.upstream-oauth2", "config": {"tokenUrl": "https://idp.shop.example/token", "clientId": "gateway",
