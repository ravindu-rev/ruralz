{
  "apiVersion": "ruralz/v1alpha1",
  "kind": "Upstream",
  "metadata": {
    "name": "cart"
  },
  "spec": {
    "protocol": "grpc",
    "endpoints": [
      {
        "address": "cart.shop.svc:9000"
      }
    ],
    "tls": {
      "sni": "cart.shop.svc",
      "caCertificate": {
        "secretRef": {
          "provider": "file",
          "name": "/etc/ruralz/ca/ca.crt"
        }
      }
    },
    "timeout": "2s"
  }
}
