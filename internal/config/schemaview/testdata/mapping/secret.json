{
  "apiVersion": "ruralz/v1alpha1",
  "kind": "Gateway",
  "metadata": {"name": "edge"},
  "spec": {
    "listeners": [
      {
        "name": "https",
        "port": 8443,
        "protocol": "https",
        "tls": {
          "certificates": [
            {
              "name": "shop",
              "certificate": {"secretRef": {"provider": "file", "name": "/etc/ruralz/shop.crt"}},
              "privateKey": "-----BEGIN PRIVATE KEY-----SENTINEL"
            }
          ]
        }
      }
    ],
    "stateStore": {
      "driver": "redis",
      "url": {"value": "rediss://default:SENTINEL@redis.shop.example:6380"}
    }
  }
}
